<Material>
    <Main BlendMode="Mul" DepthTest="true" ForceFullScaleTextures="true" PhysicsMaterial="Water" Type="water" UVSubDivs="1 1" UseAlpha="false" />
    <TextureUnits>
        <Diffuse AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="textures/technical/simple_white.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <NMap AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="textures/technical/blank_nrm.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
    </TextureUnits>
    <SpecificVariables>
        <Var Name="RefractionScale" Value="0" />
        <Var Name="FrenselBias" Value="1" />
        <Var Name="FrenselPow" Value="1" />
        <Var Name="WaveSpeed" Value="1" />
        <Var Name="WaveAmplitude" Value="1" />
        <Var Name="WaveFreq" Value="1" />
        <Var Name="ReflectionFadeStart" Value="0" />
        <Var Name="ReflectionFadeEnd" Value="0" />
        <Var Name="HasReflection" Value="true" />
        <Var Name="OcclusionCullWorldReflection" Value="false" />
        <Var Name="LargeSurface" Value="true" />
        <Var Name="ReflectTerrain" Value="false" />
        <Var Name="HasVertexWaves" Value="false" />
        <Var Name="VertexWaveSpeed" Value="0" />
        <Var Name="VertexWaveAmplitude" Value="0.05" />
        <Var Name="VertexWaveFreq" Value="3" />
        <Var Name="FadeWhenShallowMul" Value="0" />
        <Var Name="FadeWhenShallowPow" Value="0" />
    </SpecificVariables>
</Material>
