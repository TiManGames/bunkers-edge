//-------------------------------------------------

/////////////////////////////////////////
// MAP TRANSFER
/////////////////////////////////////////

//-------------------------------------------------

void Game_DoMapChange(const tString &in asMap, const tString &in asTransferArea)
{
	/////////////////////
	// Setup interact transfer
	int lState = cLux_GetPlayer().GetCurrentStateId();
	cLuxProp@ pProp = null;
	
	if (lState == ePlayerState_Grab)
	{
		cScript_RunGlobalFunc("State_Interact_Grab", "", "_Global_GetPropID");
		@pProp = cLux_ID_Prop(cScript_GetGlobalReturnID());
	}
	else if (lState == ePlayerState_Push)
	{
		cScript_RunGlobalFunc("State_Interact_Push", "", "_Global_GetPropID");
		@pProp = cLux_ID_Prop(cScript_GetGlobalReturnID());
	}
	
	if (pProp !is null)
	{
		cScript_SetGlobalVarString("MapTransfer_InteractProp", pProp.GetName());
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	}
	else
	{
		cScript_SetGlobalVarString("MapTransfer_InteractProp", "");
	}
	
	/////////////////////
	// Load map
	cLux_ChangeMap(asMap, "", asTransferArea, "", "", false, 1.f, false);
	cLux_LoadScreenShowLoadingIcon(10.f);
}

//-------------------------------------------------

void Game_SetupAfterMapChange()
{
	cLux_GetCurrentMap().AddTimer("_Timer_SetupAfterMapChange", 0.01f, "$_OnTimer_SetupAfterMapChange");
}

//-------------------------------------------------

void _OnTimer_SetupAfterMapChange(const tString &in asTimer)
{
	tString sInteractProp = cScript_GetGlobalVarString("MapTransfer_InteractProp");
	if (sInteractProp == "") return;
	
	cLuxProp@ pProp = cLux_ToProp(cLux_GetCurrentMap().GetEntityByName(sInteractProp, eLuxEntityType_Prop));
	iPhysicsBody@ pBody = pProp !is null ? pProp.GetMainBody() : null;
	
	if (pProp !is null && pBody !is null)
	{
		pProp.OnInteract(0, pBody, pProp.GetPosition(), "");
	}
}

