//-------------------------------------------------------

/**
 * Handles the achievement for unlocking the lockers to avoid spreading out the code
 * 
 **/
const int glLockerCount = 11;
void Achievement_IncreaseUnlockedLockerCount()
{
	int lNewCount = cScript_GetGlobalVarInt("UnlockedLockerCount") + 1;
	
	cLux_AddDebugMessage("Unlocked "+lNewCount+"/"+glLockerCount);
	if (lNewCount >= glLockerCount)
		Achievement_Unlock(eAchievement_Codebreaker);
		
	cScript_SetGlobalVarInt("UnlockedLockerCount", lNewCount);
}

//-------------------------------------------------------

/**
 * Handles the achievement for cutting chains and opening vents to avoid spreading out the code
 * 
 **/
const int glCleithrophobistVentCount = 5;
const int glCleithrophobistChainCount = 6;
void Achievement_IncreaseCleithrophobistCount()
{
	int lNewCount = cScript_GetGlobalVarInt("CleithrophobistCount") + 1;
	
	if (lNewCount >= glCleithrophobistVentCount+glCleithrophobistChainCount)
		Achievement_Unlock(eAchievement_Cleithrophobist);
		
	cScript_SetGlobalVarInt("CleithrophobistCount", lNewCount);
}

//-------------------------------------------------

void Achievement_EndGame(bool abEscaped)
{
	Achievement_Unlock(eAchievement_Napoo);
	
	if (abEscaped)
		Achievement_Unlock(eAchievement_Scarper);
		
	if (Game_BeatenDevPlaytime()) 
		Achievement_Unlock(eAchievement_TootSweet);
			
	if (SaveRoom_GetManualSaveCount()==0)
		Achievement_Unlock(eAchievement_GotItInOne);
		
	if (Game_GetNoDropOrStoreAchivementActive())
		Achievement_Unlock(eAchievement_EfficiencyExpert);
			
	if (Game_GetDifficultyMode() == eGameMode_Custom)
		Achievement_Unlock(eAchievement_Revisionist);
			
	if (Game_GetDifficultyMode() == eGameMode_UltraHard)
		Achievement_Unlock(eAchievement_InRecovery);
}

