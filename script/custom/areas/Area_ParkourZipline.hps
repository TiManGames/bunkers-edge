#include "interfaces/Area_Interface.hps"
#include "player/Player_Types.hps"
#include "custom/player/PlayerTypes_Custom.hps"
#include "helpers/helper_player.hps"
#include "custom/helpers/helper_parkour.hps"

//------------------------------------------------------------

const float gfParkourZipline_RopeGfxInitialDelay = 0.10f;
const float gfParkourZipline_RopeGfxRetryDelay = 0.25f;
const float gfParkourZipline_RopePhysicsInitialDelay = 0.10f;
const float gfParkourZipline_RopePhysicsRetryDelay = 0.25f;

//------------------------------------------------------------

class cScrAreaParkourZipline : iScrArea, iScrArea_Interface
{
	//------------------------------------------------------------

	void Init()
	{
		mbPlayerIsInside = false;
		mbNeedsExitAfterGrab = false;
		mbRuntimeRebuildPending = false;
		mbRuntimeDestroyRequested = false;
		mfDebugTimer = 0.f;
		mfGrabCooldown = 0.f;
		mfRuntimeRebuildRetryTimer = 0.f;
		mfRopeGfxRetryTimer = gfParkourZipline_RopeGfxInitialDelay;
		m_idEndArea = tID_Invalid;
		m_idAnchorBody = tID_Invalid;
		m_idTrolleyBody = tID_Invalid;
		m_idSliderJoint = tID_Invalid;
		msRopeName = mBaseObj.GetName() + "_rope";
		mBaseObj.SetAutoSleep(false);
		mBaseObj.SetVariableUpdateRate(0.015f);
	}

	//------------------------------------------------------------

	void SetupAfterLoad(cWorld @apWorld, cResourceVarsObject @apVars)
	{
		mbCanRide = apVars.GetVarBool("CanRide", true);
		msEndArea = apVars.GetVarString("EndArea", "");
		mfGrabRadius = apVars.GetVarFloat("GrabRadius", 0.85f);
		mfMinApproachSpeed = apVars.GetVarFloat("MinApproachSpeed", 0.65f);
		mfMinVerticalSpeed = apVars.GetVarFloat("MinVerticalSpeed", -10.0f);
		mfHangOffset = apVars.GetVarFloat("HangOffset", 1.15f);
		mfStartSpeed = apVars.GetVarFloat("StartSpeed", 2.6f);
		mfMinSpeed = apVars.GetVarFloat("MinSpeed", 1.8f);
		mfMaxSpeed = apVars.GetVarFloat("MaxSpeed", 9.0f);
		mfGravityAccelMul = apVars.GetVarFloat("GravityAccelMul", 1.0f);
		mfLinearDamping = apVars.GetVarFloat("LinearDamping", 0.08f);
		mfDetachExitSpeedMul = apVars.GetVarFloat("DetachExitSpeedMul", 1.0f);
		mfEndExitUpSpeed = apVars.GetVarFloat("EndExitUpSpeed", 0.35f);
		mfCrouchDropDownSpeed = apVars.GetVarFloat("CrouchDropDownSpeed", -0.25f);
		msRopeMaterial = apVars.GetVarString("RopeMaterial", "entities/arabic_fort/rope/ab_interior_tileable_rope_01.mat");
		mfRopeRadius = apVars.GetVarFloat("RopeRadius", 0.05f);
		mfRopeSegmentLength = apVars.GetVarFloat("RopeSegmentLength", 0.5f);
		mfRopeDamping = apVars.GetVarFloat("RopeDamping", 0.05f);
		mfRopeStrength = apVars.GetVarFloat("RopeStrength", 100.f);
		mfRopeStiffness = apVars.GetVarFloat("RopeStiffness", 0.1f);
		mbRopeCollideWorld = apVars.GetVarBool("RopeCollideWorld", false);
		mbRopeCollideCharacter = apVars.GetVarBool("RopeCollideCharacter", false);
	}

	//------------------------------------------------------------

	void OnAfterWorldLoad()
	{
		if (msEndArea == "")
			msEndArea = mBaseObj.GetName() + "_End";

		iLuxEntity@ pEnd = ResolveEndArea();
		if (pEnd is null)
		{
			Error("Cannot find end area '" + msEndArea + "' for zipline area '" + mBaseObj.GetName() + "'");
			return;
		}

		UpdateLineData();
		QueueZiplineRuntimeRebuild();

		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Zipline area '" + mBaseObj.GetName() + "' loaded. EndArea='" + msEndArea + "'.", true);
	}

	//------------------------------------------------------------

	void OnUpdate(float afTimeStep) {}
	void OnPostUpdate(float afTimeStep) {}
	void ResetProperties() {}

	//------------------------------------------------------------

	void BeforeEntityDestruction()
	{
		mbRuntimeRebuildPending = false;
		DestroyZiplinePhysics();
		DestroyZiplineRope();
	}

	//------------------------------------------------------------

	void OnVariableUpdate(float afTimeStep)
	{
		if (mfDebugTimer > 0.f)
			mfDebugTimer -= afTimeStep;
		if (mfGrabCooldown > 0.f)
			mfGrabCooldown -= afTimeStep;

		UpdateZiplineRuntime(afTimeStep);

		if (mbCanRide == false) return;
		if (m_idEndArea == tID_Invalid) return;
		if (m_idTrolleyBody == tID_Invalid || m_idSliderJoint == tID_Invalid) return;
		if (Parkour_GetEnabled() == false) return;
		if (cLux_GetPlayer().IsActive() == false) return;
		if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Normal) return;
		int lMoveState = cLux_GetPlayer().GetCurrentMoveStateId();
		if (lMoveState != eMoveState_Normal && lMoveState != eMoveState_ParkourWallRun) return;
		if (Player_GetUnderwater()) return;

		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null) return;

		bool bCollide = mBaseObj.CheckCharacterCollision(pBody, mBaseObj.GetMap());
		if (bCollide && mbPlayerIsInside == false && Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Entered zipline area '" + mBaseObj.GetName() + "'.", true);
		else if (bCollide == false && mbPlayerIsInside && Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Left zipline area '" + mBaseObj.GetName() + "'.", true);

		mbPlayerIsInside = bCollide;
		if (bCollide == false)
		{
			mbNeedsExitAfterGrab = false;
			return;
		}
		if (mbNeedsExitAfterGrab) return;
		if (mfGrabCooldown > 0.f) return;

		if (pBody.IsOnGround())
		{
			DebugSkip("player is grounded");
			return;
		}

		UpdateLineData();
		if (mfLineLength <= 0.25f)
		{
			DebugSkip("zipline is too short");
			return;
		}

		cVector3f vFlatVel = Parkour_GetFlatVelocity(pBody, afTimeStep);
		if (vFlatVel.Length() < mfMinApproachSpeed)
		{
			DebugSkip("approach speed too low. speed=" + vFlatVel.Length() + " min=" + mfMinApproachSpeed);
			return;
		}

		if (pBody.GetForceVelocity().y < mfMinVerticalSpeed)
		{
			DebugSkip("vertical speed too low. velocity=" + pBody.GetForceVelocity().y + " min=" + mfMinVerticalSpeed);
			return;
		}

		cVector3f vClosest;
		cVector3f vGrabPos = pBody.GetFeetPosition() + cVector3f_Up * mfHangOffset;
		float fProgress = GetClosestLineProgress(vGrabPos, vClosest);
		float fGrabDistance = cMath_Vector3Dist(vGrabPos, vClosest);
		if (fGrabDistance > mfGrabRadius)
		{
			DebugSkip("outside grab radius. distance=" + fGrabDistance + " radius=" + mfGrabRadius);
			return;
		}

		if (ResetTrolleyAtProgress(fProgress) == false)
		{
			DebugSkip("could not reset trolley");
			return;
		}

		Parkour_RegisterZiplineCandidate(mvHighPoint,
										 mvLowPoint,
										 m_idTrolleyBody,
										 m_idSliderJoint,
										 fProgress,
										 mfGrabRadius,
										 mfMinApproachSpeed,
										 mfMinVerticalSpeed,
										 mfHangOffset,
										 mfStartSpeed,
										 mfMinSpeed,
										 mfMaxSpeed,
										 mfGravityAccelMul,
										 mfLinearDamping,
										 mfDetachExitSpeedMul,
										 mfEndExitUpSpeed,
										 mfCrouchDropDownSpeed,
										 msRopeName);

		if (Parkour_TryStartZiplineCandidate(lMoveState == eMoveState_Normal))
		{
			mbPlayerIsInside = false;
			mbNeedsExitAfterGrab = true;
			mfGrabCooldown = 0.55f;
		}
	}

	//------------------------------------------------------------

	void UpdateLineData()
	{
		cVector3f vStart = mBaseObj.GetPosition();
		cVector3f vEnd = GetEndPoint();

		if (vStart.y >= vEnd.y)
		{
			mvHighPoint = vStart;
			mvLowPoint = vEnd;
		}
		else
		{
			mvHighPoint = vEnd;
			mvLowPoint = vStart;
		}

		mvRideDir = mvLowPoint - mvHighPoint;
		mfLineLength = mvRideDir.Length();
		if (mfLineLength > 0.001f)
			mvRideDir.Normalize();
		else
			mvRideDir = cVector3f_Forward;
	}

	//------------------------------------------------------------

	cVector3f GetEndPoint()
	{
		iLuxEntity@ pEnd = ResolveEndArea();
		if (pEnd is null)
			return mBaseObj.GetPosition();

		return pEnd.GetPosition();
	}

	//------------------------------------------------------------

	iLuxEntity@ ResolveEndArea()
	{
		iLuxEntity@ pEnd = null;
		if (m_idEndArea != tID_Invalid)
			@pEnd = cLux_ID_Entity(m_idEndArea);

		if (pEnd is null || pEnd.GetName() != msEndArea)
		{
			@pEnd = mBaseObj.GetMap().GetEntityByName(msEndArea, eLuxEntityType_Area);
			m_idEndArea = pEnd is null ? tID_Invalid : pEnd.GetID();
		}

		return pEnd;
	}

	//------------------------------------------------------------

	void QueueZiplineRuntimeRebuild()
	{
		// OnAfterWorldLoad can run while the saved physics world is still being
		// assembled. Only queue work here; normal updates perform all destruction
		// and creation after the load callback has returned.
		mbRuntimeRebuildPending = true;
		mbRuntimeDestroyRequested = false;
		mfRuntimeRebuildRetryTimer = gfParkourZipline_RopePhysicsInitialDelay;
		mfRopeGfxRetryTimer = gfParkourZipline_RopeGfxInitialDelay;
		m_idAnchorBody = tID_Invalid;
		m_idTrolleyBody = tID_Invalid;
		m_idSliderJoint = tID_Invalid;
	}

	//------------------------------------------------------------

	bool ZiplineRuntimeObjectsAreGone()
	{
		iPhysicsWorld@ pPhysicsWorld = mBaseObj.GetMap().GetPhysicsWorld();
		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		tString sBaseName = mBaseObj.GetName();

		return pPhysicsWorld.GetRope(msRopeName) is null &&
			pWorld.GetRopeEntity(msRopeName + "Gfx") is null &&
			pPhysicsWorld.GetJoint(sBaseName + "_ZiplineTrolley_Joint") is null &&
			pPhysicsWorld.GetBody(sBaseName + "_ZiplineAnchor_Body") is null &&
			pPhysicsWorld.GetBody(sBaseName + "_ZiplineTrolley_Body") is null;
	}

	//------------------------------------------------------------

	bool ZiplineRuntimePhysicsIsValid()
	{
		if (m_idAnchorBody == tID_Invalid ||
			m_idTrolleyBody == tID_Invalid ||
			m_idSliderJoint == tID_Invalid)
			return false;

		iPhysicsWorld@ pWorld = mBaseObj.GetMap().GetPhysicsWorld();
		tString sBaseName = mBaseObj.GetName();
		return pWorld.GetBody(sBaseName + "_ZiplineAnchor_Body") !is null &&
			pWorld.GetBody(sBaseName + "_ZiplineTrolley_Body") !is null &&
			pWorld.GetJoint(sBaseName + "_ZiplineTrolley_Joint") !is null;
	}

	//------------------------------------------------------------

	void UpdateZiplineRuntime(float afTimeStep)
	{
		// Saving can read the physics world on another thread. Defer all rope
		// creation/destruction until that worker has finished.
		if (cLux_GetSaveHandler().GetSaveThreadActive()) return;

		if (mbRuntimeRebuildPending)
		{
			if (mfRuntimeRebuildRetryTimer > 0.f)
			{
				mfRuntimeRebuildRetryTimer -= afTimeStep;
				return;
			}

			if (mbRuntimeDestroyRequested == false)
			{
				DestroyZiplinePhysics();
				DestroyZiplineRope();
				mbRuntimeDestroyRequested = true;
				mfRuntimeRebuildRetryTimer = gfParkourZipline_RopePhysicsRetryDelay;
				return;
			}

			// HPL may defer destruction until the physics update completes. Do not
			// reuse anything restored by the save and do not recreate duplicate names.
			if (ZiplineRuntimeObjectsAreGone() == false)
			{
				mfRuntimeRebuildRetryTimer = gfParkourZipline_RopePhysicsRetryDelay;
				return;
			}

			if (CreateZiplinePhysics() == false || CreateZiplineRope() == false)
			{
				DestroyZiplinePhysics();
				DestroyZiplineRope();
				mfRuntimeRebuildRetryTimer = gfParkourZipline_RopePhysicsRetryDelay;
				return;
			}

			mbRuntimeRebuildPending = false;
			mbRuntimeDestroyRequested = false;
			if (Parkour_GetDebug())
				cLux_AddDebugMessage("[Parkour] Zipline runtime rebuilt for '" + mBaseObj.GetName() + "'.", true);
			return;
		}

		iPhysicsRope@ pRope = GetZiplineRope();
		if (ZiplineRuntimePhysicsIsValid() == false ||
			ZiplineRopePhysicsIsValid(pRope) == false)
		{
			QueueZiplineRuntimeRebuild();
			return;
		}

		EnsureZiplineRopeGfx(afTimeStep);
	}

	//------------------------------------------------------------

	bool CreateZiplineRope()
	{
		iLuxEntity@ pEnd = ResolveEndArea();
		iPhysicsBody@ pStartBody = mBaseObj.GetMainBody();
		iPhysicsBody@ pEndBody = pEnd is null ? null : pEnd.GetMainBody();
		if (pStartBody is null || pEndBody is null)
			return false;

		UpdateLineData();
		if (mfLineLength <= 0.25f) return false;

		iPhysicsWorld@ pPhysicsWorld = mBaseObj.GetMap().GetPhysicsWorld();
		// Never reuse a rope restored from a save, and never ask the engine to
		// replace a rope whose deferred destruction has not completed.
		if (pPhysicsWorld.GetRope(msRopeName) !is null) return false;

		iPhysicsRope@ pRope = pPhysicsWorld.CreateRope(msRopeName,
			mBaseObj.GetPosition(), pEnd.GetPosition());
		if (pRope is null) return false;

		pRope.SetSegmentLength(cMath_Max(0.05f, mfRopeSegmentLength));
		pRope.SetDamping(cMath_Max(0.f, mfRopeDamping));
		pRope.SetStrength(cMath_Max(1.f, mfRopeStrength));
		pRope.SetStiffness(cMath_Max(0.f, mfRopeStiffness));
		pRope.SetTotalLength(mfLineLength);
		pRope.SetAttachedStartBody(pStartBody);
		pRope.SetAttachedEndBody(pEndBody);
		pRope.SetCollide(mbRopeCollideWorld);
		pRope.SetCollideAttachments(false);
		pRope.SetCollideCharacter(mbRopeCollideCharacter);
		pRope.SetCollideRagDoll(false);
		pRope.SetCollideFlags(uint(-1));

		pRope.SetActive(true);
		pRope.SetPhysicsActive(true);

		// Create the graphics rope after a small delay, once the physics rope has
		// initialized its particles.
		mfRopeGfxRetryTimer = gfParkourZipline_RopeGfxInitialDelay;
		return true;
	}

	//------------------------------------------------------------

	void EnsureZiplineRopeGfx(float afTimeStep)
	{
		iPhysicsRope@ pRope = GetZiplineRope();
		if (ZiplineRopePhysicsIsValid(pRope) == false)
		{
			QueueZiplineRuntimeRebuild();
			return;
		}

		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		iRopeEntity@ pRopeGfx = pWorld.GetRopeEntity(msRopeName + "Gfx");
		if (pRopeGfx !is null &&
			pRopeGfx.GetMaterial() !is null &&
			pRopeGfx.GetPhysicsRope() is pRope &&
			pRopeGfx.GetScriptableIsSaved() == false)
		{
			pRopeGfx.SetActive(true);
			pRopeGfx.SetVisible(true);
			return;
		}

		if (mfRopeGfxRetryTimer > 0.f)
		{
			mfRopeGfxRetryTimer -= afTimeStep;
			return;
		}

		mfRopeGfxRetryTimer = gfParkourZipline_RopeGfxRetryDelay;

		// A saved/stale graphics entity can point at an old physics rope, and a
		// failed material load can leave an unusable entity behind. Recreate it
		// unless the material, physics link and derived-only save flag all match.
		if (pRopeGfx !is null)
			pWorld.DestroyRopeEntity(pRopeGfx);

		CreateZiplineRopeGfx(pRope);

		@pRopeGfx = pWorld.GetRopeEntity(msRopeName + "Gfx");
		if (pRopeGfx !is null && pRopeGfx.GetMaterial() !is null && Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Zipline rope graphics ready for '" + mBaseObj.GetName() + "'.", true);
	}

	//------------------------------------------------------------

	bool ZiplineRopePhysicsIsValid(iPhysicsRope@ apRope)
	{
		if (apRope is null) return false;

		iLuxEntity@ pEnd = ResolveEndArea();
		iPhysicsBody@ pStartBody = mBaseObj.GetMainBody();
		iPhysicsBody@ pEndBody = pEnd is null ? null : pEnd.GetMainBody();
		if (pStartBody is null || pEndBody is null) return false;

		return apRope.GetAttachedStartBody() is pStartBody &&
			   apRope.GetAttachedEndBody() is pEndBody;
	}

	//------------------------------------------------------------

	bool CreateZiplineRopeGfx(iPhysicsRope@ apRope)
	{
		if (apRope is null) return false;

		int lParticleNum = apRope.GetParticleNum();
		if (lParticleNum < 2) return false;

		cMaterial@ pMaterial = cResources_CreateMaterial(msRopeMaterial);
		if (pMaterial is null) return false;

		// The stock helper reserves only 32 mesh segments. Every BunkersEdge
		// zipline currently exceeds that at its configured 0.5 m rope segment
		// length, so reserve enough geometry for this rope's actual particles.
		int lMaxSegments = lParticleNum + 1;
		if (lMaxSegments < 32) lMaxSegments = 32;

		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		iRopeEntity@ pRopeGfx = pWorld.CreateRopeEntity(msRopeName + "Gfx", eRopeType_3D, apRope, lMaxSegments, 6);
		if (pRopeGfx is null) return false;

		pRopeGfx.SetMaterial(pMaterial);
		pRopeGfx.SetRadius(cMath_Max(0.005f, mfRopeRadius));
		pRopeGfx.SetActive(true);
		pRopeGfx.SetVisible(true);
		pRopeGfx.SetScriptableIsSaved(false);
		pRopeGfx.SetRenderFlagBit(eRenderableFlag_ShadowCaster, true);
		return true;
	}

	//------------------------------------------------------------

	void DestroyZiplineRope()
	{
		cWorld@ pWorld = mBaseObj.GetMap().GetWorld();
		iPhysicsWorld@ pPhysicsWorld = mBaseObj.GetMap().GetPhysicsWorld();

		iRopeEntity@ pRopeGfx = pWorld.GetRopeEntity(msRopeName + "Gfx");
		if (pRopeGfx !is null)
			pWorld.DestroyRopeEntity(pRopeGfx);

		iPhysicsRope@ pRope = pPhysicsWorld.GetRope(msRopeName);
		if (pRope !is null)
			pPhysicsWorld.DestroyRope(pRope);
	}

	//------------------------------------------------------------

	bool CreateZiplinePhysics()
	{
		if (mfLineLength <= 0.25f) return false;

		iPhysicsWorld@ pWorld = mBaseObj.GetMap().GetPhysicsWorld();
		tString sBaseName = mBaseObj.GetName();
		if (pWorld.GetJoint(sBaseName + "_ZiplineTrolley_Joint") !is null ||
			pWorld.GetBody(sBaseName + "_ZiplineAnchor_Body") !is null ||
			pWorld.GetBody(sBaseName + "_ZiplineTrolley_Body") !is null)
			return false;

		@mpAnchorShape = pWorld.CreateSphereShape(0.05f, cMatrixf_Identity);
		@mpTrolleyShape = pWorld.CreateSphereShape(0.10f, cMatrixf_Identity);
		if (mpAnchorShape is null || mpTrolleyShape is null) return false;

		iPhysicsBody@ pAnchor = pWorld.CreateBody(sBaseName + "_ZiplineAnchor_Body", mpAnchorShape, 0.f);
		iPhysicsBody@ pTrolley = pWorld.CreateBody(sBaseName + "_ZiplineTrolley_Body", mpTrolleyShape, 1.f);
		if (pAnchor is null || pTrolley is null) return false;

		pAnchor.SetPosition(mvHighPoint);
		pAnchor.SetCollide(false);
		pAnchor.SetCollideCharacter(false);
		pAnchor.SetAutoDisable(false);
		pAnchor.SetGravity(false);

		pTrolley.SetPosition(mvHighPoint);
		pTrolley.SetCollide(false);
		pTrolley.SetCollideCharacter(false);
		pTrolley.SetAutoDisable(false);
		pTrolley.SetGravity(false);
		pTrolley.SetLinearDamping(cMath_Max(0.f, mfLinearDamping));
		pTrolley.SetAngularDamping(2.f);
		pTrolley.SetMaxLinearSpeed(cMath_Max(1.f, mfMaxSpeed * 1.5f));
		pTrolley.SetActive(true);

		iPhysicsJointSlider@ pJoint = pWorld.CreateJointSlider(sBaseName + "_ZiplineTrolley_Joint",
															   mvHighPoint,
															   mvRideDir,
															   pAnchor,
															   pTrolley);
		if (pJoint is null) return false;

		pJoint.SetMinDistance(0.f);
		pJoint.SetMaxDistance(mfLineLength);
		pJoint.SetLimitAutoSleep(false);
		pJoint.SetStickyMinLimit(false);
		pJoint.SetStickyMaxLimit(false);
		pJoint.SetCollideBodies(false);

		m_idAnchorBody = pAnchor.GetID();
		m_idTrolleyBody = pTrolley.GetID();
		m_idSliderJoint = pJoint.GetID();
		return true;
	}

	//------------------------------------------------------------

	void DestroyZiplinePhysics()
	{
		iPhysicsWorld@ pWorld = mBaseObj.GetMap().GetPhysicsWorld();
		tString sBaseName = mBaseObj.GetName();

		// Saved IDs can refer to objects from the load pass. Resolve the runtime
		// objects by their stable names instead of dereferencing restored IDs.
		iPhysicsJoint@ pJoint = pWorld.GetJoint(sBaseName + "_ZiplineTrolley_Joint");
		if (pJoint !is null)
			pWorld.DestroyJoint(pJoint);
		m_idSliderJoint = tID_Invalid;

		iPhysicsBody@ pTrolley = pWorld.GetBody(sBaseName + "_ZiplineTrolley_Body");
		if (pTrolley !is null)
			pWorld.DestroyBody(pTrolley);
		m_idTrolleyBody = tID_Invalid;

		iPhysicsBody@ pAnchor = pWorld.GetBody(sBaseName + "_ZiplineAnchor_Body");
		if (pAnchor !is null)
			pWorld.DestroyBody(pAnchor);
		m_idAnchorBody = tID_Invalid;

		if (mpTrolleyShape !is null)
		{
			pWorld.DestroyShape(mpTrolleyShape);
			@mpTrolleyShape = null;
		}
		if (mpAnchorShape !is null)
		{
			pWorld.DestroyShape(mpAnchorShape);
			@mpAnchorShape = null;
		}
	}

	//------------------------------------------------------------

	iPhysicsBody@ GetTrolleyBody()
	{
		if (m_idTrolleyBody == tID_Invalid) return null;
		return cLux_ID_Body(m_idTrolleyBody);
	}

	//------------------------------------------------------------

	bool ResetTrolleyAtProgress(float afProgress)
	{
		iPhysicsBody@ pTrolley = GetTrolleyBody();
		if (pTrolley is null) return false;

		float fProgress = cMath_Clamp(afProgress, 0.f, 1.f);
		cVector3f vPos = mvHighPoint + mvRideDir * (mfLineLength * fProgress);
		pTrolley.SetPosition(vPos);
		pTrolley.SetLinearVelocity(cVector3f_Zero);
		pTrolley.SetAngularVelocity(cVector3f_Zero);
		pTrolley.Enable();
		return true;
	}

	//------------------------------------------------------------

	float GetClosestLineProgress(const cVector3f &in avPoint, cVector3f &out avClosest)
	{
		float fRopeProgress;
		if (TryGetClosestRopeProgress(avPoint, avClosest, fRopeProgress))
			return fRopeProgress;

		cVector3f vLine = mvLowPoint - mvHighPoint;
		float fLineLenSqr = vLine.SqrLength();
		if (fLineLenSqr <= 0.001f)
		{
			avClosest = mvHighPoint;
			return 0.f;
		}

		float fProgress = cMath_Vector3Dot(avPoint - mvHighPoint, vLine) / fLineLenSqr;
		fProgress = cMath_Clamp(fProgress, 0.f, 1.f);
		avClosest = mvHighPoint + vLine * fProgress;
		return fProgress;
	}

	//------------------------------------------------------------

	bool TryGetClosestRopeProgress(const cVector3f &in avPoint, cVector3f &out avClosest, float &out afProgress)
	{
		iPhysicsRope@ pRope = GetZiplineRope();
		if (pRope is null) return false;

		int lNum = pRope.GetParticleNum();
		if (lNum < 2) return false;

		bool bForward = RopeParticlesRunHighToLow(pRope);
		float fTotalLength = GetRopeArcLength(pRope, bForward);
		if (fTotalLength <= 0.001f) return false;

		float fBestDistSqr = 999999999.f;
		float fBestProgress = 0.f;
		float fTravelled = 0.f;
		int lStep = bForward ? 1 : -1;
		int lIndex = bForward ? 0 : lNum - 1;
		cVector3f vPrev = pRope.GetParticle(lIndex).GetPosition();
		avClosest = vPrev;

		for (int i = 1; i < lNum; ++i)
		{
			int lNext = lIndex + lStep;
			cVector3f vNext = pRope.GetParticle(lNext).GetPosition();
			cVector3f vSegment = vNext - vPrev;
			float fSegLen = vSegment.Length();
			if (fSegLen > 0.001f)
			{
				float fSegT = cMath_Clamp(cMath_Vector3Dot(avPoint - vPrev, vSegment) / (fSegLen * fSegLen), 0.f, 1.f);
				cVector3f vCandidate = vPrev + vSegment * fSegT;
				float fDistSqr = cMath_Vector3DistSqr(avPoint, vCandidate);
				if (fDistSqr < fBestDistSqr)
				{
					fBestDistSqr = fDistSqr;
					avClosest = vCandidate;
					fBestProgress = (fTravelled + fSegLen * fSegT) / fTotalLength;
				}

				fTravelled += fSegLen;
			}

			vPrev = vNext;
			lIndex = lNext;
		}

		afProgress = cMath_Clamp(fBestProgress, 0.f, 1.f);
		return true;
	}

	//------------------------------------------------------------

	float GetRopeArcLength(iPhysicsRope@ apRope, bool abForward)
	{
		if (apRope is null) return mfLineLength;

		int lNum = apRope.GetParticleNum();
		if (lNum < 2) return mfLineLength;

		float fLength = 0.f;
		int lStep = abForward ? 1 : -1;
		int lIndex = abForward ? 0 : lNum - 1;
		cVector3f vPrev = apRope.GetParticle(lIndex).GetPosition();

		for (int i = 1; i < lNum; ++i)
		{
			int lNext = lIndex + lStep;
			cVector3f vNext = apRope.GetParticle(lNext).GetPosition();
			fLength += cMath_Vector3Dist(vPrev, vNext);
			vPrev = vNext;
			lIndex = lNext;
		}

		return fLength;
	}

	//------------------------------------------------------------

	bool RopeParticlesRunHighToLow(iPhysicsRope@ apRope)
	{
		if (apRope is null) return true;
		int lNum = apRope.GetParticleNum();
		if (lNum < 2) return true;

		cVector3f vFirst = apRope.GetParticle(0).GetPosition();
		cVector3f vLast = apRope.GetParticle(lNum - 1).GetPosition();
		return cMath_Vector3DistSqr(vFirst, mvHighPoint) <= cMath_Vector3DistSqr(vLast, mvHighPoint);
	}

	//------------------------------------------------------------

	iPhysicsRope@ GetZiplineRope()
	{
		if (msRopeName == "") return null;
		return mBaseObj.GetMap().GetPhysicsWorld().GetRope(msRopeName);
	}

	//------------------------------------------------------------

	void DebugSkip(const tString &in asReason)
	{
		if (Parkour_GetDebug() == false) return;
		if (mfDebugTimer > 0.f) return;

		cLux_AddDebugMessage("[Parkour] Zipline ignored: " + asReason, true);
		mfDebugTimer = 0.35f;
	}

