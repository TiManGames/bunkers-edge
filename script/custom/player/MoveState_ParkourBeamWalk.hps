#include "interfaces/MoveState_Interface.hps"
#include "base/InputHandler_Types.hps"
#include "player/Player_Types.hps"
#include "custom/player/PlayerTypes_Custom.hps"

#include "helpers/helper_player.hps"
#include "helpers/helper_items.hps"
#include "helpers/helper_modules.hps"
#include "custom/helpers/helper_parkour.hps"

//------------------------------------------------------------

const float gfParkourBeamWalk_SnapTime = 0.12f;
const float gfParkourBeamWalk_VisualSideOffset = 0.26f;
const float gfParkourBeamWalk_CameraSideOffset = 0.045f;
const float gfParkourBeamWalk_CameraDownOffset = -0.030f;
const float gfParkourBeamWalk_CameraForwardOffset = 0.030f;
const float gfParkourBeamWalk_CameraPitchDeg = 0.0f;
const float gfParkourBeamWalk_CameraBobFrequency = 8.0f;
const float gfParkourBeamWalk_CameraBobVertical = 0.030f;
const float gfParkourBeamWalk_CameraBobSide = 0.018f;
const float gfParkourBeamWalk_CameraBobForward = 0.020f;
const float gfParkourBeamWalk_CameraBobRoll = 0.85f;
const float gfParkourBeamWalk_DriftNoiseSpeed = 0.72f;
const float gfParkourBeamWalk_DriftNoiseMul = 0.72f;
const float gfParkourBeamWalk_MinDriftBias = 0.24f;
const float gfParkourBeamWalk_MaxBalanceVelocity = 2.10f;

//------------------------------------------------------------

class cScrMoveState_ParkourBeamWalk : iScrMoveState, iScrMoveState_Interface
{
	//------------------------------------------------------------

	void Init() {}
	void OnMapEnter(cLuxMap @apMap) {}
	void Reset() {}

	//------------------------------------------------------------

	void OnEnterState(int alPrevStateId)
	{
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
			return;
		}

		ReadSetupGlobals();
		if (NormalizeSetup() == false)
		{
			cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
			return;
		}

		mbFinished = false;
		mfTimer = 0.f;
		mfFallLimitTimer = 0.f;
		mfBalance = 0.f;
		mfBalanceVelocity = cMath_RandRectf(-0.08f, 0.08f);
		mfDriftSeed = cMath_RandRectf(-100.f, 100.f);
		mfDriftBias = cMath_RandRectf(-0.42f, 0.42f);
		if (cMath_Abs(mfDriftBias) < gfParkourBeamWalk_MinDriftBias)
			mfDriftBias = mfDriftBias < 0.f ? -gfParkourBeamWalk_MinDriftBias : gfParkourBeamWalk_MinDriftBias;
		mvStartFeetPos = pBody.GetFeetPosition();
		mfStartPitch = cLux_GetPlayer().GetCamera().GetPitch();
		mfCameraBobTimer = 0.f;
		mfCameraBobRoll = 0.f;
		mvCameraBobOffset = cVector3f_Zero;

		Player_SetDisableCrawling(true);
		Player_SetCrouching(false, false, true);
		Player_SetCrouchDisabled(true);
		Player_SetCrouchActionDisabled(true);
		Player_SetLeanDisabled(true);
		Player_CancelJump();
		cScript_SetGlobalVarBool("PlayerPhysicalActionAllowed", false);

		Item_PutAway(eItemHandlerHand_Left);
		Item_PutAway(eItemHandlerHand_Right);

		pBody.SetGravityActive(false);
		pBody.SetTestCollision(false);
		pBody.SetPhysicsBodyActive(false);
		pBody.StopMovement();
		pBody.SetForceVelocity(cVector3f_Zero);
		LockBodyToBeam(pBody, GetFeetAtProgress(mfProgress, 0.f), false, 0.f);

		cLux_GetPlayer().SetCameraPosAdd(eCameraAddType_Script, cVector3f_Zero);
		cLux_GetPlayer().SetCameraRoll(ePlayerRoll_Script, 0.f);
		cLux_PlayGuiSoundData("player/climb_ledge/low", eSoundEntryType_WorldClean, 0.35f, true);

		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Beam walk move state entered. progress=" + mfProgress + " length=" + mfBeamLength, true);
	}

	//------------------------------------------------------------

	void OnLeaveState(int alNextStateId)
	{
		RestoreBody();
		Player_SetDisableCrawling(false);
		Player_SetCrouchDisabled(false);
		Player_SetCrouchActionDisabled(false);
		Player_SetLeanDisabled(false);
		cScript_SetGlobalVarBool("PlayerPhysicalActionAllowed", true);
		PlayerBody_AlignLowerBodyToCameraYaw(true);
		cLux_GetPlayer().FadeCameraRollTo(ePlayerRoll_Script, 0.f, 8.f, cMath_ToRad(160.f));
		cLux_GetPlayer().MoveCameraPosAdd(eCameraAddType_Script, cVector3f_Zero, 8.f, 4.f, 0.10f);
	}

	//------------------------------------------------------------

	void Update(float afTimeStep)
	{
		if (mbFinished) return;

		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
			return;
		}

		mfTimer += afTimeStep;

		if (Player_GetUnderwater())
		{
			CancelBeamWalk("underwater");
			return;
		}
		if (cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Normal)
		{
			CancelBeamWalk("player state changed");
			return;
		}

		UpdateBalance(afTimeStep, pBody);

		float fForwardInput = GetForwardInput(pBody);
		mfCurrentMoveSpeed = mfWalkSpeed * fForwardInput;
		mfProgress += (mfCurrentMoveSpeed * afTimeStep) / cMath_Max(0.001f, mfBeamLength);
		mfProgress = cMath_Clamp(mfProgress, 0.f, 1.f);

		float fSnapT = cMath_Clamp(mfTimer / gfParkourBeamWalk_SnapTime, 0.f, 1.f);
		fSnapT = cMath_Easing(eEasing_QuadOut, fSnapT);
		cVector3f vFeet = LerpVector(mvStartFeetPos, GetFeetAtProgress(mfProgress, mfBalance), fSnapT);
		LockBodyToBeam(pBody, vFeet, true, mfCurrentMoveSpeed);
		UpdateCameraMotion(afTimeStep, fSnapT, fForwardInput);

		if (mfProgress >= 0.995f)
		{
			CompleteBeamWalk();
			return;
		}

		if (cMath_Abs(mfBalance) > 1.f)
			mfFallLimitTimer += afTimeStep;
		else
			mfFallLimitTimer = 0.f;

		if (mfFallLimitTimer >= mfFallGrace)
		{
			FallFromBeam("balance failed");
			return;
		}
	}

	//------------------------------------------------------------

	bool OnAction(int alAction, bool abPressed)
	{
		if (alAction == eAction_Crouch && abPressed)
		{
			FallFromBeam("crouch drop");
			return false;
		}

		if (alAction == eAction_Jump ||
			alAction == eAction_Interact)
		{
			return false;
		}

		return true;
	}

	//------------------------------------------------------------

	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		if (alAnalogId == eAnalogType_Look ||
			alAnalogId == eAnalogType_Lean)
		{
			return false;
		}

		return true;
	}

	//------------------------------------------------------------

	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData) {}
	void CharBody_HitGround(iCharacterBody@ apCharBody,const cVector3f &in avVel) {}
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY) { return afStartY; }

	//------------------------------------------------------------

	void ReadSetupGlobals()
	{
		mvBeamStart = cScript_GetGlobalVarVector3f("Parkour_BeamWalk_Start");
		mvBeamEnd = cScript_GetGlobalVarVector3f("Parkour_BeamWalk_End");
		mvBeamForward = cScript_GetGlobalVarVector3f("Parkour_BeamWalk_Forward");
		mvBeamRight = cScript_GetGlobalVarVector3f("Parkour_BeamWalk_Right");
		mfProgress = cScript_GetGlobalVarFloat("Parkour_BeamWalk_EntryProgress");
		mfWalkSpeed = cScript_GetGlobalVarFloat("Parkour_BeamWalk_WalkSpeed");
		mfAutoDrift = cScript_GetGlobalVarFloat("Parkour_BeamWalk_AutoDrift");
		mfCorrectionStrength = cScript_GetGlobalVarFloat("Parkour_BeamWalk_CorrectionStrength");
		mfBalanceDamping = cScript_GetGlobalVarFloat("Parkour_BeamWalk_BalanceDamping");
		mfFallGrace = cScript_GetGlobalVarFloat("Parkour_BeamWalk_FallGrace");
		mfMaxCameraRoll = cScript_GetGlobalVarFloat("Parkour_BeamWalk_MaxCameraRoll");
		mfFallSideSpeed = cScript_GetGlobalVarFloat("Parkour_BeamWalk_FallSideSpeed");
		mfFallDownSpeed = cScript_GetGlobalVarFloat("Parkour_BeamWalk_FallDownSpeed");
		mfExitSpeed = cScript_GetGlobalVarFloat("Parkour_BeamWalk_ExitSpeed");
	}

	//------------------------------------------------------------

	bool NormalizeSetup()
	{
		mvBeamStart.y = cLux_GetPlayer().GetCharacterBody().GetFeetPosition().y;
		mvBeamEnd.y = mvBeamStart.y;

		cVector3f vLine = mvBeamEnd - mvBeamStart;
		vLine.y = 0.f;
		mfBeamLength = vLine.Length();
		if (mfBeamLength <= 0.25f) return false;

		mvBeamForward.y = 0.f;
		if (mvBeamForward.SqrLength() > 0.001f)
			mvBeamForward.Normalize();
		else
			mvBeamForward = vLine * (1.f / mfBeamLength);

		mvBeamRight.y = 0.f;
		if (mvBeamRight.SqrLength() > 0.001f)
			mvBeamRight.Normalize();
		else
			mvBeamRight = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, mvBeamForward));

		if (mvBeamRight.SqrLength() <= 0.001f || cMath_Abs(cMath_Vector3Dot(mvBeamForward, mvBeamRight)) > 0.20f)
			mvBeamRight = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, mvBeamForward));
		if (mvBeamRight.SqrLength() <= 0.001f)
			mvBeamRight = cVector3f_Right;

		mfProgress = cMath_Clamp(mfProgress, 0.f, 1.f);
		mfWalkSpeed = cMath_Max(0.1f, mfWalkSpeed);
		mfAutoDrift = cMath_Max(0.f, mfAutoDrift);
		mfCorrectionStrength = cMath_Max(0.f, mfCorrectionStrength);
		mfBalanceDamping = cMath_Max(0.f, mfBalanceDamping);
		mfFallGrace = cMath_Max(0.f, mfFallGrace);
		mfMaxCameraRoll = cMath_Max(0.f, mfMaxCameraRoll);
		mfFallSideSpeed = cMath_Max(0.f, mfFallSideSpeed);
		mfExitSpeed = cMath_Max(0.f, mfExitSpeed);
		return true;
	}

	//------------------------------------------------------------

	void UpdateBalance(float afTimeStep, iCharacterBody@ apBody)
	{
		float fNoise = cMath_Clamp(cGenerate_GetNoisePerlin1D(mfDriftSeed + mfTimer * gfParkourBeamWalk_DriftNoiseSpeed), -1.f, 1.f);
		float fAuto = cMath_Clamp(fNoise * gfParkourBeamWalk_DriftNoiseMul + mfDriftBias, -1.f, 1.f) * mfAutoDrift;
		float fInput = GetBalanceInput(apBody);

		mfBalanceVelocity += (fAuto + fInput * mfCorrectionStrength) * afTimeStep;
		mfBalanceVelocity *= cMath_Clamp(1.f - mfBalanceDamping * 0.35f * afTimeStep, 0.f, 1.f);
		mfBalanceVelocity = cMath_Clamp(mfBalanceVelocity, -gfParkourBeamWalk_MaxBalanceVelocity, gfParkourBeamWalk_MaxBalanceVelocity);
		mfBalance += mfBalanceVelocity * afTimeStep;
		mfBalance *= cMath_Clamp(1.f - mfBalanceDamping * 0.025f * afTimeStep, 0.f, 1.f);
	}

	//------------------------------------------------------------

	float GetBalanceInput(iCharacterBody@ apBody)
	{
		float fInput = 0.f;
		if (cInput_IsTriggered(eAction_Right)) fInput += 1.f;
		if (cInput_IsTriggered(eAction_Left)) fInput -= 1.f;
		if (apBody !is null)
			fInput += apBody.GetMoveSpeed(eCharDir_Right);

		return cMath_Clamp(fInput, -1.f, 1.f);
	}

	//------------------------------------------------------------

	float GetForwardInput(iCharacterBody@ apBody)
	{
		float fInput = 0.f;
		if (cInput_IsTriggered(eAction_Forward)) fInput += 1.f;
		if (cInput_IsTriggered(eAction_Backward)) fInput -= 1.f;
		if (apBody !is null)
			fInput += apBody.GetMoveSpeed(eCharDir_Forward);

		return cMath_Clamp(fInput, 0.f, 1.f);
	}

	//------------------------------------------------------------

	void LockBodyToBeam(iCharacterBody@ apBody, const cVector3f &in avFeet, bool abSmooth, float afForwardSpeed)
	{
		if (apBody is null) return;

		float fYaw = GetYawFromDir(mvBeamForward);
		apBody.SetFeetPosition(avFeet, abSmooth);
		apBody.SetYaw(fYaw);
		apBody.SetMoveSpeed(eCharDir_Forward, 0.f);
		apBody.SetMoveSpeed(eCharDir_Right, 0.f);
		apBody.SetForceVelocity(mvBeamForward * cMath_Max(0.f, afForwardSpeed));
		cLux_GetPlayer().GetCamera().SetYaw(fYaw);
		PlayerBody_AlignLowerBodyToCameraYaw(true);
	}

	//------------------------------------------------------------

	cVector3f GetFeetAtProgress(float afProgress, float afBalance)
	{
		float fProgress = cMath_Clamp(afProgress, 0.f, 1.f);
		float fBalance = cMath_Clamp(afBalance, -1.15f, 1.15f);
		return mvBeamStart + mvBeamForward * (mfBeamLength * fProgress) + mvBeamRight * (fBalance * gfParkourBeamWalk_VisualSideOffset);
	}

	//------------------------------------------------------------

	void UpdateCameraMotion(float afTimeStep, float afEntryT, float afForwardInput)
	{
		cLux_GetPlayer().GetCamera().SetPitch(cMath_InterpolateLinear(mfStartPitch, cMath_ToRad(gfParkourBeamWalk_CameraPitchDeg), afEntryT));

		float fBalance = cMath_Clamp(mfBalance, -1.25f, 1.25f);
		float fWalkT = cMath_Clamp(afForwardInput, 0.f, 1.f);
		mfCameraBobTimer += afTimeStep * gfParkourBeamWalk_CameraBobFrequency * cMath_Max(0.25f, fWalkT);

		float fStep = cMath_Sin(mfCameraBobTimer);
		float fStepAbs = cMath_Abs(fStep);
		float fSide = cMath_Sin(mfCameraBobTimer * 0.5f + cMath_ToRad(45.f));
		float fBobAmount = afEntryT * fWalkT;

		cVector3f vBobTarget;
		vBobTarget.x = fSide * gfParkourBeamWalk_CameraBobSide * fBobAmount;
		vBobTarget.y = ((fStepAbs * gfParkourBeamWalk_CameraBobVertical) - (gfParkourBeamWalk_CameraBobVertical * 0.5f)) * fBobAmount;
		vBobTarget.z = -fStepAbs * gfParkourBeamWalk_CameraBobForward * fBobAmount;

		float fBlend = cMath_Clamp(afTimeStep * 14.f, 0.f, 1.f);
		mvCameraBobOffset = mvCameraBobOffset * (1.f - fBlend) + vBobTarget * fBlend;
		mfCameraBobRoll = mfCameraBobRoll * (1.f - fBlend) + (fSide * gfParkourBeamWalk_CameraBobRoll * fBobAmount) * fBlend;

		float fRollDeg = -fBalance * mfMaxCameraRoll + mfCameraBobRoll;
		cLux_GetPlayer().FadeCameraRollTo(ePlayerRoll_Script, cMath_ToRad(fRollDeg), 9.f, cMath_ToRad(180.f));

		cVector3f vOffset(fBalance * gfParkourBeamWalk_CameraSideOffset * afEntryT,
						  gfParkourBeamWalk_CameraDownOffset * afEntryT,
						  gfParkourBeamWalk_CameraForwardOffset * afEntryT);
		cLux_GetPlayer().SetCameraPosAdd(eCameraAddType_Script, vOffset + mvCameraBobOffset);
	}

	//------------------------------------------------------------

	void CompleteBeamWalk()
	{
		if (mbFinished) return;

		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
			return;
		}

		mbFinished = true;
		RestoreBody();
		pBody.SetForceVelocity(mvBeamForward * mfExitSpeed);
		Parkour_NotifyFlowEvent(geParkourFlowEvent_BeamWalkComplete, 1.f);
		cLux_PlayGuiSoundData("player/climb_ledge/low", eSoundEntryType_WorldClean, 0.25f, true);

		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Beam walk completed.", true);

		cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
	}

	//------------------------------------------------------------

	void FallFromBeam(const tString &in asReason)
	{
		if (mbFinished) return;

		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
			return;
		}

		mbFinished = true;
		RestoreBody();

		float fSide = mfBalance >= 0.f ? 1.f : -1.f;
		cVector3f vExitVel = mvBeamRight * (fSide * mfFallSideSpeed) + mvBeamForward * (mfWalkSpeed * 0.25f);
		vExitVel.y = mfFallDownSpeed;
		pBody.SetForceVelocity(vExitVel);
		Parkour_NotifyFlowEvent(geParkourFlowEvent_BeamWalkFall, 1.f);
		cLux_PlayGuiSoundData("player/foley/default/pose_jump", eSoundEntryType_World, 0.45f, true);

		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Beam walk fall: " + asReason + " balance=" + mfBalance, true);

		cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
	}

	//------------------------------------------------------------

	void CancelBeamWalk(const tString &in asReason)
	{
		if (mbFinished) return;

		mbFinished = true;
		RestoreBody();

		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Beam walk cancelled: " + asReason, true);

		cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
	}

	//------------------------------------------------------------

	void RestoreBody()
	{
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody !is null)
		{
			pBody.SetGravityActive(true);
			pBody.SetTestCollision(true);
			pBody.SetPhysicsBodyActive(true);
		}
	}

	//------------------------------------------------------------

	float GetYawFromDir(const cVector3f &in avDir)
	{
		cVector3f vDir = avDir;
		vDir.y = 0.f;
		if (vDir.SqrLength() > 0.001f)
			vDir.Normalize();
		else
			vDir = cVector3f_Forward;

		return cMath_GetAngleFromPoints3D(cVector3f_Zero, vDir).y;
	}

	//------------------------------------------------------------

	cVector3f LerpVector(const cVector3f &in avA, const cVector3f &in avB, float afT)
	{
		return avA * (1.f - afT) + avB * afT;
	}

	//------------------------------------------------------------

	cVector3f mvBeamStart = cVector3f_Zero;
	cVector3f mvBeamEnd = cVector3f_Forward;
	cVector3f mvBeamForward = cVector3f_Forward;
	cVector3f mvBeamRight = cVector3f_Right;
	cVector3f mvStartFeetPos = cVector3f_Zero;

	bool mbFinished = false;

	float mfBeamLength = 1.f;
	float mfProgress = 0.f;
	float mfWalkSpeed = 1.35f;
	float mfAutoDrift = 0.85f;
	float mfCorrectionStrength = 1.35f;
	float mfBalanceDamping = 1.10f;
	float mfFallGrace = 0.18f;
	float mfMaxCameraRoll = 16.f;
	float mfFallSideSpeed = 1.8f;
	float mfFallDownSpeed = -0.75f;
	float mfExitSpeed = 1.25f;
	float mfCurrentMoveSpeed = 0.f;
	float mfStartPitch = 0.f;
	float mfCameraBobTimer = 0.f;
	float mfCameraBobRoll = 0.f;
	float mfTimer = 0.f;
	float mfFallLimitTimer = 0.f;
	float mfBalance = 0.f;
	float mfBalanceVelocity = 0.f;
	float mfDriftSeed = 0.f;
	float mfDriftBias = 0.f;
	cVector3f mvCameraBobOffset = cVector3f_Zero;

	//------------------------------------------------------------
}

//------------------------------------------------------------
