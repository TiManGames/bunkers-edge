#include "interfaces/PlayerState_Interface.hps"
#include "base/InputHandler_Types.hps"
#include "player/Player_Types.hps"

#include "helpers/helper_player.hps"
#include "helpers/helper_items.hps"
#include "helpers/helper_modules.hps"
#include "helper_effects.hps"
#include "custom/helpers/helper_parkour.hps"

//------------------------------------------------------------

const float gfParkourPoleClimb_SnapTime = 0.14f;
const float gfParkourPoleClimb_TurnTime = 0.24f;
const float gfParkourPoleClimb_JumpOutImpulse = 255.f;
const float gfParkourPoleClimb_JumpUpImpulse = 235.f;
const float gfParkourPoleClimb_JumpForwardImpulse = 120.f;
const float gfParkourPoleClimb_DropOutSpeed = 0.35f;
const float gfParkourPoleClimb_DropDownSpeed = -0.15f;
const float gfParkourPoleClimb_TopArcHeight = 0.18f;

//------------------------------------------------------------

class cScrPlayerState_ParkourPoleClimb : iScrPlayerState, iScrPlayerState_Interface
{
	//------------------------------------------------------------
	
	void OnAttachBodyToStickyArea() {}
	
	//------------------------------------------------------------
	
	void Init() {}
	void LoadUserConfig() {}
	void SaveUserConfig() {}
	void OnMapEnter(cLuxMap @apMap) {}
	void OnMapLeave(cLuxMap @apMap) {}
	void CreateWorldEntities(cLuxMap @apMap) {}
	void DestroyWorldEntities(cLuxMap @apMap) {}
	void Reset() {}
	void PostUpdate(float afTimeStep) {}
	bool OnExitPressed() { return true; }
	
	//------------------------------------------------------------
	
	void SetupParkourPoleClimb()
	{
		mvPoleCenter = cScript_GetGlobalArgVector3f(0);
		mvFaceDir = cScript_GetGlobalArgVector3f(1);
		mvAttachFeetPos = cScript_GetGlobalArgVector3f(2);
		mfMinY = cScript_GetGlobalArgFloat(3);
		mfMaxY = cScript_GetGlobalArgFloat(4);
		mvTopExitFeetPos = cScript_GetGlobalArgVector3f(5);
		mvTopExitForward = cScript_GetGlobalArgVector3f(6);
		mbHasTopExit = cScript_GetGlobalArgBool(7);
		mbTopExitCrouch = cScript_GetGlobalArgBool(8);
		mfAttachRadius = cScript_GetGlobalArgFloat(9);
		mfClimbSpeed = cScript_GetGlobalArgFloat(10);
		mfSlideSpeed = cScript_GetGlobalArgFloat(11);
		mfTopOutTime = cScript_GetGlobalArgFloat(12);
		mfJumpTurnAngleDeg = cScript_GetGlobalArgFloat(13);
	}
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
			return;
		}
		
		NormalizeSetup();
		
		mlState = 0;
		mbFinished = false;
		mbTurning = false;
		mbHasForcedJumpDir = false;
		mbTopCrouchCompleted = false;
		mfSnapTimer = 0.f;
		mfTurnTimer = 0.f;
		mfTopOutTimer = 0.f;
		mfBobTimer = 0.f;
		mfPowerMul = cMath_Clamp(Parkour_GetWallRunPowerMul(), 0.1f, 1.15f);
		
		mvStartFeetPos = pBody.GetFeetPosition();
		mfClimbY = cMath_Clamp(mvAttachFeetPos.y, mfMinY, mfMaxY);
		mvAttachFeetPos = GetFeetPositionAtY(mfClimbY);
		mfAttachStartYaw = pBody.GetYaw();
		mfAttachTargetYaw = GetYawFromDir(mvFaceDir * -1.f);
		mfAttachStartPitch = cLux_GetPlayer().GetCamera().GetPitch();
		
		cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
		pBody.SetGravityActive(false);
		pBody.SetTestCollision(false);
		pBody.SetPhysicsBodyActive(false);
		pBody.StopMovement();
		pBody.ResetClimbing();
		
		Player_SetDisableCrawling(true);
		Player_SetCrouching(false);
		Player_SetCrouchDisabled(true);
		Player_SetCrouchActionDisabled(true);
		Player_SetLeanDisabled(true);
		Player_CancelJump();
		
		PlayerBody_SetVisible(false);
		
		Item_PutAway(eItemHandlerHand_Left);
		Item_PutAway(eItemHandlerHand_Right);
		
		cLux_PlayGuiSoundData("player/climb_ledge/low", eSoundEntryType_WorldClean, 0.55f, true);
		cLux_GetPlayer().MoveCameraPosAdd(eCameraAddType_Script, cVector3f(0.f, -0.05f, 0.06f), 10.f, 6.f, 0.08f);
		
		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Pole climb state entered.", true);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId)
	{
		RestoreBody();
		Player_ResetCameraLimits();
		Player_SetDisableCrawling(false);
		Player_SetCrouchDisabled(false);
		Player_SetCrouchActionDisabled(false);
		Player_SetLeanDisabled(false);
		cLux_GetPlayer().FadeCameraRollTo(ePlayerRoll_Script, 0.f, 8.f, cMath_ToRad(160.f));
		cLux_GetPlayer().MoveCameraPosAdd(eCameraAddType_Script, cVector3f_Zero, 8.f, 4.f, 0.10f);
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		if (mbFinished) return;
		
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
			return;
		}
		
		if (mlState == 0)
			UpdateAttach(pBody, afTimeStep);
		else if (mlState == 1)
			UpdateClimb(pBody, afTimeStep);
		else if (mlState == 2)
			UpdateTopOut(pBody, afTimeStep);
	}
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		if (abPressed == false) return false;
		
		if (alAction == eAction_LeanLeft)
		{
			StartLeanTurn(-1);
			return false;
		}
		if (alAction == eAction_LeanRight)
		{
			StartLeanTurn(1);
			return false;
		}
		if (alAction == eAction_Jump)
		{
			if (mlState == 1)
				JumpOut();
			return false;
		}
		if (alAction == eAction_Crouch)
		{
			DropFromPole();
			return false;
		}
		if (alAction == eAction_Interact)
			return false;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		if (alAnalogId == eAnalogType_Look)
		{
			return mlState == 1 && mbTurning == false;
		}
		
		if (alAnalogId == eAnalogType_Move || alAnalogId == eAnalogType_GamepadMove)
		{
			if (mlState == 1)
			{
				if (avAmount.y > 0.1f)
					mfInputMoveMul += 1.f;
				else if (avAmount.y < -0.1f)
					mfInputMoveMul -= 1.f;
			}
			
			return false;
		}
		
		if (alAnalogId == eAnalogType_Lean)
			return false;
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool AllowBuoyancy(iPhysicsBody @apBody)
	{
		return true;
	}
	
	//------------------------------------------------------------
	
	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData) {}
	void CharBody_HitGround(iCharacterBody@ apCharBody, const cVector3f &in avVel) {}
	
	//------------------------------------------------------------
	
	float DrawDebugOutput(cGuiSet @apSet, iFontData @apFont, float afStartY)
	{
		return afStartY;
	}
	
	//------------------------------------------------------------
	
	void NormalizeSetup()
	{
		mvFaceDir.y = 0.f;
		if (mvFaceDir.SqrLength() > 0.001f)
			mvFaceDir.Normalize();
		else
			mvFaceDir = cVector3f_Forward;
		
		mvTopExitForward.y = 0.f;
		if (mvTopExitForward.SqrLength() > 0.001f)
			mvTopExitForward.Normalize();
		else
			mvTopExitForward = mvFaceDir;
		
		if (mfMaxY < mfMinY)
		{
			float fTemp = mfMinY;
			mfMinY = mfMaxY;
			mfMaxY = fTemp;
		}
		
		mfAttachRadius = cMath_Max(0.05f, mfAttachRadius);
		mfClimbSpeed = cMath_Max(0.05f, mfClimbSpeed);
		mfSlideSpeed = cMath_Max(0.05f, mfSlideSpeed);
		mfTopOutTime = cMath_Max(0.10f, mfTopOutTime);
		mfJumpTurnAngleDeg = cMath_Clamp(mfJumpTurnAngleDeg, 15.f, 170.f);
	}
	
	//------------------------------------------------------------
	
	void UpdateAttach(iCharacterBody@ apBody, float afTimeStep)
	{
		mfSnapTimer += afTimeStep;
		float fT = cMath_Clamp(mfSnapTimer / gfParkourPoleClimb_SnapTime, 0.f, 1.f);
		fT = cMath_Easing(eEasing_QuadOut, fT);
		
		apBody.SetFeetPosition(LerpVector(mvStartFeetPos, mvAttachFeetPos, fT), true);
		float fYaw = mfAttachStartYaw + cMath_GetAngleDistanceRad(mfAttachStartYaw, mfAttachTargetYaw) * fT;
		apBody.SetYaw(fYaw);
		cLux_GetPlayer().GetCamera().SetYaw(fYaw);
		cLux_GetPlayer().GetCamera().SetPitch(mfAttachStartPitch * (1.f - fT));
		
		if (fT >= 1.f)
		{
			mlState = 1;
			mfInputMoveMul = 0.f;
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateClimb(iCharacterBody@ apBody, float afTimeStep)
	{
		float fMove = 0.f;
		if (cInput_IsTriggered(eAction_Forward))
			fMove += 1.f;
		if (cInput_IsTriggered(eAction_Backward))
			fMove -= 1.f;
		fMove = cMath_Clamp(fMove + mfInputMoveMul, -1.f, 1.f);
		mfInputMoveMul = 0.f;
		
		if (fMove > 0.f)
			mfClimbY += mfClimbSpeed * afTimeStep;
		else if (fMove < 0.f)
			mfClimbY -= mfSlideSpeed * afTimeStep;
		
		if (mfClimbY >= mfMaxY)
		{
			mfClimbY = mfMaxY;
			if (fMove > 0.f && mbHasTopExit)
			{
				StartTopOut(apBody);
				return;
			}
		}
		else if (mfClimbY < mfMinY)
		{
			mfClimbY = mfMinY;
		}
		
		apBody.SetFeetPosition(GetFeetPositionAtY(mfClimbY), true);
		UpdateLeanTurn(apBody, afTimeStep);
		UpdateCameraMotion(fMove, afTimeStep);
	}
	
	//------------------------------------------------------------
	
	void UpdateCameraMotion(float afMove, float afTimeStep)
	{
		float fMoveAbs = cMath_Abs(afMove);
		if (fMoveAbs > 0.001f)
			mfBobTimer += afTimeStep * (afMove > 0.f ? 10.5f : 7.0f);
		
		float fRollAmount = 0.f;
		float fBobY = -0.04f;
		float fBobZ = 0.06f;
		if (afMove > 0.f)
		{
			fRollAmount = cMath_Sin(mfBobTimer) * 3.0f;
			fBobY += cMath_Sin(mfBobTimer * 1.7f) * 0.025f;
			fBobZ += 0.02f;
		}
		else if (afMove < 0.f)
		{
			fRollAmount = cMath_Sin(mfBobTimer) * 1.2f;
			fBobY -= 0.035f;
			fBobZ -= 0.01f;
		}
		
		cLux_GetPlayer().SetCameraRoll(ePlayerRoll_Script, cMath_ToRad(fRollAmount));
		cLux_GetPlayer().MoveCameraPosAdd(eCameraAddType_Script,
										  cVector3f(0.f, fBobY, fBobZ),
										  10.f,
										  6.f,
										  0.06f);
	}
	
	//------------------------------------------------------------
	
	void StartLeanTurn(int alDir)
	{
		if (mlState != 1) return;
		
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null) return;
		
		mlTurnDir = alDir >= 0 ? 1 : -1;
		mvForcedJumpDir = Rotate2D(mvFaceDir * -1.f, cMath_ToRad(mfJumpTurnAngleDeg) * float(mlTurnDir));
		mvForcedJumpDir.y = 0.f;
		if (mvForcedJumpDir.SqrLength() > 0.001f)
			mvForcedJumpDir.Normalize();
		else
			mvForcedJumpDir = mvFaceDir;
		
		mfTurnStartYaw = pBody.GetYaw();
		mfTurnTargetYaw = GetYawFromDir(mvForcedJumpDir);
		mfTurnTimer = 0.f;
		mbTurning = true;
		mbHasForcedJumpDir = true;
		Effect_Shake_Start(0.035f, 0.08f, 0.f, 0.08f, cVector3f(1, 1, 1), 14);
		
		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Pole climb quick turn.", true);
	}
	
	//------------------------------------------------------------
	
	void UpdateLeanTurn(iCharacterBody@ apBody, float afTimeStep)
	{
		if (mbTurning == false) return;
		
		mfTurnTimer += afTimeStep;
		float fT = cMath_Clamp(mfTurnTimer / gfParkourPoleClimb_TurnTime, 0.f, 1.f);
		fT = cMath_Easing(eEasing_SineInOut, fT);
		
		float fTargetYaw = mfTurnStartYaw + cMath_GetAngleDistanceRad(mfTurnStartYaw, mfTurnTargetYaw) * fT;
		apBody.SetYaw(fTargetYaw);
		cLux_GetPlayer().GetCamera().SetYaw(fTargetYaw);
		
		if (fT >= 1.f)
			mbTurning = false;
	}
	
	//------------------------------------------------------------
	
	void StartTopOut(iCharacterBody@ apBody)
	{
		mlState = 2;
		mfTopOutTimer = 0.f;
		mvTopOutStartFeet = apBody.GetFeetPosition();
		mvTopOutEndFeet = mvTopExitFeetPos + cVector3f(0.f, 0.01f, 0.f);
		mfTopOutStartYaw = apBody.GetYaw();
		mfTopOutEndYaw = GetYawFromDir(mvTopExitForward);
		mbTopCrouchCompleted = false;
		cLux_PlayGuiSoundData("player/climb_ledge/high", eSoundEntryType_WorldClean, 0.65f, true);
	}
	
	//------------------------------------------------------------
	
	void UpdateTopOut(iCharacterBody@ apBody, float afTimeStep)
	{
		mfTopOutTimer += afTimeStep;
		float fT = cMath_Clamp(mfTopOutTimer / mfTopOutTime, 0.f, 1.f);
		float fMoveT = cMath_Easing(eEasing_QuadInOut, fT);
		
		cVector3f vPos = LerpVector(mvTopOutStartFeet, mvTopOutEndFeet, fMoveT);
		vPos.y += cMath_Sin(fMoveT * cMath_Pi) * gfParkourPoleClimb_TopArcHeight;
		apBody.SetFeetPosition(vPos, true);
		
		float fYaw = mfTopOutStartYaw + cMath_GetAngleDistanceRad(mfTopOutStartYaw, mfTopOutEndYaw) * fMoveT;
		apBody.SetYaw(fYaw);
		cLux_GetPlayer().GetCamera().SetYaw(fYaw);
		cLux_GetPlayer().GetCamera().SetPitch(cLux_GetPlayer().GetCamera().GetPitch() * (1.f - fMoveT));
		cLux_GetPlayer().SetCameraRoll(ePlayerRoll_Script, cMath_ToRad(cMath_Sin(fMoveT * cMath_Pi) * 5.f));
		
		if (mbTopExitCrouch && mbTopCrouchCompleted == false && fT > 0.65f)
		{
			Player_SetCrouching(true);
			mbTopCrouchCompleted = true;
		}
		
		if (fT >= 1.f)
		{
			mbFinished = true;
			Parkour_NotifyFlowEvent(geParkourFlowEvent_PoleClimbTopOut, 1.f);
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
		}
	}
	
	//------------------------------------------------------------
	
	void JumpOut()
	{
		if (mbFinished) return;
		
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
			return;
		}
		
		cVector3f vJumpDir = GetJumpOutDir();
		cVector3f vImpulse = mvFaceDir * gfParkourPoleClimb_JumpOutImpulse * mfPowerMul;
		vImpulse += cVector3f_Up * gfParkourPoleClimb_JumpUpImpulse * mfPowerMul;
		vImpulse += vJumpDir * gfParkourPoleClimb_JumpForwardImpulse * mfPowerMul;
		
		mbFinished = true;
		RestoreBody();
		pBody.SetForceVelocity(cVector3f_Zero);
		pBody.AddImpulse(vImpulse);
		Parkour_NotifyFlowEvent(geParkourFlowEvent_PoleClimbJump, 1.f);
		cLux_PlayGuiSoundData("player/foley/default/pose_jump", eSoundEntryType_World, 0.75f, true);
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	}
	
	//------------------------------------------------------------
	
	void DropFromPole()
	{
		if (mbFinished) return;
		
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			cLux_GetPlayer().ChangeState(ePlayerState_Normal);
			return;
		}
		
		mbFinished = true;
		RestoreBody();
		pBody.SetForceVelocity(mvFaceDir * gfParkourPoleClimb_DropOutSpeed +
							   cVector3f(0.f, gfParkourPoleClimb_DropDownSpeed, 0.f));
		Parkour_NotifyFlowEvent(geParkourFlowEvent_PoleClimbDrop, 1.f);
		
		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[Parkour] Pole climb dropped.", true);
		
		cLux_GetPlayer().ChangeState(ePlayerState_Normal);
	}
	
	//------------------------------------------------------------
	
	cVector3f GetJumpOutDir()
	{
		if (mbHasForcedJumpDir && mvForcedJumpDir.SqrLength() > 0.001f)
			return mvForcedJumpDir;
		
		cVector3f vBaseDir = mvFaceDir * -1.f;
		if (vBaseDir.SqrLength() <= 0.001f)
			vBaseDir = cVector3f_Forward;
		vBaseDir.Normalize();
		
		cVector3f vCamDir = cLux_GetPlayer().GetCamera().GetForward();
		vCamDir.y = 0.f;
		if (vCamDir.SqrLength() <= 0.001f)
			return vBaseDir;
		vCamDir.Normalize();
		
		float fBaseYaw = GetYawFromDir(vBaseDir);
		float fCamYaw = GetYawFromDir(vCamDir);
		float fMaxTurn = cMath_ToRad(mfJumpTurnAngleDeg);
		float fDelta = cMath_Clamp(cMath_GetAngleDistanceRad(fBaseYaw, fCamYaw), -fMaxTurn, fMaxTurn);
		return Rotate2D(vBaseDir, fDelta);
	}
	
	//------------------------------------------------------------
	
	cVector3f GetFeetPositionAtY(float afY)
	{
		cVector3f vPos = mvPoleCenter + mvFaceDir * mfAttachRadius;
		vPos.y = afY;
		return vPos;
	}
	
	//------------------------------------------------------------
	
	float GetYawFromDir(const cVector3f &in avDir)
	{
		cVector3f vDir = avDir;
		vDir.y = 0.f;
		if (vDir.SqrLength() > 0.001f)
			vDir.Normalize();
		else
			vDir = cVector3f_Forward;
		
		return cMath_GetAngleFromPoints3D(cVector3f_Zero, vDir).y;
	}
	
	//------------------------------------------------------------
	
	cVector3f Rotate2D(const cVector3f &in avDir, float afYaw)
	{
		float fSin = cMath_Sin(afYaw);
		float fCos = cMath_Cos(afYaw);
		cVector3f vOut;
		vOut.x = avDir.x * fCos - avDir.z * fSin;
		vOut.y = 0.f;
		vOut.z = avDir.x * fSin + avDir.z * fCos;
		if (vOut.SqrLength() > 0.001f)
			vOut.Normalize();
		else
			vOut = cVector3f_Forward;
		return vOut;
	}
	
	//------------------------------------------------------------
	
	void RestoreBody()
	{
		PlayerBody_SetVisible(true);
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody !is null)
		{
			pBody.SetGravityActive(true);
			pBody.SetTestCollision(true);
			pBody.SetPhysicsBodyActive(true);
		}
	}
	
	//------------------------------------------------------------
	
	cVector3f LerpVector(const cVector3f &in avA, const cVector3f &in avB, float afT)
	{
		return avA * (1.f - afT) + avB * afT;
	}
	
	//------------------------------------------------------------
	
	cVector3f mvPoleCenter = cVector3f_Zero;
	cVector3f mvFaceDir = cVector3f_Forward;
	cVector3f mvAttachFeetPos = cVector3f_Zero;
	cVector3f mvTopExitFeetPos = cVector3f_Zero;
	cVector3f mvTopExitForward = cVector3f_Forward;
	cVector3f mvStartFeetPos = cVector3f_Zero;
	cVector3f mvForcedJumpDir = cVector3f_Forward;
	cVector3f mvTopOutStartFeet = cVector3f_Zero;
	cVector3f mvTopOutEndFeet = cVector3f_Zero;
	
	bool mbHasTopExit = false;
	bool mbTopExitCrouch = false;
	bool mbFinished = false;
	bool mbTurning = false;
	bool mbHasForcedJumpDir = false;
	bool mbTopCrouchCompleted = false;
	
	float mfMinY = 0.f;
	float mfMaxY = 1.f;
	float mfAttachRadius = 0.42f;
	float mfClimbSpeed = 0.85f;
	float mfSlideSpeed = 1.85f;
	float mfTopOutTime = 0.58f;
	float mfJumpTurnAngleDeg = 130.f;
	float mfPowerMul = 1.f;
	float mfClimbY = 0.f;
	float mfSnapTimer = 0.f;
	float mfTurnTimer = 0.f;
	float mfTopOutTimer = 0.f;
	float mfBobTimer = 0.f;
	float mfInputMoveMul = 0.f;
	float mfAttachStartYaw = 0.f;
	float mfAttachTargetYaw = 0.f;
	float mfAttachStartPitch = 0.f;
	float mfTurnStartYaw = 0.f;
	float mfTurnTargetYaw = 0.f;
	float mfTopOutStartYaw = 0.f;
	float mfTopOutEndYaw = 0.f;
	
	int mlState = 0;
	int mlTurnDir = 1;
	
	//------------------------------------------------------------
}

//------------------------------------------------------------
