#include "interfaces/MoveState_Interface.hps"
#include "base/InputHandler_Types.hps"
#include "player/Player_Types.hps"
#include "custom/player/PlayerTypes_Custom.hps"

#include "helpers/helper_player.hps"
#include "helpers/helper_items.hps"
#include "custom/helpers/helper_parkour.hps"

//------------------------------------------------------------

const float gfParkourWallRun_MaxTime = 1.3f;
const float gfParkourWallRun_Speed = 5.8f;
const float gfParkourWallRun_MinVerticalVel = -14.65f;
const float gfParkourWallRun_AntiGravityMul = 0.65f;
const float gfParkourWallRun_LostWallGrace = 0.15f;
const float gfParkourWallRun_EntryExitGrace = 0.22f;
const float gfParkourWallRun_ForwardReleaseGrace = 0.28f;
const float gfParkourWallRun_GroundExitGrace = 0.18f;
const float gfParkourWallRun_OutwardLookAngle = cMath_ToRad(70.f);
const float gfParkourWallRun_OutwardLookSpeed = 10.f;
const float gfParkourWallRun_OutwardLookDeadZone = 0.20f;
const float gfParkourWallJump_SideImpulse = 240.f;
const float gfParkourWallJump_UpImpulse = 350.f;
const float gfParkourWallJump_ForwardImpulse = 125.f;
const float gfParkourWallJump_ClearanceSpeed = 0.35f;
const float gfParkourWallJump_FullTransferAngle = cMath_ToRad(60.f);
const float gfParkourWallJump_ForwardSpeedMul = 0.75f;
const float gfParkourWallJump_TransferSpeedMul = 0.85f;
const float gfParkourWallRun_CameraBobEntryTime = 0.18f;
const float gfParkourWallRun_CameraBobFrequency = 12.0f;
const float gfParkourWallRun_CameraBobVertical = 0.075f;
const float gfParkourWallRun_CameraBobSide = 0.055f;
const float gfParkourWallRun_CameraBobForward = 0.145f;
const float gfParkourWallRun_CameraBobRoll = 2.8f;
const float gfParkourWallRun_CameraOrganicFrequency = 1.85f;
const float gfParkourWallRun_CameraOrganicSide = 0.018f;
const float gfParkourWallRun_CameraOrganicVertical = 0.014f;
const float gfParkourWallRun_CameraOrganicForward = 0.020f;
const float gfParkourWallRun_CameraOrganicRoll = 0.85f;

const tString gsWallRunSound = "WallRun.ogg";

//------------------------------------------------------------

class cScrMoveState_ParkourWallRun : iScrMoveState, iScrMoveState_Interface
{
	//------------------------------------------------------------
	
	void Init() {}
	void OnMapEnter(cLuxMap @apMap) {}
	void Reset() {}
	
	//------------------------------------------------------------
	
	void OnEnterState(int alPrevStateId)
	{
		mfTimer = 0.f;
		mfLostWallTimer = gfParkourWallRun_LostWallGrace;
		mfForwardReleaseTimer = gfParkourWallRun_ForwardReleaseGrace;
		mfGroundTimer = gfParkourWallRun_GroundExitGrace;
		mfOutwardLookYawOffset = 0.f;
		mfOutwardLookTargetYawOffset = 0.f;
		mbOutwardLookLeanInputHeld = false;
		cScript_SetGlobalVarInt("Parkour_WallRun_SuppressLeanTurnUntilRelease", 0);
		mfCameraBobTimer = 0.f;
		mfCameraBobRoll = 0.f;
		mfCameraOrganicSeedX = cMath_RandRectf(-100.f, 100.f);
		mfCameraOrganicSeedY = cMath_RandRectf(-100.f, 100.f);
		mfCameraOrganicSeedZ = cMath_RandRectf(-100.f, 100.f);
		mfCameraOrganicSeedRoll = cMath_RandRectf(-100.f, 100.f);
		mvCameraBobOffset = cVector3f_Zero;
		msLastWallRefreshFail = "";
		mvWallNormal = cScript_GetGlobalVarVector3f("Parkour_WallRun_Normal");
		mvWallForward = cScript_GetGlobalVarVector3f("Parkour_WallRun_Forward");
		mlWallSide = cScript_GetGlobalVarInt("Parkour_WallRun_Side");
		mfPowerMul = cMath_Clamp(Parkour_GetWallRunPowerMul(), 0.1f, 1.15f);
		
		if (mvWallNormal.SqrLength() > 0.001f) mvWallNormal.Normalize();
		if (mvWallForward.SqrLength() > 0.001f) mvWallForward.Normalize();
		
		Player_SetDisableCrawling(true);
		Player_SetCrouching(false, false, true);
		Player_SetCrouchDisabled(true);
		Player_SetCrouchActionDisabled(true);
		Player_SetLeanDisabled(true);
		Player_CancelJump();
		
		Item_PutAway(eItemHandlerHand_Left);
		Item_PutAway(eItemHandlerHand_Right);
		
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody !is null)
		{
			cVector3f vVel = pBody.GetForceVelocity();
			vVel.y = cMath_Max(vVel.y, gfParkourWallRun_MinVerticalVel);
			pBody.SetForceVelocity(vVel);
		}
		
		cLux_GetPlayer().SetCameraPosAdd(eCameraAddType_Script, cVector3f_Zero);
		UpdateCameraRoll(0.f);

		@mpWallRunSound = cSound_PlayGuiStream(gsWallRunSound, false, 1.0f, cLux_GetPlayer().GetCharacterBody().GetPosition(), eSoundEntryType_Gui);
	}
	
	//------------------------------------------------------------
	
	void OnLeaveState(int alNextStateId)
	{
		Player_SetDisableCrawling(false);
		Player_SetCrouchDisabled(false);
		Player_SetCrouchActionDisabled(false);
		Player_SetLeanDisabled(false);
		ResetOutwardLookYaw();
		cLux_GetPlayer().FadeCameraRollTo(ePlayerRoll_Script, 0.f, 7.f, cMath_ToRad(140.f));
		cLux_GetPlayer().MoveCameraPosAdd(eCameraAddType_Script, cVector3f_Zero, 8.f, 4.f, 0.10f);

		mpWallRunSound.FadeVolumeMulTo(0, 1.0f);
	}
	
	//------------------------------------------------------------
	
	void Update(float afTimeStep)
	{
		mfLastVelocityTimeStep = Parkour_GetSafeVelocityTimeStep(afTimeStep);
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			EndWallRun("no player body");
			return;
		}
		
		mfTimer += afTimeStep;
		
		if (Player_GetUnderwater())
		{
			EndWallRun("underwater");
			return;
		}
		if (mfTimer > gfParkourWallRun_EntryExitGrace && cLux_GetPlayer().GetCurrentStateId() != ePlayerState_Normal)
		{
			EndWallRun("player state changed");
			return;
		}
		if (mfTimer > gfParkourWallRun_MaxTime)
		{
			EndWallRun("timer expired");
			return;
		}
		
		float fControllerForwardInput = Parkour_GetForwardInputAmount();
		if (cInput_IsTriggered(eAction_Forward) ||
			fControllerForwardInput > 0.1f ||
			pBody.GetMoveSpeed(eCharDir_Forward) > 0.05f)
			mfForwardReleaseTimer = gfParkourWallRun_ForwardReleaseGrace;
		else if (mfTimer > gfParkourWallRun_EntryExitGrace)
			mfForwardReleaseTimer -= afTimeStep;
		
		if (mfForwardReleaseTimer <= 0.f)
		{
			EndWallRun("forward released [ParkourController diag1 cachedLS=" +
				fControllerForwardInput + " body=" + pBody.GetMoveSpeed(eCharDir_Forward) + "]");
			return;
		}
		
		if (pBody.IsOnGround())
		{
			if (mfTimer > gfParkourWallRun_EntryExitGrace)
				mfGroundTimer -= afTimeStep;
		}
		else
		{
			mfGroundTimer = gfParkourWallRun_GroundExitGrace;
		}
		
		if (mfGroundTimer <= 0.f)
		{
			EndWallRun("grounded");
			return;
		}
		
		cVector3f vNewNormal;
		if (RefreshWallNormal(pBody, vNewNormal, afTimeStep) == false)
		{
			mfLostWallTimer -= afTimeStep;
			if (mfLostWallTimer <= 0.f)
			{
				EndWallRun(msLastWallRefreshFail);
				return;
			}
		}
		else
		{
			mfLostWallTimer = gfParkourWallRun_LostWallGrace;
			mvWallNormal = vNewNormal;
			RefreshWallForward(pBody, afTimeStep);
		}
		
		cVector3f vTarget = mvWallForward * gfParkourWallRun_Speed * mfPowerMul;
		cVector3f vForceVel = pBody.GetForceVelocity();
		vTarget.y = cMath_Max(vForceVel.y, gfParkourWallRun_MinVerticalVel);
		pBody.SetForceVelocity(vTarget);
		
		iPhysicsWorld@ pPhysicsWorld = cLux_GetCurrentMap().GetPhysicsWorld();
		cVector3f vGravity = pBody.GetCustomGravityActive() ? pBody.GetCustomGravity() : pPhysicsWorld.GetGravity();
		pBody.AddForce(cVector3f(0.f, -vGravity.y * pBody.GetMass() * gfParkourWallRun_AntiGravityMul, 0.f));
		
		UpdateCameraMotion(afTimeStep, pBody);
		UpdateOutwardLookYaw(afTimeStep, pBody);
	}
	
	//------------------------------------------------------------
	
	bool OnAction(int alAction, bool abPressed)
	{
		if (alAction == eAction_LeanLeft || alAction == eAction_LeanRight)
		{
			int lYawDir = alAction == eAction_LeanRight ? -1 : 1;
			if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed())
			{
				// Controller bumpers select and latch a look side on press. Their release
				// must not recenter the view; keyboard Q/E retain the held behavior below.
				mbOutwardLookLeanInputHeld = false;
				if (abPressed)
				{
					SetOutwardLookFromYawDir(lYawDir);
					if (Parkour_GetDebug())
						cLux_AddDebugMessage("[ParkourController turn latch] yawDir=" + lYawDir, true);
				}

				return false;
			}

			mbOutwardLookLeanInputHeld = abPressed ||
										 cInput_IsTriggered(eAction_LeanLeft) ||
										 cInput_IsTriggered(eAction_LeanRight) ||
										 cInput_IsTriggered(eAction_AnalogLean);
			if (abPressed)
				SetOutwardLookFromYawDir(lYawDir);
			else if (cMath_Sign(mfOutwardLookTargetYawOffset) == float(lYawDir))
				mfOutwardLookTargetYawOffset = 0.f;

			return false;
		}

		if (alAction == eAction_AnalogLean)
		{
			if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed())
				return false;

			mbOutwardLookLeanInputHeld = abPressed ||
										 cInput_IsTriggered(eAction_LeanLeft) ||
										 cInput_IsTriggered(eAction_LeanRight);
			if (abPressed == false)
				mfOutwardLookTargetYawOffset = 0.f;

			return false;
		}

		if (alAction == eAction_Jump && abPressed)
		{
			cVector3f vJumpLook = cLux_GetPlayer().GetCamera().GetForward();
			CancelOutwardLookForWallJump();

			if (Parkour_TryStartLedgeGrab(false))
				return false;

			WallJump(vJumpLook);
			return false;
		}
		
		if (alAction == eAction_Crouch && abPressed)
		{
			EndWallRun();
			return false;
		}
		
		return true;
	}
	
	//------------------------------------------------------------
	
	bool OnAnalogInput(int alAnalogId, const cVector3f &in avAmount)
	{
		if (alAnalogId == eAnalogType_Lean)
		{
			if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed())
			{
				mbOutwardLookLeanInputHeld = false;
				if (cMath_Abs(avAmount.x) > gfParkourWallRun_OutwardLookDeadZone)
				{
					int lYawDir = avAmount.x > 0.f ? -1 : 1;
					SetOutwardLookFromYawDir(lYawDir);
				}

				return false;
			}

			mbOutwardLookLeanInputHeld = cMath_Abs(avAmount.x) > gfParkourWallRun_OutwardLookDeadZone;

			if (cMath_Abs(avAmount.x) > gfParkourWallRun_OutwardLookDeadZone)
			{
				int lYawDir = avAmount.x > 0.f ? -1 : 1;
				SetOutwardLookFromYawDir(lYawDir);
			}
			else
				mfOutwardLookTargetYawOffset = 0.f;

			return false;
		}

		return true;
	}
	
	//------------------------------------------------------------
	
	void CharBody_GravityCollide(iCharacterBody@ apCharBody, iPhysicsBody@ apBody, cCollideData @apCollideData) {}
	void CharBody_HitGround(iCharacterBody@ apCharBody,const cVector3f &in avVel) {}
	float DrawDebugOutput(cGuiSet @apSet,iFontData @apFont,float afStartY) { return afStartY; }

	//------------------------------------------------------------
	
	bool RefreshWallNormal(iCharacterBody@ apBody, cVector3f &out avNormal, float afTimeStep)
	{
		msLastWallRefreshFail = "";
		int lWallSide;
		float fDistance;
		tString sFailReason;
		if (Parkour_FindWallRunWall(apBody, mlWallSide, gfParkourWallDetect_SustainRayLength, true, avNormal, lWallSide, fDistance, sFailReason, afTimeStep))
		{
			mlWallSide = lWallSide;
			msLastWallRefreshFail = "";
			return true;
		}
		
		if (RefreshWallNormalFromLastNormal(apBody, avNormal))
			return true;
		
		if (msLastWallRefreshFail == "")
			msLastWallRefreshFail = sFailReason;
		return false;
	}
	
	//------------------------------------------------------------

	bool RefreshWallNormalFromLastNormal(iCharacterBody@ apBody, cVector3f &out avNormal)
	{
		avNormal = cVector3f_Zero;
		
		cVector3f vRayDir = mvWallNormal * -1.f;
		vRayDir.y = 0.f;
		if (vRayDir.SqrLength() <= 0.001f) return false;
		vRayDir.Normalize();
		
		array<float> vHeights = { 0.65f, 1.05f, 1.45f };
		float fBestDistance = 1000.f;
		bool bFoundWall = false;
		bool bAnyBodyHit = false;
		
		for (uint h = 0; h < vHeights.size(); ++h)
		{
			cVector3f vStart = apBody.GetFeetPosition() + cVector3f(0.f, vHeights[h], 0.f);
			float fDistance;
			cVector3f vNormal;
			bool bBodyHit;
			
			if (Parkour_CastWallRunRay(vStart, vRayDir, gfParkourWallDetect_SustainRayLength, fDistance, vNormal, bBodyHit))
			{
				if (bFoundWall == false || fDistance < fBestDistance)
				{
					fBestDistance = fDistance;
					avNormal = vNormal;
					bFoundWall = true;
				}
			}
			else if (bBodyHit)
			{
				bAnyBodyHit = true;
			}
		}
		
		if (bFoundWall)
		{
			msLastWallRefreshFail = "";
			return true;
		}
		
		if (bAnyBodyHit)
			msLastWallRefreshFail = "invalid wall normal";
		
		return false;
	}
	
	//------------------------------------------------------------
	
	void RefreshWallForward(iCharacterBody@ apBody, float afTimeStep)
	{
		cVector3f vReferenceFwd = mvWallForward;
		vReferenceFwd.y = 0.f;
		if (vReferenceFwd.SqrLength() > 0.001f)
			vReferenceFwd.Normalize();
		else
		{
			cVector3f vRight;
			if (Parkour_GetWallRunBasis(apBody, vReferenceFwd, vRight, afTimeStep) == false)
			{
				vReferenceFwd = cLux_GetPlayer().GetCamera().GetForward();
				vReferenceFwd.y = 0.f;
				if (vReferenceFwd.SqrLength() > 0.001f) vReferenceFwd.Normalize();
			}
		}
		
		mvWallForward = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, mvWallNormal));
		if (cMath_Vector3Dot(mvWallForward, vReferenceFwd) < 0.f)
			mvWallForward *= -1.f;
	}
	
	//------------------------------------------------------------

	void SetOutwardLookFromYawDir(int alYawDir)
	{
		mfOutwardLookTargetYawOffset = gfParkourWallRun_OutwardLookAngle * float(alYawDir);
	}

	//------------------------------------------------------------

	void UpdateOutwardLookYaw(float afTimeStep, iCharacterBody@ apBody)
	{
		if (apBody is null) return;

		float fBlend = cMath_Clamp(afTimeStep * gfParkourWallRun_OutwardLookSpeed, 0.f, 1.f);
		float fPrevOffset = mfOutwardLookYawOffset;
		mfOutwardLookYawOffset += (mfOutwardLookTargetYawOffset - mfOutwardLookYawOffset) * fBlend;
		apBody.AddYaw(mfOutwardLookYawOffset - fPrevOffset);

		if (cMath_Abs(mfOutwardLookYawOffset) < 0.001f &&
			cMath_Abs(mfOutwardLookTargetYawOffset) < 0.001f)
		{
			mfOutwardLookYawOffset = 0.f;
			return;
		}
	}

	//------------------------------------------------------------

	void ResetOutwardLookYaw()
	{
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody !is null)
			pBody.AddYaw(-mfOutwardLookYawOffset);

		mfOutwardLookYawOffset = 0.f;
		mfOutwardLookTargetYawOffset = 0.f;
	}

	//------------------------------------------------------------

	void CancelOutwardLookForWallJump()
	{
		bool bLeanHeld = cInput_IsTriggered(eAction_LeanLeft) ||
						 cInput_IsTriggered(eAction_LeanRight) ||
						 cInput_IsTriggered(eAction_AnalogLean) ||
						 mbOutwardLookLeanInputHeld;
		bool bLookActive = cMath_Abs(mfOutwardLookYawOffset) > 0.001f ||
						   cMath_Abs(mfOutwardLookTargetYawOffset) > 0.001f;

		if (bLeanHeld || bLookActive)
			cScript_SetGlobalVarInt("Parkour_WallRun_SuppressLeanTurnUntilRelease", 1);

		mfOutwardLookYawOffset = 0.f;
		mfOutwardLookTargetYawOffset = 0.f;
		mbOutwardLookLeanInputHeld = false;
	}

	//------------------------------------------------------------
	
	void WallJump(const cVector3f &in avLookDirection)
	{
		iCharacterBody@ pBody = cLux_GetPlayer().GetCharacterBody();
		if (pBody is null)
		{
			EndWallRun("wall jump without body");
			return;
		}
		
		cVector3f vCamFwd = avLookDirection;
		vCamFwd.y = 0.f;
		if (vCamFwd.SqrLength() > 0.001f) vCamFwd.Normalize();
		else vCamFwd = mvWallForward;
		float fOutDot = cMath_Vector3Dot(vCamFwd, mvWallNormal);
		if (fOutDot < 0.f)
		{
			vCamFwd = mvWallForward;
			fOutDot = 0.f;
		}
		float fBlend = cMath_Clamp(cMath_ASin(cMath_Clamp(fOutDot, 0.f, 1.f)) /
			gfParkourWallJump_FullTransferAngle, 0.f, 1.f);
		float fMass = cMath_Max(pBody.GetMass(), 0.001f);
		cVector3f vIncoming = Parkour_GetFlatVelocity(pBody, mfLastVelocityTimeStep);
		float fIncomingSpeed = vIncoming.Length();
		cVector3f vForwardJump = mvWallForward * cMath_Max(fIncomingSpeed, gfParkourWallRun_Speed * mfPowerMul) +
			mvWallNormal * gfParkourWallJump_ClearanceSpeed;
		cVector3f vTransfer = (mvWallNormal * gfParkourWallJump_SideImpulse +
			vCamFwd * gfParkourWallJump_ForwardImpulse) * (mfPowerMul / fMass);
		// Direction blends continuously; horizontal speed never stacks both launches.
		cVector3f vLaunch = vForwardJump * (1.f - fBlend) + vTransfer * fBlend;
		float fLegacyMaxSpeed = (gfParkourWallJump_SideImpulse + gfParkourWallJump_ForwardImpulse) * mfPowerMul / fMass;
		float fForwardCap = gfParkourWallRun_Speed * mfPowerMul * gfParkourWallJump_ForwardSpeedMul;
		float fTransferCap = fLegacyMaxSpeed * gfParkourWallJump_TransferSpeedMul;
		float fSpeedCap = cMath_InterpolateLinear(fForwardCap, fTransferCap, fBlend);
		float fLaunchSpeed = cMath_Min(fSpeedCap, cMath_Max(fIncomingSpeed, vLaunch.Length()));
		if (vLaunch.SqrLength() > 0.001f) vLaunch.Normalize();
		vLaunch *= fLaunchSpeed;
		vLaunch.y = gfParkourWallJump_UpImpulse * mfPowerMul / fMass;
		pBody.StopMovement();
		pBody.SetMoveSpeed(eCharDir_Forward, 0.f);
		pBody.SetMoveSpeed(eCharDir_Right, 0.f);
		pBody.SetForceVelocity(vLaunch);
		if (Parkour_GetDebug())
			cLux_AddDebugMessage("[ParkourControl v2] wall jump look=" + vCamFwd +
				" outward=" + fOutDot + " blend=" + fBlend + " incoming=" + fIncomingSpeed +
				" launch=" + vLaunch + " cap=" + fSpeedCap + " dt=" + mfLastVelocityTimeStep +
				" flow=" + Parkour_GetFlow(), true);
		Parkour_NotifyFlowEvent(geParkourFlowEvent_WallJump, 1.f);
		Parkour_ArmWallJumpChain(mvWallNormal);
		cLux_PlayGuiSoundData("player/foley/default/pose_jump", eSoundEntryType_World, 0.75f, true);
		cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
	}
	
	//------------------------------------------------------------
	
	void EndWallRun(const tString &in asReason = "")
	{
		if (Parkour_GetDebug() && asReason != "")
			cLux_AddDebugMessage("[Parkour] Wall run ended: " + asReason, true);
		
		if (asReason == "timer expired")
		{
			Parkour_NotifyFlowEvent(geParkourFlowEvent_WallRunTimeout, 1.f);
		}
		else if (asReason == "forward released" ||
				 asReason == "lost wall" ||
				 asReason == "lost front wall" ||
				 asReason == "no wall hit" ||
				 asReason == "invalid wall normal")
		{
			Parkour_NotifyFlowEvent(geParkourFlowEvent_WallRunDropped, 1.f);
		}
		
		cLux_GetPlayer().ChangeMoveState(eMoveState_Normal);
	}
	
	//------------------------------------------------------------
	
	void UpdateCameraMotion(float afTimeStep, iCharacterBody@ apBody)
	{
		UpdateCameraBob(afTimeStep, apBody);
		UpdateCameraRoll(mfCameraBobRoll);
	}
	
	//------------------------------------------------------------
	
	void UpdateCameraBob(float afTimeStep, iCharacterBody@ apBody)
	{
		float fSpeed = Parkour_GetFlatVelocity(apBody, afTimeStep).Length();
		float fSpeedT = cMath_Clamp(fSpeed / cMath_Max(0.001f, gfParkourWallRun_Speed * mfPowerMul), 0.f, 1.35f);
		float fEntryT = cMath_Easing(eEasing_SineInOut, cMath_Clamp(mfTimer / gfParkourWallRun_CameraBobEntryTime, 0.f, 1.f));
		float fRideT = cMath_Clamp(mfTimer / gfParkourWallRun_MaxTime, 0.f, 1.f);
		float fAmount = fEntryT * (0.65f + 0.35f * fRideT) * cMath_Clamp(0.65f + 0.35f * fSpeedT, 0.f, 1.25f) * mfPowerMul;
		float fOrganicAmount = fEntryT * cMath_Clamp(0.55f + 0.45f * fSpeedT, 0.f, 1.15f) * mfPowerMul;
		
		mfCameraBobTimer += afTimeStep * gfParkourWallRun_CameraBobFrequency * cMath_Max(0.75f, fSpeedT);
		
		float fStep = cMath_Sin(mfCameraBobTimer);
		float fStepAbs = cMath_Abs(fStep);
		float fSide = cMath_Sin(mfCameraBobTimer * 0.5f + cMath_ToRad(45.f));
		float fOrganicTime = mfTimer * gfParkourWallRun_CameraOrganicFrequency;
		float fOrganicX = cMath_Clamp(cGenerate_GetNoisePerlin1D(mfCameraOrganicSeedX + fOrganicTime), -1.f, 1.f);
		float fOrganicY = cMath_Clamp(cGenerate_GetNoisePerlin1D(mfCameraOrganicSeedY + fOrganicTime * 1.17f), -1.f, 1.f);
		float fOrganicZ = cMath_Clamp(cGenerate_GetNoisePerlin1D(mfCameraOrganicSeedZ + fOrganicTime * 0.83f), -1.f, 1.f);
		float fOrganicRoll = cMath_Clamp(cGenerate_GetNoisePerlin1D(mfCameraOrganicSeedRoll + fOrganicTime * 1.31f), -1.f, 1.f);
		
		cVector3f vTargetOffset;
		vTargetOffset.x = fSide * gfParkourWallRun_CameraBobSide * fAmount * float(mlWallSide);
		vTargetOffset.y = ((fStepAbs * gfParkourWallRun_CameraBobVertical) - (gfParkourWallRun_CameraBobVertical * 0.5f)) * fAmount;
		vTargetOffset.z = -fStepAbs * gfParkourWallRun_CameraBobForward * fAmount;
		vTargetOffset.x += fOrganicX * gfParkourWallRun_CameraOrganicSide * fOrganicAmount;
		vTargetOffset.y += fOrganicY * gfParkourWallRun_CameraOrganicVertical * fOrganicAmount;
		vTargetOffset.z += fOrganicZ * gfParkourWallRun_CameraOrganicForward * fOrganicAmount;
		
		float fBlend = cMath_Clamp(afTimeStep * 14.f, 0.f, 1.f);
		mvCameraBobOffset = mvCameraBobOffset * (1.f - fBlend) + vTargetOffset * fBlend;
		mfCameraBobRoll = mfCameraBobRoll * (1.f - fBlend) + ((fSide * gfParkourWallRun_CameraBobRoll * fAmount * float(mlWallSide)) + (fOrganicRoll * gfParkourWallRun_CameraOrganicRoll * fOrganicAmount)) * fBlend;
		
		cLux_GetPlayer().SetCameraPosAdd(eCameraAddType_Script, mvCameraBobOffset);
	}
	
	//------------------------------------------------------------
	
	void UpdateCameraRoll(float afBobRoll)
	{
		float fRoll = -12.f * float(mlWallSide) + afBobRoll;
		cLux_GetPlayer().FadeCameraRollTo(ePlayerRoll_Script, cMath_ToRad(fRoll), 7.f, cMath_ToRad(140.f));
	}
	
	//------------------------------------------------------------
	
	
	float mfTimer = 0.f;
	float mfLostWallTimer = 0.f;
	[nosave] float mfLastVelocityTimeStep = gfParkourVelocityFallbackTimeStep;
	float mfForwardReleaseTimer = 0.f;
	float mfGroundTimer = 0.f;
	float mfPowerMul = 1.f;
	float mfOutwardLookYawOffset = 0.f;
	float mfOutwardLookTargetYawOffset = 0.f;
	float mfCameraBobTimer = 0.f;
	float mfCameraBobRoll = 0.f;
	float mfCameraOrganicSeedX = 0.f;
	float mfCameraOrganicSeedY = 0.f;
	float mfCameraOrganicSeedZ = 0.f;
	float mfCameraOrganicSeedRoll = 0.f;
	int mlWallSide = 0;
	bool mbOutwardLookLeanInputHeld = false;
	tString msLastWallRefreshFail = "";
	cVector3f mvWallNormal = cVector3f_Forward;
	cVector3f mvWallForward = cVector3f_Forward;
	cVector3f mvCameraBobOffset = cVector3f_Zero;

	[nosave] cSoundEntry@ mpWallRunSound;
	
	//------------------------------------------------------------
}

