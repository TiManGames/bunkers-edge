	float mfRunMeter = 0.f;
	float mfCarelessRunCount = 0.f;
	float mfLeanTurnTimer = -1.f;
	float mfLeanTurnStartYaw = 0.f;
	float mfWallRunLeanTurnSuppressTimer = -1.f;
	float mfParkourRunJumpGrace = -1.f;
	float mfParkourRunJumpCameraBumpTime = -1.f;
	float mfParkourRunJumpCameraBumpPower = 0.f;
	float mfParkourRunJumpCameraPitchAdd = 0.f;
	float mfParkourRollInputGrace = -1.f;
	float mfParkourJumpStartSpeed = 0.f;
	float mfParkourJumpCarrySpeed = 0.f;
	float mfParkourAirLockSideSpeed = 0.f;
	float mfParkourAirTime = 0.f;
	float mfParkourAirHighestFeetY = 0.f;
	float mfParkourAirLastFeetY = 0.f;
	cVector3f mvParkourJumpDir = cVector3f_Forward;
	cVector3f mvParkourAirLockRight = cVector3f_Right;
	int mlLeanTurnDir = 1;
	bool mbLeanTurning = false;
	bool mbLeanTurnAnalogHeld = false;
	bool mbParkourJumpAirControlActive = false;
	bool mbParkourAirborneMetricsActive = false;
	bool mbParkourAirLegalLanding = false;
	bool mbParkourPendingSideJump = false;
	bool mbParkourPendingSideJumpRun = false;
	int mlParkourPendingSideJumpDir = 0;
	tString msParkourAirLockSource = "";
	float mfParkourHardLandingPenaltyTime = 0.f;
	float mfParkourHardLandingPenaltyDuration = 0.f;
	float mfParkourHardLandingPenaltyMul = 1.f;
	float mfParkourLandRollTime = -1.f;
	float mfParkourLandRollStartPitch = 0.f;
	float mfParkourLandRollStartSpeed = 0.f;
	cVector3f mvParkourLandRollDir = cVector3f_Forward;
	bool mbParkourRollArmed = false;
	bool mbParkourRollFallDistancesActive = false;
	bool mbParkourLandRollActive = false;

	//------------------------------------------------------------
}

