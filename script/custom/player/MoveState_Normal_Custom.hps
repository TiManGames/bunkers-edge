	void _Global_GetParkourAirLockConsumesMoveInput()
	{
		cScript_SetGlobalReturnBool(ParkourAirLockConsumesMoveInput());
	}

	//------------------------------------------------------------

	void _Global_GetIsRunningCarelessly()
	{
		cScript_SetGlobalReturnBool(mfCarelessRunCount > 6.f);
	}

