	//------------------------------------------------------------
	
	bool CanUseGun()
	{
		iPhysicsWorld@ pPhysicsWorld = cLux_GetCurrentMap().GetPhysicsWorld();
		cCamera@ pCam = mBaseObj.mpPlayer.GetCamera();
		
		if (pCam is null) return false;
		if (pPhysicsWorld is null) return false;
		
		////////////////////
		// Only check if camera has moved since last
		cVector3f vCamAngles(pCam.GetPitch(), pCam.GetYaw(), pCam.GetRoll());
		cVector3f vPlayerPos = mBaseObj.mpPlayer.GetCharacterBody().GetPosition();
		
		bool bDoCheck = (vCamAngles - mvPrevCanUseGunCameraAngles).SqrLength() > 0.f ||
						(vPlayerPos - mvPrevCanUseGunPlayerPos).SqrLength() > 0.f;
		
		mvPrevCanUseGunCameraAngles = vCamAngles;
		mvPrevCanUseGunPlayerPos = vPlayerPos;
		
		if (bDoCheck == false)
		{
			return mbPrevCanUseGun;
		}
		
		cVector3f vPush;
		cVector3f vBoxOffset = cVector3f(0.f, -0.015f, -0.28f);
		cMatrixf mtxBox = cMath_MatrixMul(pCam.GetMatrix(), cMath_MatrixTranslate(vBoxOffset));
		mbPrevCanUseGun = pPhysicsWorld.CheckShapeWorldCollision(vPush, mpCollideShape, mtxBox, null, false, false, false, false) == false;
		
		return mbPrevCanUseGun;
	}
	
