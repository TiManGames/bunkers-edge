	bool GetShootAnimActive()
	{
		cAnimationState@ pShootAnim = PlayerBody_GetAnimationState(msActivePlayerShootAnim);
		return pShootAnim !is null && pShootAnim.IsActive() && pShootAnim.IsOver() == false;
	}
	
