	//------------------------------------------------------------
	
	int UpdateStateAnims(const tString &in asAnimR, const tString &in asAnimL, bool abLoop, float afFadeTime, 
						 bool abLeftArmReturnToIdle, bool abUseCustomEndCondition = false, bool abCustomEndCondition = false)
	{
		////////////////
		// Setup vars		
		cAnimationState@ pPlayerAnimR = PlayerBody_GetAnimationState(asAnimR);
		cAnimationState@ pPlayerAnimL = PlayerBody_GetAnimationState(asAnimL);	
				
		////////////////
		// Play anims
		bool bStateOK = mLanternEquipState == eGunLanternEquipState_None || 
						mlAnimState == eUsingItemAnimState_Outro || 
						mlAnimState == eUsingItemAnimState_Intro;
		
		bool bAnimStarted = pPlayerAnimR !is null && pPlayerAnimR.IsActive() == false;
		bool bAnimOver = pPlayerAnimR !is null && pPlayerAnimR.IsActive() && pPlayerAnimR.IsOver();
		
		if (GetShootAnimActive() == false && bStateOK)
		{
			if (pPlayerAnimR !is null && pPlayerAnimR.IsActive() == false)
			{
				PlayerBody_PlayAnimation(asAnimR, ePlayerBodyAnimationLayer_RightArm, abLoop, false, false, afFadeTime);
			}
			
			if (pPlayerAnimL !is null && pPlayerAnimL.IsActive() == false)
			{
				PlayerBody_PlayAnimation(asAnimL, ePlayerBodyAnimationLayer_LeftArm, abLoop, false, abLeftArmReturnToIdle, afFadeTime);
			}
		}
				
		////////////////
		// Return
		int lRet = 0;
		if (abUseCustomEndCondition && abCustomEndCondition)
		{
			lRet = -1;
		}
		else if (bAnimStarted)
		{
			lRet = 1;
		}
		else if (bAnimOver)
		{
			lRet = -1;
		}
			
		return lRet;
	}
	
	//------------------------------------------------------------
	
	bool UpdateLanternStateAnims(const tString &in asAnimL, const tString &in asAnimR)
	{
		cAnimationState@ pAnimL = PlayerBody_GetAnimationState(asAnimL);
		cAnimationState@ pAnimR = PlayerBody_GetAnimationState(asAnimR);
		
		if (pAnimL !is null && pAnimL.IsActive() == false)
		{
			PlayerBody_PlayAnimation(asAnimL, ePlayerBodyAnimationLayer_LeftArm, false, false, false, 0.1f);
		}
		
		if (pAnimR !is null && pAnimR.IsActive() == false && mlAnimState != eUsingItemAnimState_Intro)
		{
			PlayerBody_PlayAnimation(asAnimR, ePlayerBodyAnimationLayer_RightArm, false, false, false, 0.1f);
		}
		
		return pAnimL !is null && pAnimL.IsOver();
	}
	
	//------------------------------------------------------------
	
	void GetStateAnims(eUsingItemAnimState aState, tString &out asAnimR, tString &out asAnimL)
	{
		if (aState == eUsingItemAnimState_Intro)
		{
			if (mAimMode == eGunAimMode_OneHand)
			{
				asAnimL = "";
				asAnimR = msAimIntroAnim;
			}
			else
			{
				asAnimL = msAimDualIntroLAnim;
				asAnimR = msAimDualIntroRAnim;
			}
		}
		else if (aState == eUsingItemAnimState_Loop)
		{
			if (mAimMode == eGunAimMode_OneHand)
			{
				asAnimL = "";
				asAnimR = msAimLoopAnim;
			}
			else
			{
				asAnimL = msAimDualLoopLAnim;
				asAnimR = msAimDualLoopRAnim;
			}
		}
		else if (aState == eUsingItemAnimState_Outro)
		{
			if (mAimMode == eGunAimMode_OneHand)
			{
				asAnimL = "";
				asAnimR = msAimOutroAnim;
			}
			else
			{
				asAnimL = msAimDualOutroLAnim;
				asAnimR = msAimDualOutroRAnim;
			}
		}
				
		////////////////
		// Don't override lantern anims
		if (mLanternEquipState != eGunLanternEquipState_None && aState != eUsingItemAnimState_Outro)
		{
			asAnimL = "";
		}
	}
	
