	//------------------------------------------------------------

	[volatile] array<cPickupGui@> mvPickupGui;
	[nosave] int mlPickupGuiIDSuffix=0; 
	[volatile] cPickupGui@ mTakeOutGui;
	[volatile] cPickupGui@ mHoverGui;
	
	//------------------------------------------------------------

	void StartPickUpGuiAnimation(const tString &in asIcon, const tString&in asItemType, float afDelay=0.f)
	{
		////////////////////////
		// Create new pickup gui
		cPickupGui@ pPickupGui = cPickupGui("PickupGui_"+mlPickupGuiIDSuffix, asIcon, asItemType);
		if (pPickupGui==null) return;
		
		mlPickupGuiIDSuffix++;
		pPickupGui.AddToTime(afDelay);
		
		int lIdx = mvPickupGui.size();
		if(mHoverGui!is null)
			lIdx += 1;

		pPickupGui.mvGoalDest = GetPickupGuiDestPos(lIdx);
		mvPickupGui.push_back(pPickupGui);
	}
	
	//------------------------------------------------------------
	
	cVector3f GetPickupGuiDestPos(const int alElementCount)
	{
		////////////////////////////
		// Set pickup gui pos offset
		cVector3f vPickupGuiDestPos = gvItemHandlerGuiPos;
			
		if (mfItemCounterDisplayTimer>0)
			vPickupGuiDestPos.x -= gfItemHandlerGuiSizeX;
			
		iScrSketchbookUIHandler_Interface @pSketchbookHandler = cast<iScrSketchbookUIHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_SketchbookUIHandler) );
		if (pSketchbookHandler !is null && pSketchbookHandler.GetNotifyNewNote())
			vPickupGuiDestPos.x -= gfItemHandlerGuiSizeX;
		
		vPickupGuiDestPos.x = vPickupGuiDestPos.x - (gfItemHandlerGuiSizeX * alElementCount);
		return vPickupGuiDestPos;
	}
	
	//------------------------------------------------------------
	
	bool GetIsPickupGuiAnimating()
	{
		if (mTakeOutGui==null) return false;
		return mTakeOutGui.IsAnimating();
	}

	bool GetIsHoverGuiAnimating()
	{
		if (mHoverGui==null) return false;
		return mHoverGui.IsAnimating() && mHoverGui.mbLockerItem==false;
	}
	
	//------------------------------------------------------------
	
	void OnGui(float afTimeStep)
	{
		if (cLux_GetFootageModeActive()) return;
		
		/////////////////////
		// Setup
		cVector3f vPos(cLux_GetHudVirtualOffset() * -1.f);	
		cVector2f vSize(ImGui_GetSize());
		
		ImGui_GroupBegin(vPos, vSize);
		
			//////////////////
			// Pickup Item gui
			int lHoverOffset = 0;
			for (int i=0; i<mvPickupGui.size(); ++i)
			{
				cPickupGui@ pPickupGui = mvPickupGui[i];
				if (pPickupGui==null) continue;
				
				const float fInterpSpeed = 0.1f;

				int lIdx = i;
				if(mHoverGui !is null)
				{
					lIdx +=1;
					if(pPickupGui.msItemType == mHoverGui.msItemType)
						lIdx = 0 + lHoverOffset++;
				}

				pPickupGui.mvGoalDest.x = cMath_InterpolateLinear(pPickupGui.mvGoalDest.x, GetPickupGuiDestPos(lIdx).x, (1/fInterpSpeed) * afTimeStep);
				
				pPickupGui.OnPickupGui(afTimeStep);
				
				if (pPickupGui.IsAnimating()==false)
				{
					mvPickupGui.removeAt(i);
					@pPickupGui = null;
				}
			}
			
			////////////////////
			// Take out item gui
			if (mTakeOutGui!=null)
			{
				mTakeOutGui.OnPickupGui(afTimeStep);
				if (mTakeOutGui.IsAnimating()==false)
					@mTakeOutGui = null;
			}
			
			////////////////////
			// Hover item gui
			if (mHoverGui!=null)
			{
				mHoverGui.OnPickupGui(afTimeStep);
				if (mHoverGui.IsAnimating()==false)
					@mHoverGui = null;
			}
			
			///////////////
			// Right bottom screen counters
			DoCounterGui(afTimeStep);
		
		ImGui_GroupEnd();
	}
	
	//------------------------------------------------------------
	
	void DoCounterGui(float afTimeStep)
	{
		/////////////////////
		// Match equip gui
		if (mfItemCounterDisplayTimer > 0.0f)
		{
			////////////////
			// Fade In & Out
			if (mfItemCounterDisplayTimer >= gfItemCounterFadeOutTime)
			{
				mfItemCounterDisplayAlpha += (1/gfItemCounterFadeInTime)*afTimeStep;
				if (mfItemCounterDisplayAlpha > 1.0f) mfItemCounterDisplayAlpha = 1.0f;
			}
			else
			{
				mfItemCounterDisplayAlpha -= (1/gfItemCounterFadeOutTime)*afTimeStep;
				if (mfItemCounterDisplayAlpha < 0.0f) mfItemCounterDisplayAlpha = 0.0f;
			}
			
			//////////////////////
			// flash item counter
			float fImageBrightnessMul = 1.0f;
			if (mfItemCounterDisplay_FlashTimer > 0)
			{
				mfItemCounterDisplay_FlashTimer -= afTimeStep * 2.0f;
				if (mfItemCounterDisplay_FlashTimer <= 0)
				{
					--mlItemCounterDisplay_FlashCount;
					if (mlItemCounterDisplay_FlashCount > 0)
						mfItemCounterDisplay_FlashTimer = 1.0f;
				}
				
				float fAddBrightness = -0.5f;
				if (mfItemCounterDisplay_FlashTimer > 0.5)
					fImageBrightnessMul = 1.0f + fAddBrightness * (1.0f - ((mfItemCounterDisplay_FlashTimer - 0.5f) / 0.5f));
				else
					fImageBrightnessMul = 1.0f + fAddBrightness * (mfItemCounterDisplay_FlashTimer / 0.5f);
			}
				
			mfItemCounterDisplayTimer -= afTimeStep;
			
			////////////////////
			// Do counter img 
			cVector3f vIconPos = gvItemHandlerGuiPos;
			vIconPos = ImGui_NrmPosGroup(vIconPos);
			cImGuiGfx gfxImage = cImGuiGfx(msItemCountDisplay_ImageColor, eImGuiGfx_Texture);
			if (mbItemCounterGreyscale) gfxImage.mMaterial = eGuiMaterial_GreyscaleAlpha;
			
			ImGui_DoImageCorrectAspect(gfxImage, vIconPos, ImGui_NrmSizeGroupKeepRatio(0.083));
			
			///////////////////
			// Do counter label
			cImGuiLabelData labelData;
			labelData.mColorBase = cColor(1.0f, mfItemCounterDisplayAlpha) * fImageBrightnessMul;
			labelData.mFontAlign = eFontAlign_Center;
			labelData.mFont.mvSize = cVector2f(18);
			labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 56));
			cVector3f vTextPos = vIconPos + ImGui_NrmPosGroup(0.042f,0.074f,0.6f);
			
			cVector2f vHalfSize = ImGui_NrmSizeGroup(0.1,0.02f);
			vTextPos.y-=vHalfSize.y;
			vTextPos.x-=vHalfSize.x;
			vTextPos.z+=0.1f;
			
			ImGui_SetTransCategory("");
			
			/////////////////
			// Regular items
			tWString sStack = cResources_Translate("InventoryUI", "Stack");
			tWString sOut = cString_ReplaceStringToW(sStack, tWString("%n"), cString_ToStringW(mlItemCounterDisplayCount,0));
			
			cLux_GetCurrentImGui().DoLabel(sOut, labelData, vTextPos, cVector2f(vHalfSize.x*2.0f,-1.0f), 1.0f);
			
			/////////////////////
			// Do label shadow
			labelData.mColorBase = cColor(0.f, mfItemCounterDisplayAlpha) * fImageBrightnessMul;
			cLux_GetCurrentImGui().DoLabel(sOut, labelData, vTextPos+cVector3f(1.0f,1.0f,-1.0f), cVector2f(vHalfSize.x*2.0f,-1.0f), 1.0f);
			
			ImGui_ResetModifiers();
		}
	}
	
