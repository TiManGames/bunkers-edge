	void RemoveTempRTUItem(const tString&in asHolsterAnim)
	{
		if (m_idTempRTUItem == tID_Invalid) return;
		
		msTempRTUItemRemovalAnim = asHolsterAnim;
	}

	//------------------------------------------------------------
	
	void KillTempRTUItem()
	{
		if (m_idTempRTUItem == tID_Invalid) return;
		
		iLuxEntity@ pTempEnt = cLux_ID_Entity(m_idTempRTUItem);
		if (pTempEnt !is null)
			cLux_GetCurrentMap().DestroyEntity(pTempEnt);
			
		msTempRTUItemRemovalAnim = "";
		m_idTempRTUItem = tID_Invalid;
		msTempRTUItemID = "";
	}

	//------------------------------------------------------------
	
	tString GetTempRTUItemEntity()
	{
		iLuxEntity@ pEnt = m_idTempRTUItem == tID_Invalid ? null : cLux_ID_Entity(m_idTempRTUItem);
		
		return pEnt is null ? "" : pEnt.GetName();
	}

