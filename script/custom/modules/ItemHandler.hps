	//------------------------------------------------------------
	
	tString PickUpEntity(const tString& in asEntityName, bool abMakeHeld=false, bool abThenPutAway=true, bool abDestroyEntityOnPickup=true)
	{
		iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntityName);
		if (pEntity is null)
		{
			Error("[ItemHandler] Trying to pick up unknown entity "+asEntityName);
			return "";
		}
		
		tString sItemType = GetEntityItemType(asEntityName);
		
		if (sItemType=="")
		{
			Error("[ItemHandler] Trying to pick up an entity "+asEntityName+" which has no specified item type.");
			return "";
		}
				
		mbPickingUp = true;
		
		if (pEntity.IsActive()==false)
			cLux_AddDebugMessage("[ItemHandler] Picking up inactive entity "+asEntityName+" - is this right?");
		
		cLux_AddDebugMessage("[ItemHandler] Picked up entity:"+asEntityName);
		
		tString sID = mPlayerInventory.AddItem(sItemType);
		iScrItem@ pItem = mPlayerInventory.FindByID(sID);
		
		CopyEntityToItemData(asEntityName, pItem);
		
		mCallbacks.OnPickUp(sItemType, pItem, asEntityName);			
		pEntity.SetEffectsActive(false, false);
		
		if (abDestroyEntityOnPickup)
			cLux_GetCurrentMap().DestroyEntity(pEntity);
		else
			pEntity.SetActive(false);
		
		///////////////////////
		// Draw pickup item Gui
		if (sItemType == "Matchbook")
		{
			int lContentLevel = (GetEntityItemContentLevel(asEntityName) <= 0) ? 1 : GetEntityItemContentLevel(asEntityName);
			for (int i = 1; i <= lContentLevel; i++)
			{
				float fDelay = i/8.0f;
				StartPickUpGuiAnimation(pItem.GetPickupIcon(), pItem.GetTypeID(), fDelay);
			}
		}
		else
		{
			StartPickUpGuiAnimation(pItem.GetPickupIcon(), pItem.GetTypeID());
		}

		/////////////
		// Equip Item
		if (abMakeHeld)
			TakeOut(sID, abThenPutAway);
		else
			mbPickingUp=false;
			
		return sID;
	}
	
	//------------------------------------------------------------
	
	tString DropAsEntity(const tString& in sItemID)
	{
		cLux_AddDebugMessage("[ItemHandler] Dropping Item: " + sItemID);
		
		cMatrixf matTransform = cLux_GetPlayer().GetCamera().GetMatrix();
		cVector3f vDirection = cLux_GetPlayer().GetCamera().GetForward()-cLux_GetPlayer().GetCamera().GetUp()*0.5f;
		cVector3f vTranslate = matTransform.GetTranslation();
		
		/////////////////////
		// Check whether there's a wall ahead
		bool bWallAhead = cLux_CheckLineOfSight(vTranslate,  vTranslate+vDirection*0.5f,  false,  false, null);
		cVector3f vTransOffset = bWallAhead ? vDirection * 0.5f : cLux_GetPlayer().GetCamera().GetUp() * -0.25f;
		vTranslate += vTransOffset;
		matTransform.SetTranslation(vTranslate);
		
		/////////////////////
		// If the item is held copy its rotation.
		eItemHandlerHand hand = GetHandHoldingItem(sItemID);
		if (hand != eItemHandlerHand_LastEnum)
		{
			iLuxEntity@ pHeld = cLux_GetCurrentMap().GetEntityByName(mHands[hand].msHeldEntity);
			if (pHeld !is null && pHeld.GetMainBody() !is null)
			{
				cMatrixf matItem = pHeld.GetMainBody().GetWorldMatrix().GetRotation();
				matTransform.SetRotation(matItem);
			}
		}
		
		///////////////////////////
		// Spawn an entity in the world and remove the inventory item
		tString sEntityName = SpawnAsEntity(sItemID, matTransform, sItemID + "_drop", 1.f, eItemSpawn_World, eItemSpawnType_Drop);
		
		iScrItem@ pItem = GetItemByID(sItemID, eInventoryInstance_Player);
		const tString sType = (pItem is null) ? "" : pItem.GetType().GetID();
		mCallbacks.OnDrop(sType, sEntityName);
		
		////////////////////////////////////
		// Hack so that burned out torches can't be picked up again.
		bool bIsBurnedTorch = sType=="Torch" && Torch_GetIsBurned();
		
		RemoveFromInventory(eInventoryInstance_Player, sItemID);
		
		///////////////////////
		// Define the entity in the world
		iLuxEntity@ pEntity = Map_GetEntity(sEntityName);
		if (pEntity is null)
		{
			Error("[ItemHandler] Can't drop Item: " + sEntityName + " because it's null!");
			return "";
		}
		
		pEntity.SetInteractionDisabled(bIsBurnedTorch);
		
		pEntity.SetIsInteractedWith(false);
		pEntity.SetScriptableIsSaved(true);
		
		Prop_SetAllowMapTransfer(sEntityName, true);
		
		///////////////////
		// Wake its body up
		cCamera @pCam = cLux_GetPlayer().GetCamera();
		iPhysicsBody@ pBody = pEntity.GetMainBody();
		pBody.SetLinearVelocity(cVector3f_Zero);
		pBody.SetAngularVelocity(cVector3f_Zero);
		pBody.AddImpulse(pCam.GetForward() * 0.05f);
		Prop_DisableCollisionUntilOutsidePlayer(sEntityName);
		Entity_WakeUp(sEntityName);
		
		return sEntityName;
	}
	
	//------------------------------------------------------------
	
	tString SpawnAsEntity(const tString& in asItemID, const cMatrixf& in aTransform, const tString& in asName="", float afScale=1.0f, eItemSpawn aSpawn=eItemSpawn_World, eItemSpawnType aSpawnType=eItemSpawnType_Default)
	{
		cItemEntry@ pItem = mPlayerInventory.FindByID(asItemID);
		if (pItem is null)
		{
			Error("[ItemHandler] Can't find item of ID:"+asItemID+" to spawn.");
			return "";
		}
		
		tString sEntityName = SpawnTypeAsEntity(pItem.msType, aTransform, asName, afScale, aSpawn, aSpawnType);
		
		///////////////////
		// Copy props across
		CopyItemDataToEntity(pItem, sEntityName);

		return sEntityName;
	}

	//------------------------------------------------------------
	
	tString SpawnTypeAsEntity(const tString& in asType, const cMatrixf& in aTransform, const tString& in asName="", float afScale=1.0f, eItemSpawn aSpawn=eItemSpawn_World, eItemSpawnType aSpawnType=eItemSpawnType_Default)
	{
		iScrItemType@ pType = FindType(asType);
		if (pType is null)
		{
			Error("[ItemHandler] Invalid item type!? "+asType);
			return "";
		}
		
		tString sEntityFile="";
		if (aSpawnType == eItemSpawnType_Default)
			sEntityFile = pType.GetHandEntityFile();
		else if (aSpawnType == eItemSpawnType_Accessory)
			sEntityFile = pType.GetAccessoryEntityFile();
		else if (aSpawnType == eItemSpawnType_Drop)
			sEntityFile = pType.GetDropEntityFile();
		
		if (sEntityFile=="")
		{
			Error("[ItemHandler] Can't spawn item of type '"+asType+"' as there's no Spawn EntityFile set in Inventory.cfg");
			return "";
		}
		
		cLux_AddDebugMessage("[ItemHandler] Spawning "+sEntityFile + ", Name: " + asName);
		iLuxEntity@ pEntity;
		tString sEntityName = asName;
		if (sEntityName=="")
		{
			sEntityName=asType+"_Spawn_"+mlLastSpawnedItemID;
			mlLastSpawnedItemID++;
		}
		
		if (Entity_Exists(sEntityName))
			Entity_Destroy(sEntityName);
		
		float fScale = afScale;
		if (fScale == 1.f)
		{
			if (aSpawnType==eItemSpawnType_Accessory)
				fScale = pType.GetAccessoryEntityScale();
			else
				fScale = pType.GetEntityScale();
		}
				
		cLux_GetCurrentMap().CreateEntity(sEntityName, sEntityFile, aTransform, cVector3f(fScale));
		@pEntity = cLux_GetCurrentMap().GetLatestEntity();
		
		if (pEntity is null || pEntity.GetName() != sEntityName)
		{
			Error("[ItemHandler] Something went wrong creating entity:"+sEntityName);
			return "";
		}
		
		pEntity.SetActive(true);
		pEntity.WakeUp();
		pEntity.SetScriptableIsSaved(true);
		pEntity.SetSaveDataIsUpdated(true);
		pEntity.SetFullGameSave(false);
		
		SetEntityItemType(sEntityName, asType);
		//SetEntityHealth(sEntityName, 1.f);
		
		////////////
		// Init props
		if (pType.IsContainer())
			SetEntityContent(sEntityName, pType.GetContainerContentType(), pType.GenerateInitAmount());
		
		return pEntity.GetName();
	}
	
	//------------------------------------------------------------
	
	iScrItemType@ FindType(const tString& in asType)
	{
		cXmlElement@ pElem = FindTypeElem(asType);
		if (pElem is null) return null;
		return cItemType(pElem);
	}
	
	//------------------------------------------------------------
	// Content types
	//------------------------------------------------------------
	// TODO: Remove if no loner needed.
	void GetContentTypes(array<tString>& out avContentTypes)
	{
		avContentTypes.resize(0);
		cXmlNodeListIterator @it = mContentTypes.GetChildIterator();
		while(it.HasNext())
		{
			cXmlElement @pTypeElem = it.Next().ToElement();
			tString sID = pTypeElem.GetAttributeString("ID","");
			if (sID=="")
				continue;
			avContentTypes.push_back(sID);
		}
	}
	
