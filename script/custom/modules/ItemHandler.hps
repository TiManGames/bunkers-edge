	void SetFocusOutroAnimation(const tString&in asAnim)
	{
		msFocusOutroAnim = asAnim;
	}
	
	//------------------------------------------------------------
	
	tString GetFocusOutroAnimation()
	{
		return msFocusOutroAnim;
	}
	
	//------------------------------------------------------------
	
	void SetItemMeshVisible(eItemHandlerHand aHand)
	{
		mHands[aHand].mbSetVisible = true;
	}
	
	//------------------------------------------------------------
	
	void UpdateHeldItems(float afTimeStep)
	{
		//////////////////
		// Toggle delay
		if (mfToggleItemDelay > 0)
			mfToggleItemDelay-=afTimeStep;
		
		//////////////////////////
		// Player in custom state?
		int lState = cLux_GetPlayer().GetCurrentStateId();
		bool bPlayerInItemUseState = Player_GetIsInUsingItemState();									
		bool bPlayerInCustomState = bPlayerInItemUseState ||
									lState == ePlayerState_InteractiveCameraAnimation ||
									lState == ePlayerState_CutsceneAnimation ||
									lState == ePlayerState_InteractiveCutsceneAnimation ||
									lState == ePlayerState_ZoomArea;
		
		//////////////////////////////
		// Skip certain hand, or both?
		int lSkipHandInCustomState = -1;
		bool bSetItemStateToHeld = true;
		
		// Little hack to make equipping/unequipping lantern work when aiming with the gun
		if ((lState == ePlayerState_Custom_UsingGun_Aim ||
			 lState == ePlayerState_Custom_UsingVolleyGun_Aim) &&
			mHands[eItemHandlerHand_Left].mHeldItemState == eHeldItemState_TakingOut)
		{
			iScrItem@ pLeftHandItem = GetItemByID(mHands[eItemHandlerHand_Left].msHeldItem);
			bSetItemStateToHeld = pLeftHandItem is null ||
								  pLeftHandItem.GetTypeID() != "DynamoLantern";
			
			if (bSetItemStateToHeld == false)
				lSkipHandInCustomState = eItemHandlerHand_Right;
		}
		
		/////////////////////////
		// Update held item state
		for (int i = 0; i < eItemHandlerHand_LastEnum; i++)
		{
			eItemHandlerHand hand = eItemHandlerHand(i);
			
			if (mHands[hand].mHeldItemState == eHeldItemState_None)
				continue;
			
			//////////////
			// Update shadow casting
			iLuxEntity@ pHeld = cLux_GetCurrentMap().GetEntityByName(mHands[hand].msHeldEntity);
			if(pHeld !is null)
			{
				cMeshEntity@ pMeshEnt = pHeld.GetMeshEntity();
				if(pMeshEnt !is null)
					pMeshEnt.SetRenderFlagBit(eRenderableFlag_ShadowCaster, mbBodyShadowsActive);
				
				if (mHands[hand].mbSetVisible)
				{
					pMeshEnt.SetVisible(true);
					mHands[hand].mbSetVisible = false;
				}
			}

			bool bSkip = bPlayerInCustomState && 
						 (lSkipHandInCustomState == -1 || hand == eItemHandlerHand(lSkipHandInCustomState));

			//////////////////
			// slight hack to keep the Taking Out state from messing up the RTU outro animation
			if (bSetItemStateToHeld && 
				bPlayerInItemUseState && 
				mHands[hand].mHeldItemState == eHeldItemState_TakingOut)
			{
				mHands[hand].mHeldItemState = eHeldItemState_Held;
			}
			
			switch (mHands[hand].mHeldItemState)
			{
				///////////////////////////
				// Taking out
				case eHeldItemState_TakingOut:
				{
					if (bSkip) 
						break;
					
					bool bAnimPlaying = false;
					
					if (ShouldPlayHandEquipAnimation(hand))
					{
						/////////////////
						// Play arm anims
						tString sAnim = GetHandAnimation(mHands[hand].msHeldItem, "draw", hand);
						cAnimationState @pState = PlayerBody_GetAnimationState(sAnim);
						bAnimPlaying = (pState !is null && pState.IsOver()==false);
					}
					
					if (bAnimPlaying==false)
					{
						if (mHands[hand].mbHeldItemPutAway)
						{
							mHands[hand].mbHeldItemPutAway = false;
							if (Player_IsThrowing())
							{
								Hands_SwitchToHeld(hand);
							}
							else
							{
								Hands_SwitchToPuttingAway(hand);
							}
						}
						else
						{
							if (ShouldPlayInspectAnimation(hand))
							{
								mfInspectItemTime = 5.0f;
							}
							mbPickingUp = false;
							Hands_SwitchToHeld(hand);
						}
					}
					break;
				}
				
				/////////////////////
				// Putting away
				case eHeldItemState_PuttingAway:
				{
					bool bAnimPlaying = false;
										
					if (ShouldPlayHandEquipAnimation(hand))
					{
						tString sAnim = GetHandAnimation(mHands[hand].msHeldItem, "holster", hand);
						cAnimationState @pState = PlayerBody_GetAnimationState(sAnim);
						bAnimPlaying = (pState !is null && pState.IsOver()==false);
					}
						
					if (bAnimPlaying==false)
					{
						if (mHands[hand].msHeldItem!="")
						{
							iScrItem@ pItem = GetItemByID(mHands[hand].msHeldItem);
							if (pItem!=null)
							{
								mCallbacks.OnPutAway(pItem.GetTypeID(), pItem, mHands[hand].msHeldEntity);
								
								cLuxMap@ pMap = cLux_GetCurrentMap();
								tString sMethod = "void OnPutAwayItem(const tString &in asItemType, const tString &in asItemID)";
								if (pMap.ScriptMethodExists(sMethod) && pMap.ScriptPrepare(sMethod))
								{
									tString sTypeID = pItem.GetType().GetID();
									tString sItemID = pItem.GetID();
									pMap.SetArgString(0, sTypeID);
									pMap.SetArgString(1, sItemID);
									pMap.ScriptExecute();
								}
							}							
						}
						
						mbPickingUp = false;
						Hands_SwitchToNone(hand);
						
						if (mHands[hand].msHeldItemNext!="")
						{
							TakeOut(mHands[hand].msHeldItemNext, mHands[hand].mbHeldItemNextPutAway);
							mHands[hand].msHeldItemNext="";
							mHands[hand].mbHeldItemNextPutAway = false;
						}
					}
					break;
				}
				
				//////////////////////////////
				// Held
				case eHeldItemState_Held:
				{						
					if (bSkip)
						break;						
					if (ShouldPlayHandEquipAnimation(hand)==false)
						break;
					
					tString sAnim = msFocusOutroAnim != "" ? msFocusOutroAnim : GetHandAnimation(mHands[hand].msHeldItem, "idle", hand);
					cAnimationState @pState = PlayerBody_GetAnimationState(sAnim);
					bool bAnimPlaying = (pState !is null && pState.IsOver()==false);
					
					if (bAnimPlaying == false)
					{
						msFocusOutroAnim = "";
						Hands_SwitchToHeld(hand);
						
						eItemHandlerHand otherHand = hand == eItemHandlerHand_Left ? eItemHandlerHand_Right : eItemHandlerHand_Left;
						if (mHands[otherHand].mHeldItemState == eHeldItemState_None)
						{
							PlayerBody_SetArmAnimationPitch(false, otherHand == eItemHandlerHand_Right, otherHand == eItemHandlerHand_Left);
						}
					}
						
					if (ShouldPlayInspectAnimation(hand))
					{
						mfInspectItemTime -= afTimeStep;
						if (mfInspectItemTime <= 0)
						{
							Hands_SwitchToPuttingAway(hand);
						}
					}
					break;
				}
			}
		}
		
		if (msTempRTUItemRemovalAnim != "")
		{
			cAnimationState @pState = PlayerBody_GetAnimationState(msTempRTUItemRemovalAnim);
			if (pState is null || pState.IsOver())
			{
				iLuxEntity@ pTempEnt = cLux_ID_Entity(m_idTempRTUItem);
				if (pTempEnt !is null)
					cLux_GetCurrentMap().DestroyEntity(pTempEnt);
					
				msTempRTUItemRemovalAnim = "";
				m_idTempRTUItem = tID_Invalid;
				msTempRTUItemID = "";
			}
		}
	}
	
	//------------------------------------------------------------
	
	bool ShouldPlayInspectAnimation(eItemHandlerHand aHand)
	{
		iScrItem@ pItem = GetItemByID(mHands[aHand].msHeldItem);
		if (pItem==null)
			return false;
		return (pItem.GetType().GetUsesInspectAnimation());
	}
	
	//------------------------------------------------------------
	
	bool ShouldPlayHandEquipAnimation(eItemHandlerHand aHand)
	{
		iScrItem@ pItem = GetItemByID(mHands[aHand].msHeldItem);
		if (pItem==null)
			return false;
		return pItem.GetType().GetUsesArmAnimation();
	}
	
	//------------------------------------------------------------
	
	void LoadConfig(const tString& in asXMLFile)
	{
		@mInventoryDoc = cResources_LoadXmlDocument(asXMLFile);
		if (mInventoryDoc is null)
		{
			Error("[ItemHandler] Couldn't load inventory config!");
			return;
		}
		@mItemTypes = mInventoryDoc.GetFirstElement("ItemTypes");
		@mContentTypes = mInventoryDoc.GetFirstElement("ContentTypes");
		@mStartup = mInventoryDoc.GetFirstElement("Startup");
	}
	
	//------------------------------------------------------------
	
	cXmlElement@ FindTypeElem(const tString& in asType)
	{
		cXmlNodeListIterator @it = mItemTypes.GetChildIterator();
		while(it.HasNext())
		{
			cXmlElement @pTypeElem = it.Next().ToElement();
			if (pTypeElem.GetAttributeString("ID","")==asType)
				return pTypeElem;
		}
		return null;
	}
	
	//------------------------------------------------------------
	
	void PreloadItemTypes()
	{
		cItemType type;
		cXmlNodeListIterator @it = mItemTypes.GetChildIterator();
		while(it.HasNext())
		{
			cXmlElement @pTypeElem = it.Next().ToElement();
			type.SetXML(pTypeElem);
			
			tString sEntityFile = type.GetHandEntityFile();
			if (sEntityFile!="")
			{
				Entity_Preload(sEntityFile);
			}
			
			tString sDropEntityFile = type.GetDropEntityFile();
			if (sDropEntityFile!="" && sDropEntityFile!=sEntityFile)
			{
				Entity_Preload(sDropEntityFile);
			}
			
			tString sAccessoryEntityFile = type.GetAccessoryEntityFile();
			if (sAccessoryEntityFile!="")
			{
				Entity_Preload(sAccessoryEntityFile);
			}
		}
	}
	
	//------------------------------------------------------------
	
	void UpdateInventoryIcons(eInventoryInstance aInstance)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return;
		
		//////////////////////////////////////
		// Update icon to use for each item
		cItemEntry@ pItem = null;
		for (int i  = 0; i < pInst.mvInventory.size(); i++)
		{
			@pItem = pInst.mvInventory[i];
			pItem.SetUseAltInventoryIcon(pItem.GetUseAltInventoryIcon(), false);
		}
	}
	
	//------------------------------------------------------------
	
	void SetupAccessoryItems()
	{
		/////////////////////
		// Setup vars
		cLuxMap@ pMap = cLux_GetCurrentMap();
		
		for (uint i = 0; i < mPlayerInventory.mvInventory.size(); ++i)
		{
			cItemEntry@ pItem = mPlayerInventory.mvInventory[i];
			tString sSocket = pItem.GetType().GetAccessorySocket();
			
			/////////////////////
			// Create the item
			if (sSocket != "")
			{
				tString sEnt = SpawnAsEntity(pItem.GetID(), cMatrixf_Identity, pItem.GetID() + "_Accessory", 1.f, eItemSpawn_World, eItemSpawnType_Accessory);
				cLuxProp@ pProp = cLux_ToProp(pMap.GetEntityByName(sEnt, eLuxEntityType_Prop));
				
				if (pProp is null)
					continue;
				
				Entity_SetCollide(sEnt, false);
				Entity_SetCollideCharacter(sEnt, false);
				Prop_ClearVelocity(sEnt);
				pProp.SetRenderLayer(glArmsRenderLayer);
				pProp.SetStaticPhysics(true);
				pProp.SetInteractionDisabled(true);
				pProp.SetActive(true);
				
				cMeshEntity@ pMeshEnt = pProp.GetMeshEntity();
				if (pMeshEnt !is null) pMeshEnt.SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);

				PlayerBody_AttachProp(sEnt, sSocket);
				
				/////////////////////
				// Copy over data from internal item
				CopyItemEntityInfo(pItem.GetInternalEntity(), sEnt);
			}
		}
	}
	
	//------------------------------------------------------------
	
	tString GetAccessoryEntityByID(const tString &in asItemID)
	{
		tString sEnt = "";
		for (int i = 0; i < mPlayerInventory.mvInventory.size(); ++i)
		{
			cItemEntry@ pItem = mPlayerInventory.mvInventory[i];
			tString sID = pItem.GetID();
			
			if (pItem.GetType().IsAccessory() == false || 
				GetHeldItem(pItem.GetType().GetEquipHand()) == sID)
				continue;
			
			if (sID == asItemID)
			{
				tString sEntityName = pItem.GetID() + "_Accessory";
				if (Entity_Exists(sEntityName))		sEnt = sEntityName;
				else								sEnt = pItem.GetInternalEntity();
				break;
			}
		}
		
		return sEnt;
	}
	
	//------------------------------------------------------------
	
	void ShowBulletCount(const tString &in asBulletType, bool abEmpty, bool abRemainOnScreen = true)
	{
		mlItemCounterDisplayCount = GetTypeCountInInventory(eInventoryInstance_Player, asBulletType);
		mfItemCounterDisplayTimer = abRemainOnScreen ? gfItemCounterDisplayTime : gfItemCounterFadeOutTime;
		mbItemCounterGreyscale = abEmpty;
		
		msItemCountDisplay_ImageColor = asBulletType == "Ammunition" ? "inventory_item_bullet" : "inventory_item_cell";
	}
	
	//------------------------------------------------------------
	
	void ShowFuelCount(bool abEmpty, bool abRemainOnScreen = true)
	{		
		int lFuelCanisterCount = GetTypeCountInInventory(eInventoryInstance_Player, "Fuel");
		int lFuelBotttleCount = GetTypeCountInInventory(eInventoryInstance_Player, "FuelBottle");
		
		bool bShowFuelBottleCount = lFuelBotttleCount > 0 && lFuelCanisterCount <= 0;
		
		int lFuelCount = bShowFuelBottleCount ? lFuelBotttleCount : lFuelCanisterCount;
		mlItemCounterDisplayCount = lFuelCount;
		
		mfItemCounterDisplayTimer = abRemainOnScreen ? gfItemCounterDisplayTime : gfItemCounterFadeOutTime;
		mbItemCounterGreyscale = abEmpty;
		
		msItemCountDisplay_ImageColor = bShowFuelBottleCount ? "inventory_item_fuel_bottle" : "inventory_item_fuel";
	}
	
	//------------------------------------------------------------
	
	void ShowBottleCount(bool abEmpty, bool abRemainOnScreen = true)
	{		
		mlItemCounterDisplayCount = GetTypeCountInInventory(eInventoryInstance_Player, "EmptyBottle");
		mfItemCounterDisplayTimer = abRemainOnScreen ? gfItemCounterDisplayTime : gfItemCounterFadeOutTime;
		mbItemCounterGreyscale = abEmpty;
		
		msItemCountDisplay_ImageColor = "inventory_item_bottle";
	}
	
	//------------------------------------------------------------
	
	void FlashItemCount(int alFlashCount = 1)
	{
		if (mfItemCounterDisplayTimer <= 0)
			return;
			
		mfItemCounterDisplayTimer = gfItemCounterDisplayTime;
		mfItemCounterDisplay_FlashTimer = 1.0f;
		mlItemCounterDisplay_FlashCount = alFlashCount;
	}
	
	//------------------------------------------------------------
	
	void GiveAllItems()
	{
		cXmlNodeListIterator @it = mItemTypes.GetChildIterator();
		while(it.HasNext())
		{
			cXmlElement @pTypeElem = it.Next().ToElement();
			tString sType = pTypeElem.GetAttributeString("ID","");
			mPlayerInventory.AddItem(sType);
		}
	}
	
