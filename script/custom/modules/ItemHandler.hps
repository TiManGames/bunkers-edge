enum eHeldItemState
{
	eHeldItemState_None = 0,
	eHeldItemState_TakingOut = 1,
	eHeldItemState_PuttingAway = 2,
	eHeldItemState_Held = 3,
}

//----------------------------------------------------------------------------------------

const float gfToggleItemTimeMin=0.5f;

const float gfItemCounterDisplayTime = 4.0f;
const float gfItemCounterFadeInTime = 0.3f;
const float gfItemCounterFadeOutTime = 1.0f;

const cVector3f gvItemHandlerGuiPos = cVector3f(0.87,0.825,3);

const float gfItemHandlerGuiSizeX = 0.052;

//----------------------------------------------------------------------------------------

class cItemType : iScrItemType
{
	cXmlElement@ mXML;
	cXmlElement@ mInventoryXML;
	cXmlElement@ mBulkXML;
	cXmlElement@ mUseXML;
	cXmlElement@ mHandsXML;
	int mlAmountMax = 1;
	
	cItemType()
	{
		
	}
	
	cItemType(cXmlElement@ aXML)
	{
		SetXML(aXML);
	}
	
	tString GetInventoryIcon()
	{
		if (mInventoryXML is null)
			return "";
		return mInventoryXML.GetAttributeString("Icon","");
	}
	
	tString GetAltInventoryIcon()
	{
		if (mInventoryXML is null)
			return "";
		return mInventoryXML.GetAttributeString("AltIcon","");
	}
	
	tString GetPickupIcon()
	{
		if (mInventoryXML is null)
			return "";
		return mInventoryXML.GetAttributeString("PickupIcon","");
	}
	
	bool CanDrop()
	{
		if (mInventoryXML is null) return false;
		return mInventoryXML.GetAttributeBool("CanDrop", false);
	}
	
	bool GetHidden()
	{
		if (mInventoryXML is null) return false;
		return mInventoryXML.GetAttributeBool("Hidden", false);
	}
	
	bool GetIsWeapon()
	{
		if (mInventoryXML is null) return false;
		return mInventoryXML.GetAttributeBool("IsWeapon", false);
	}

	bool GetUsesArmAnimation()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("UsesArmAnimation",false);
	}
	
	bool GetUsesInspectAnimation()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("UsesInspectAnimation",false);
	}
	
	tString GetEntityInspectAnimation()
	{
		if (mHandsXML is null)
			return "";
		return mHandsXML.GetAttributeString("EntityInspectAnimation","");
	}
	
	tString GetPlayerInspectAnimation()
	{
		if (mHandsXML is null)
			return "";
		return mHandsXML.GetAttributeString("PlayerInspectAnimation","");
	}
	
	bool GetUseArmAnimationYaw()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("UseArmAnimationYaw",true);
	}
	
	bool GetUseArmAnimationPitch()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("UseArmAnimationPitch",true);
	}

	bool IsLeftHand()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("LeftHand",false);
	}
	
	eItemHandlerHand GetEquipHand()
	{
		if (mHandsXML is null)
			return eItemHandlerHand_Right;
			
		return IsLeftHand()?eItemHandlerHand_Left:eItemHandlerHand_Right;
	}
	
	tString GetHandEntityFile()
	{
		if (mHandsXML is null)
			return "";		
		return mHandsXML.GetAttributeString("EntityFile","");
	}
	
	tString GetDropEntityFile()
	{
		if (mHandsXML is null) return "";
		
		const tString sEnt = mHandsXML.GetAttributeString("DropEntityFile","");
		if (sEnt=="")
			return mHandsXML.GetAttributeString("EntityFile","");
			
		return sEnt;
	}
	
	tString GetAccessoryEntityFile()
	{
		if (mHandsXML is null)
			return "";		
		return mHandsXML.GetAttributeString("AccessoryEntityFile","");
	}
	
	bool IsAccessory()
	{
		if (mHandsXML is null)
			return false;
		return (mHandsXML.GetAttributeString("AccessoryEntityFile","") != "");
	}
	
	tString GetAccessorySocket()
	{
		if (mHandsXML is null)
			return "";
		return mHandsXML.GetAttributeString("AccessorySocket","");
	}
	
	float GetAccessoryEntityScale()
	{
		if (mHandsXML is null)
			return 1.f;
		return mHandsXML.GetAttributeFloat("AccessoryEntityScale",1.f);
	}
	
	bool UseParentBoneRotation()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("UseParentBoneRotation", false);
	}

	bool IsLightSource()
	{
		if (mHandsXML is null)
			return false;
		return mHandsXML.GetAttributeBool("LightSource",false);	
	}
	
	float GetEntityScale()
	{
		if (mHandsXML is null)
			return 1.f;
		return mHandsXML.GetAttributeFloat("EntityScale",1.f);	
	}
	
	float GetEquipToggleDelay()
	{
		if (mHandsXML is null)
			return gfToggleItemTimeMin;
		return mHandsXML.GetAttributeFloat("EquipToggleDelay",gfToggleItemTimeMin);	
	}
	
	float GetUnequipToggleDelay()
	{
		if (mHandsXML is null)
			return gfToggleItemTimeMin;
		return mHandsXML.GetAttributeFloat("UnequipToggleDelay",gfToggleItemTimeMin);	
	}
	
	tString GetNameID()
	{
		return mXML.GetAttributeString("NameID",GetID());
	}
	
	tString GetDescID()
	{
		return mXML.GetAttributeString("DescID",GetNameID()+"_Desc");
	}
	
	tString GetAltDescID()
	{
		return mXML.GetAttributeString("AltDescID",GetNameID()+"_AltDesc");
	}
	
	tString GetID()
	{
		return mXML.GetAttributeString("ID","");
	}
	
	void SetXML(cXmlElement@ aXML)
	{
		@mXML = aXML;
		@mInventoryXML = mXML.GetFirstElement("Inventory");
		@mBulkXML = mXML.GetFirstElement("Bulk");
		@mUseXML = mXML.GetFirstElement("Use");
		@mHandsXML = mXML.GetFirstElement("Hands");
		
		if (mBulkXML is null)
		{
			mlAmountMax = 1;
		}
		else
		{
			mlAmountMax = mBulkXML.GetAttributeInt("MaxAmount",1);
			
			//////////////////////////////////
			// Containers can have zero amount.
			if (IsContainer()==false && mlAmountMax==0)
			{
				Error("[ItemHandler] Item type '"+GetID()+"' can't have an amount of 0!");
				return;
			}
		}
	}
	
	bool CanCombine()
	{
		if (AllowsStacking())
			return true;
		
		tString sCombine = mXML.GetAttributeString("Combine","");
		if (sCombine=="") return false;
		
		return true;
	}
	
	bool PrioritizeCombineOverStacking()
	{
		return mXML.GetAttributeString("Combine","") != "" && GetAmountMax() > 1;
	}
	
	tString GetCombineType()
	{
		return mXML.GetAttributeString("Combine","");
	}
	
	bool CanCombineWith(iScrItemType@ apOtherType)
	{ 
        /////////////
        // Stacks
		if (AllowsStacking())
		{
			if (apOtherType.GetID() == GetID())
				return true;
				
			return false;
		}
        
		tString sCombine = GetCombineType();
		if (sCombine == "")
			return false;
		
		////////////////////////////////
		// Get all items this can be combined with
		array<tString> sItems;
		cString_GetStringVec(sCombine, sItems, ", ");
		for (int i=0; i<sItems.size(); ++i)
		{
			//cLux_AddDebugMessage("Item: " + sItems[i]);
			if (sItems[i]==apOtherType.GetID())
				return true;
		}
		
		return false;
	}
	
	int GetAmountMax()
	{
		if (mBulkXML is null)
			return 1;
		return mlAmountMax;
	}
	
	bool AllowsStacking()
	{
		if (mBulkXML is null)
			return false;
		return ((mlAmountMax==-1)||(mlAmountMax>1));
	}
	
	bool IsContainer()
	{
		if (mBulkXML is null)
			return false;
		return mBulkXML.GetAttributeBool("Container", false);
	}
	
	tString GetContainerContentType()
	{
		if (mBulkXML is null)
			return "";
		return mBulkXML.GetAttributeString("ContentType","");
	}
	
	int GenerateInitAmount()
	{
		if (mBulkXML is null)
			return 1;
		cVector2f vRange = mBulkXML.GetAttributeVector2f("InitAmountRange", cVector2f_One);
		int lOut = cMath_RandRectl(int(vRange.x), int(vRange.y));
		return lOut;		
	}
	
	bool CanUseOnSelf()
	{
		if (mUseXML is null)
			return false;
		return mUseXML.GetAttributeBool("OnSelf",false);
	}
	
	bool CanUseOnWorld()
	{
		if (mUseXML is null)
			return false;
		return mUseXML.GetAttributeBool("OnWorld",false);
	}
	
	tString GetRequiredToUseItemType()
	{
		if (mUseXML is null) return "";
		return mUseXML.GetAttributeString("RequiredToUseItem","");
	}
	
	tString GetCanUseOnSelfMapCallback()
	{
		if (mUseXML is null)
			return "";
		return mUseXML.GetAttributeString("CanUseOnSelfMapCallback",""); 
	}
	
	tString GetCanUseOnWorldMapCallback()
	{
		if (mUseXML is null)
			return "";
		return mUseXML.GetAttributeString("CanUseOnWorldMapCallback","");
	}
	
	tString GetUseOnSelfMapCallback()
	{
		if (mUseXML is null)
			return "";
		return mUseXML.GetAttributeString("UseOnSelfMapCallback","");
	}
	
	tString GetUseOnWorldMapCallback()
	{
		if (mUseXML is null)
			return "";
		return mUseXML.GetAttributeString("UseOnWorldMapCallback","");
	}

	bool GetUseCanMove()
	{
		if (mUseXML is null)
			return false;
		return mUseXML.GetAttributeBool("CanMove",false);
	}
	
	int GetUsingState()
	{
		if (mUseXML is null)
			return -1;
			
		return mUseXML.GetAttributeInt("UsingState", -1);
	}
}

//----------------------------------------------------------------------------------------

class cItemEntry : iScrItem
{
	tString msID;
	tString msType;
	tString msContentType;
	tString msInventoryIcon;
	tString msPickupIcon;
	tString msInventoryParentName;
	int mlInventoryParentID;
	int mlAmount=1;
	int mlPreviousAmount=0;
	bool mbDisableUseOnSelf = false;
	bool mbUseAltInventoryIcon = false;
	bool mbHidden = false;
	bool mbPlayUnequipAnim = true;
	tString msInternalEntity = "";
	tString msAnimationName = "";
	[volatile] iScrItemType@ mType = null;
	float mfhealth;
	bool mbIsWeapon;
	
	cItemEntry()
	{
		msID="";
		msType="";
		mlAmount=1;
		mlPreviousAmount=0;
		msContentType="";
		mbDisableUseOnSelf = false;
		msInventoryIcon = "";
		mbUseAltInventoryIcon = false;
		mbHidden = false;
		mbPlayUnequipAnim = true;
		mfhealth = 1.f;
		mbIsWeapon = false;
		msInventoryParentName = "";
		mlInventoryParentID = -1;
	}
	
	cItemEntry(const tString& in asID, const tString& in asType)
	{
		msID = asID;
		msType = asType;
		mlAmount = 1;
		mlPreviousAmount=0;
		mbDisableUseOnSelf = false;
		mbUseAltInventoryIcon = false;
		mfhealth = 1.f;
		mbPlayUnequipAnim = true;
		msInventoryParentName = "";
		mlInventoryParentID = -1;
		
		////////////////
		//Init From Type
		iScrItemType@ pType = GetType();
		
		if (pType !is null)
		{
			mlAmount = pType.GenerateInitAmount();
			msInventoryIcon = pType.GetInventoryIcon();
			msPickupIcon = pType.GetPickupIcon();
			msContentType = pType.GetContainerContentType();
			mbHidden = pType.GetHidden();
			mbIsWeapon = pType.GetIsWeapon();
		}
		
	}

	tString GetID()		{return msID;}
	tString GetTypeID()	{return msType;}
	
	tString GetInventoryParentName()
	{
		return msInventoryParentName;
	}
	
	int GetInventoryParentID()
	{
		return mlInventoryParentID;
	}
	
	iScrItemType@ GetType()
	{
		if (mType is null)
		{
			iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
			@mType = pHandler.FindType(msType);
			if (mType is null)
			{
				Error("[ItemHandler] Can't find item type:"+msType+"!");
				return null;
			}
		}
		return mType;
	}
	
	float GetHealth()
	{
		return mfhealth;
	}
	
	void SetHealth(float afX)
	{
		mfhealth = afX;
	}
	
	const tString& GetCrossHairGfx()
	{
		return msInventoryIcon;
	}
	
	int GetMaxAmount()
	{
		return GetType().GetAmountMax();
	}
	
	bool IsAmountMaxed()
	{
		int lMax = GetType().GetAmountMax();
		if (lMax==-1) //Infinite
			return false;
		return (mlAmount>=lMax);
	}
	
	int GetAmount()
	{
		return mlAmount;
	}
	
	int GetPreviousAmount()
	{
		return mlPreviousAmount;
	}
	
	void SetAmount(int alAmount)
	{
		mlPreviousAmount = mlAmount;
		
		int lMax = GetType().GetAmountMax();
		
		///////////
		// Infinite
		if (lMax < 0)
		{
			mlAmount = alAmount;
			return;
		}
		
		/////////////
		// Set amount
		if (alAmount > lMax)
			Error("[ItemHandler] Trying to set the amount for item:'"+GetID()+"' to "+alAmount+" beyond max of "+lMax);
		
		const int lMin = 1;
		if (alAmount < lMin)
            Error("[ItemHandler] Trying to set the amount for item:'"+GetID()+"' to "+alAmount+" which is below 1");
			
		mlAmount = cMath_Clamp(alAmount, lMin, lMax);
		
		/////////////////////////////////////////
		// Pass the value to the item held if any
		iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
		for (int i = 0; i < int(eItemHandlerHand_LastEnum); i++)
		{
			eItemHandlerHand hand = eItemHandlerHand(i);
			if ((pHandler.GetHeldItem(hand)==GetID()) && (pHandler.GetHeldEntity(hand)!=""))
				pHandler.CopyItemDataToEntity(this, pHandler.GetHeldEntity(hand));
		}
	}
	
	bool CanCombine()
	{
		if (GetType().CanCombine()==false)
			return false;
		
		return true;
	}
	
	bool CanCombineWith(iScrItem@ apOtherItem)
	{
		if (GetID() == apOtherItem.GetID())
			return false;
		if (GetType().CanCombineWith(apOtherItem.GetType())==false)
			return false;
			
		if (GetType().AllowsStacking())
		{
			if (apOtherItem.IsAmountMaxed()) return false;
								
			//////////////
			// Containers
			if (GetType().IsContainer())
			{
				if (apOtherItem.IsContainer()==false ||
					apOtherItem.GetContentType()!=GetContentType() ||
					GetAmount()==0)
				{
					return false;
				}
			}
			else if (apOtherItem.GetTypeID() != msType)
			{
				return false;
			}
		}
		
		return true;
	}
	
	bool IsContainer()
	{
		return GetType().IsContainer();
	}
	
	float GetFullness()
	{
		return float(mlAmount)/float(GetType().GetAmountMax());
	}
	
	void SetFullness(float afFullness)
	{
		mlAmount = int(afFullness*GetType().GetAmountMax());
	}
	
	tString GetContentType()
	{
		return msContentType;
	}
	
	void SetContentType(const tString& in asContentType)
	{
		msContentType = asContentType;
	}

	//TODO: Remove if no longer needed
	bool CanAddSubType(const tString& in asType, const tString& in asSubType)
	{
		if (!IsContainer())
			return false;

		// Same subtype? Go for it!
		if (msContentType == asSubType)
			return true;

		// Does the top-level type match?
		if (GetType().GetContainerContentType()!=asType)
			return false;

		// Is it empty?
		if (GetAmount()>0)
			return false;

		return true;
	}
	
	void SetDisableUseOnSelf(bool abX)
	{
		mbDisableUseOnSelf = abX;
		
		/////////////////////////////////////////
		// Pass the value to the item held if any.
		iScrItemHandler_Interface @pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
		for (int i = 0; i < int(eItemHandlerHand_LastEnum); i++)
		{
			eItemHandlerHand hand = eItemHandlerHand(i);
			if ((pHandler.GetHeldItem(hand)==GetID()) && (pHandler.GetHeldEntity(hand)!=""))
			{
				pHandler.CopyItemDataToEntity(this, pHandler.GetHeldEntity(hand));
			}
		}
	}
	
	bool GetUseOnSelfDisabled()
	{
		return mbDisableUseOnSelf;
	}
	
	tString GetInternalEntity()
	{
		if (msInternalEntity == "" || Entity_Exists(msInternalEntity) == false)
		{
			iScrItemHandler_Interface@ pHandler = cast<iScrItemHandler_Interface>( cLux_GetUserModuleFromID(eModuleType_Custom_ItemHandler) );
			
			msInternalEntity = pHandler.SpawnTypeAsEntity(GetTypeID(), cMatrixf_Identity, msID + "_Internal");
			if (msInternalEntity != "")
				Entity_SetActive(msInternalEntity,false);
				
			iLuxEntity@ pEntity = Map_GetEntity(msInternalEntity);
			if (pEntity !is null)
				pEntity.SetIsInteractedWith(true);
		}
		
		return msInternalEntity;
	}
	
	tString GetActiveInventoryIcon()
	{
		return msInventoryIcon;
	}
	
	tString GetPickupIcon()
	{
		return msPickupIcon == "" ? GetActiveInventoryIcon() : msPickupIcon;
	}
	
	bool GetUseAltInventoryIcon()
	{
		return mbUseAltInventoryIcon;
	}
	
	void SetUseAltInventoryIcon(bool abX, bool abWhenSketchbookClosed = true)
	{
		mbUseAltInventoryIcon = abX;
		
		if (abWhenSketchbookClosed == false || Sketchbook_IsOpen() == false)
			msInventoryIcon = abX ? GetType().GetAltInventoryIcon() : GetType().GetInventoryIcon();
	}
	
	void SetHidden(bool abX)
	{
		mbHidden = abX;
	}
	
	bool GetHidden()
	{
		return mbHidden;
	}
	
	bool GetIsWeapon()
	{
		return mbIsWeapon;
	}
	
	void SetPlayUnequipAnim(bool abX)
	{
		mbPlayUnequipAnim = abX;
	}
	
	bool GetPlayUnequipAnim()
	{
		return mbPlayUnequipAnim;
	}
	
	void DestroyInternalEntity()
	{
		if (msInternalEntity!="")
		{
			Entity_Destroy(msInternalEntity);
			msInternalEntity="";
		}
	}
	
	void Destroy()
	{
		DestroyInternalEntity();
	}
}

//----------------------------------------------------------------------------------------

class cScrItemHandlerHand
{
	tString msHeldItem = "";
	tString msHeldItemLast = "";
	tString msHeldEntity = "";
	tString msHeldItemNext = "";
	bool mbHeldItemPutAway = false;
	bool mbHeldItemNextPutAway = false;
	eHeldItemState mHeldItemState = eHeldItemState_None;
	tString msUseItem="";
	tString msUseEntity="";
	tString msUseTarget="";
	float mfUseTime;
	bool mbSetVisible = false;
}

//----------------------------------------------------------------------------------------

class cPickupGui
{
	tString msID;
	tString msIconFile;
	cVector3f mvGoalDest;
	float mfIconSmallSize;
	float mfIconLargeSize;
	bool mbShouldAnimate;
	float mfAnimationTime;
	float mfFadeInTime;
	float mfFadeOutTime;
	float mfTimePassed;
	float mfAlpha;
	float mfSize;
	cVector3f mvPos;
	bool mbShouldFadeOut;
	bool mbReversed;
	tString msLabel;
	tString msItemType;
	bool mbGreyscale;
	bool mbLockerItem;
	
	cPickupGui(const tString&in asID, const tString&in asIconFile, const tString&in asItemType,const bool abReversed=false, const tString&in asLabel="")
	{
		msID = asID;
		msIconFile = asIconFile!="" ? asIconFile : "_temp_inventory_item";
		
		mfIconSmallSize = 0.083f;
		mfIconLargeSize = abReversed ? 0.12f : 0.15f;
		
		mbReversed = abReversed;
		const cVector3f vScreenCenter = cVector3f(0.5, 0.5, gvItemHandlerGuiPos.z);
		mvPos = abReversed ? gvItemHandlerGuiPos : vScreenCenter;
		mvGoalDest = abReversed ? vScreenCenter : gvItemHandlerGuiPos;
		mfSize = abReversed ? mfIconSmallSize : mfIconLargeSize;
		
		mfAnimationTime = abReversed ? 0.5f : 1.f;
		mfFadeInTime = 0.1f;
		mfFadeOutTime = abReversed? 0.25f : 0.5f;
		mfTimePassed = 0.f;
		mfAlpha = 0.f;
		
		mbShouldFadeOut = false;

		msLabel = asLabel;
		msItemType = asItemType;
		mbGreyscale = false;
		mbLockerItem = false;
		mbShouldAnimate = true;
	}
	
	void AddToTime(const float afDelay)
	{
		mfAnimationTime+=afDelay;
		mfFadeInTime+=afDelay;
		mfFadeOutTime+=afDelay;
		//mfTimePassed+=afDelay;
	}
	
	bool IsAnimating()
	{
		float fTotalTime = mfAnimationTime;
		if (mbReversed==false) fTotalTime += mfFadeOutTime;
		return mfTimePassed < fTotalTime;
	}
	
	void OnPickupGui(float afTimeStep)
	{
		mfTimePassed += afTimeStep;
		
		////////////////////
		// Animate position
		if (mbShouldAnimate)
		{
			mvPos.x = cMath_InterpolateLinear(mvPos.x, mvGoalDest.x, (1/mfAnimationTime) * afTimeStep * 5.f);
			mvPos.y = cMath_InterpolateLinear(mvPos.y, mvGoalDest.y, (1/mfAnimationTime) * afTimeStep * 5.f);
		}
		

		//////////////////
		// Fade In & Scale
		if (mbShouldFadeOut==false)
		{
			///////////
			// Fade in
			if(mfFadeInTime > 0.f)
			{
				const float fAlphaFadeStep = (1.f / mfFadeInTime) * afTimeStep;
				mfAlpha = cMath_Min(mfAlpha + fAlphaFadeStep, 1.f);
			}
			else
				mfAlpha = 1.f;
			
			///////////
			// Scale?
			if (mbShouldAnimate)
			{
				float fGoalSize = mbReversed ? mfIconLargeSize : mfIconSmallSize;
				float fSizeStep = (1/mfAnimationTime) * afTimeStep * 5.f;
				if (mbReversed)
					fSizeStep *= 0.5f;
				mfSize = cMath_InterpolateLinear(mfSize, fGoalSize, fSizeStep);
			}

			if (mfTimePassed >= mfAnimationTime)
				mbShouldFadeOut = true;
		}
		///////////
		// Fade Out
		else
		{
			if(mfFadeOutTime > 0.f)
			{
				const float fAlphaFadeStep = (1.f / mfFadeOutTime) * afTimeStep;
				mfAlpha = cMath_Max(mfAlpha - fAlphaFadeStep, 0.f);
			}
			else
				mfAlpha = 0.f;
		}
		
		//////////////////
		// Draw pickup img
		if (mbReversed && Item_IsHeld(eItemHandlerHand_Right)==false) return;
		
		cImGuiGfx GuiIcon_bg("inventory_item_background", eImGuiGfx_Texture);
		cImGuiGfx GuiIcon(msIconFile, eImGuiGfx_Texture);
		GuiIcon_bg.mColor = GuiIcon.mColor = mbReversed ? cColor(0.4, 0.4, 0.4, mfAlpha) : cColor(1.0, 1.0, 1.0, mfAlpha);
		
		if(mbGreyscale)
			GuiIcon.mMaterial = eGuiMaterial_GreyscaleAlpha;

		eImGuiAlign eCurrAlignment = mbReversed || mbLockerItem ? eImGuiAlign_CenterCenter : eImGuiAlign_TopLeft;
		ImGui_SetAlignment(eCurrAlignment);
		
		ImGui_DoImageCorrectAspect(GuiIcon_bg, ImGui_NrmPosGroup(cVector3f(mvPos.x,mvPos.y, mvPos.z - 0.01)), ImGui_NrmSizeGroupKeepRatio(mfSize));
		ImGui_DoImageCorrectAspect(GuiIcon, ImGui_NrmPosGroup(mvPos), ImGui_NrmSizeGroupKeepRatio(mfSize));
		
		if(msLabel != "")
		{
			cImGuiLabelData label;
			label.mColorBase = mbReversed ? cColor(0.4, 0.4, 0.4, mfAlpha) : cColor(1.0, 1.0, 1.0, mfAlpha);
			//label.mFont.mvSize = cVector2f(gfFontSize_SketchbookItemLabel);
			label.mFont.SetFile(FontHandler_GetFont(eFontType_Sketchbook,56));
			label.mFontAlign = eFontAlign_Center;
			//ImGui_DoLabelExt(pItem.GetType().GetNameID(), label, ImGui_NrmPosGroup(0.0,0.535,gfSketchbookTextDepth), ImGui_NrmSizeGroup(0.205,-1.0f));

			
			ImGui_SetTransCategory("Inventory");
			label.mFontAlign = eFontAlign_Center;
			ImGui_DoLabelExt(msLabel, label, ImGui_NrmPosGroup(cVector3f(mvPos.x, mvPos.y + (mfSize / 2.0) + 0.01f, 0)), ImGui_NrmSizeGroupKeepRatio(mfSize));
			
			ImGui_SetTransCategory("");
		}

		ImGui_SetAlignment(eImGuiAlign_TopLeft);
	}
}

//----------------------------------------------------------------------------------------

class cInventory
{
	//--------------------------
	
	cInventory() {};
	
	//--------------------------
	
	tString msInventoryName;
	int mlInventoryID = -1;
	int mlSlotsMinLimit;
	int mlSlotsMaxLimit;
	int mlCurrentSlotsCount; 
	array<cItemEntry> mvInventory;
	int mlLastItemID;
	cScrItemCallbacks mCallbacks;
	
	//--------------------------
	
	void ClearInventory()
	{
		mvInventory.resize(0);
	}
	
	//--------------------------
	
	int GetItemCount(bool abIgnoreHidden=false)
	{
		if (abIgnoreHidden)
		{
			int lCount = 0;
			
			for(int i=0; i<mvInventory.size(); i++)
			{
				cItemEntry@ pItem = mvInventory[i];
				if (pItem is null || pItem.GetHidden())
					continue;
					
				lCount++;
			}
			
			return lCount;
		}
		
		return mvInventory.size();
	}
	
	//--------------------------
	
	int GetCurrentSlotsCount()
	{
		return mlCurrentSlotsCount;
	}
	
	//--------------------------
	
	void DestroyInternalEntities()
	{
		for (int i=mvInventory.size()-1; i>=0; --i)
		{
			mvInventory[i].DestroyInternalEntity();
		}
	}
	
	//--------------------------
	
	void SetCurrentSlotsCount(int alValue)
	{
		if (alValue < mlSlotsMinLimit || alValue > mlSlotsMaxLimit)
			AddInventoryErrorMsg("[ItemHandler] Inventory slots count must be a number between " + mlSlotsMinLimit + " and " +  mlSlotsMaxLimit + "!");
		
		mlCurrentSlotsCount = cMath_Clamp(alValue, mlSlotsMinLimit, mlSlotsMaxLimit);
	}
	
	//--------------------------
	
	void SetMaxSlotsCount(int alValue)
	{
		mlSlotsMaxLimit = alValue;
	}
	
	//--------------------------
	
	void SetMinSlotsCount(int alValue)
	{
		mlSlotsMinLimit = alValue;
	}
	
	//--------------------------
	
	tString GetNewID(const tString& in asType)
	{
		return mlInventoryID + "_" + asType + "_" + mlLastItemID;
	}
	
	//--------------------------
	
	tString AddItem(const tString& in asType)
	{
		AddInventoryDebugMsg("Adding item of type: " + asType);
		
		tString sID = GetNewID(asType);
		
		cItemEntry@ pItem = cItemEntry(sID, asType);
		if (pItem is null)
		{
			AddInventoryErrorMsg("Something went wrong. The item " + sID + "added in " + msInventoryName + " is null.");
			return "";
		}
		
		pItem.msInventoryParentName = msInventoryName;
		pItem.mlInventoryParentID = mlInventoryID;
		
		iScrItemType@ pType = pItem.GetType();
		if (pType is null)
		{
			AddInventoryErrorMsg("Unknown item type:'"+asType+"'");
			return "";
		}
		
		if (GetWillItemTypeFit(asType, true)==false)
			return "";
		
		mlLastItemID++;
		mvInventory.push_back(pItem);
		
		//////////////////////
		// If the item to add allows stacking look for the same item in the inventory and add this to the stack instead. 
		if (pType.AllowsStacking())
		{
			for (int i=0; i < mvInventory.size(); i++)
			{
				if (mvInventory[i].msID == sID) continue; //Can't combine with self
				if (mvInventory[i].msType != asType) continue;
				
				if (StackItems(pItem, mvInventory[i]))
					sID = mvInventory[i].msID;
			}
		}
		
		AddInventoryDebugMsg("Item added ID: " + sID);
		return sID;
	}
	
	//--------------------------
	
	bool GetWillItemTypeFit(const tString& in asType, bool abIgnoreHidden=false)
	{
		tString sID = GetNewID(asType);
		cItemEntry@ pItem = cItemEntry(sID,asType);
		if (pItem is null)
			return false;
			
		if (pItem.GetHidden())
			return true;
		
		iScrItemType@ pType = pItem.GetType();
		if (pType is null)
		{
			AddInventoryErrorMsg("Unknown item type:'"+asType+"'");
			return false;
		}
		
		//////////////////////
		// Is it a pocket bag?
		if (asType == "PocketBag")
			return true;
		
		/////////////////////
		// Check how many items we have
		int lItemCount = GetItemCount(abIgnoreHidden);
		
		////////////////////////////////////////
		// Inventory is empty, save calculations
		if (lItemCount<=0)
			return true;
		
		//////////////
		// Stackables
		if (pType.AllowsStacking())
		{
			for (int i=0; i<lItemCount; i++)
			{
				if (mvInventory[i].msType != asType)
					continue;
				if (mvInventory[i].IsAmountMaxed()==false)
					return true;
			}
		}
		
		////////////////////////
		// Is the inventory full
		if (lItemCount < mlCurrentSlotsCount)
			return true;
		
		AddInventoryErrorMsg("Didn't add item type '"+asType+"' - it wouldn't fit.");
		
		return false;
	}
	
	//--------------------------
	
	bool StackItems(iScrItem@ apItemA, iScrItem@ apItemB)
	{
		//////////////////////////////
		// Define the items to combine
		if (apItemA is null)
		{
			AddInventoryErrorMsg("Can't find item A for stacking.");
			return false;
		}
        
		if (apItemB is null)
		{
			AddInventoryErrorMsg("Can't find B item for stacking.");
			return false;
		}
		
		////////////
		// Stackable
		if(apItemA.GetType().AllowsStacking() && apItemB.GetType().AllowsStacking())// && apItemA.GetType().PrioritizeCombineOverStacking()==false)
		{
			///////////////////////////////
			// Cancel if of different types
			if (apItemA.GetTypeID() != apItemB.GetTypeID())
				return false;
						
			///////////////////////////
            // Cancel if item B is Full
            if (apItemB.IsAmountMaxed())
			{
				AddInventoryDebugMsg("Item "+apItemB.GetID()+" is full, can't add any more to it.");
				return false;
			}
			
			///////////////////
			// Infinite Amount
			if (apItemB.GetType().GetAmountMax()==-1)
			{
				apItemB.SetAmount(apItemB.GetAmount() + apItemA.GetAmount());
				RemoveItem(apItemA.GetID(), true);
				Sound_PlayGui("special_fx/notepad/notebook_item_combine", 1);
				return true;
			}
			
			//////////
			// Combine
			int lNumInB = apItemB.GetAmount();
			int lBMax = apItemB.GetType().GetAmountMax();
			int lNumInA = apItemA.GetAmount();
			int lFreeSpaceInB = lBMax - lNumInB;
			int lNumAdding = cMath_Min(lFreeSpaceInB, lNumInA);
			apItemB.SetAmount(lNumInB + lNumAdding);
			
			//////////////////////////
			// Handle remaining amount
			const int lRemainder = lNumInA - lNumAdding;
			if (lRemainder <= 0)
				RemoveItem(apItemA.GetID(), true);
			else
				apItemA.SetAmount(lRemainder);
			
			Sound_PlayGui("special_fx/notepad/notebook_item_combine", 1);
			return true;
		}
		
		return false;
	}
	
	//--------------------------
	
	void RemoveItem(const tString& in asItemID, bool abWholeBulk=false)
	{
		for (int i=0; i<mvInventory.size(); ++i)
		{
			if (mvInventory[i].msID==asItemID)
			{
				/////////////////////////////////
				// Remove a single item per stack
				if (abWholeBulk==false)
				{
					const int lCurrent = mvInventory[i].GetAmount();
					const int lGoal = lCurrent - 1;
					
					if (lGoal > 0)
					{
						mvInventory[i].SetAmount(lGoal);
						AddInventoryDebugMsg(asItemID + " removed from inventory.");
						return;
					}
				}
				
				//////////////
				// Remove item
				mvInventory[i].Destroy();
				tString sType = mvInventory[i].msType;
				mvInventory.removeAt(i);
				
				AddInventoryDebugMsg(asItemID + " removed as from inventory.");
			}
		}
	}
	
	//--------------------------
	
	iScrItem@ GetByID(const tString& in asItemID)
	{
		for (int i=mvInventory.size()-1; i>=0; --i)
		{
			if (mvInventory[i].msID==asItemID)
				return mvInventory[i];
		}
		
		return null;
	}
	
	//--------------------------
	
	cItemEntry@ FindByID(const tString& in asItemID)
	{
		for (int i=mvInventory.size()-1; i>=0; --i)
		{
			if (mvInventory[i].msID==asItemID)
				return @mvInventory[i];
		}
		return null;
	}
	
	//--------------------------
	
	void RemoveTypeFromInventory(const tString& in asType, int alCount=-1)
	{
		if (alCount==0) return;
			
		for (int i=mvInventory.size()-1;i>=0;--i)
		{
			if (mvInventory[i].msType==asType)
			{
				for(int lCurrent = mvInventory[i].GetAmount(); lCurrent>1; lCurrent = mvInventory[i].GetAmount())
				{
					mvInventory[i].SetAmount(lCurrent-1);
					alCount--;
					if (alCount==0) return;
				}
				
				AddInventoryDebugMsg("Removed "+mvInventory[i].msID+" from inventory.");
				mvInventory[i].Destroy();
				mvInventory.removeAt(i);
				alCount--;
				if (alCount==0) return;
			}
		}
	}
	
	//--------------------------
	
	bool IsTypeInInventory(const tString& in asType)
	{
		for (int i=mvInventory.size()-1;i>=0;--i)
		{
			if (mvInventory[i].msType==asType)
				return true;
		}
		return false;
	}
	
	//--------------------------
	
	int GetTypeCountInInventory(const tString& in asType)
	{
		int lCount=0;
		for (int i=mvInventory.size()-1;i>=0;--i)
		{
			if (mvInventory[i].msType==asType)
				lCount+=mvInventory[i].GetAmount();
		}
		return lCount;
	}
	
	//--------------------------
	
	tString GetFirstOfType(const tString& in asType)
	{
		for (int i=mvInventory.size()-1; i>=0; --i)
		{
			if (mvInventory[i].msType == asType)
				return mvInventory[i].msID;
		}
		
		return "";
	}

	//--------------------------
	
	iScrItem@ GetItem(int i)
	{
		return mvInventory[i];
	}
	
	//--------------------------
	
	void AddInventoryDebugMsg(const tString&in asMsg)
	{
		cLux_AddDebugMessage("[" + msInventoryName + "] " + asMsg);
	}
	
	//--------------------------
	
	void AddInventoryErrorMsg(const tString&in asMsg)
	{
		Error("[" + msInventoryName + "] " + asMsg);
	}
	
	//--------------------------
}

//----------------------------------------------------------------------------------------

class cScrItemHandler : iScrUserModule, iScrUserModule_Interface, iScrItemHandler_Interface
{	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INIT
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void Init()
	{
		mbInited=true;
		LoadConfig("Inventory.cfg");
		
		/////////////////////////
		// Setup player inventory
		mPlayerInventory.msInventoryName = "PlayerInventory";
		mPlayerInventory.mlInventoryID = eInventoryInstance_Player;
		mPlayerInventory.ClearInventory();
		mPlayerInventory.mlCurrentSlotsCount = mlPlayerInventoryDefaultSlotsCount;
		mPlayerInventory.mlSlotsMinLimit = mlPlayerInventoryDefaultSlotsCount;
		mPlayerInventory.mlSlotsMaxLimit = 15; 
		
		////////////////////////////
		// Setup auxiliary inventory
		mAuxiliaryInventory.msInventoryName = "AuxiliaryInventory";
		mPlayerInventory.mlInventoryID = eInventoryInstance_Auxiliary;
		mAuxiliaryInventory.ClearInventory();
		mAuxiliaryInventory.mlCurrentSlotsCount = 16;
		mAuxiliaryInventory.mlSlotsMinLimit = 16;
		mAuxiliaryInventory.mlSlotsMaxLimit = 16;
		
		//////////
		// Hotkeys
		mvHotkeys.resize(4);
		for (int i=0; i<4; ++i)
		{
			mvHotkeys[i]="";
		}
		
		////////
		// Misc
		mHands.resize(2);
		@mpCraftPreviewItem = null;

		LoadUserConfig();
	}
	
	//------------------------------------------------------------
	
	void Reset()
	{
	}
		
	//------------------------------------------------------------
	
	void LoadUserConfig()
	{
		mbBodyShadowsActive = cLux_GetUserConfig().GetBool("Graphics", "BodyShadows", true);
	}
	
	//------------------------------------------------------------
	
	void SaveUserConfig()
	{
	}
	
	//------------------------------------------------------------
	
	/////////////////////////////////////////
	// INTERFACE
	/////////////////////////////////////////
	
	//------------------------------------------------------------
	
	void OnNewGame()
	{
		/////////////////////
		// Setup inventory slots
		mlPlayerInventoryDefaultSlotsCount = GameDifficulty_GetSettingValueByID_Float(eGameDifficultySetting_InitialInventorySize);
		mPlayerInventory.mlCurrentSlotsCount = mlPlayerInventoryDefaultSlotsCount;
		mPlayerInventory.mlSlotsMinLimit = mlPlayerInventoryDefaultSlotsCount;
	}
	
	//------------------------------------------------------------
	
	void SetCraftingPreviewItem(const tString&in asType)
	{
		tString sID = "Preview_Item_" + asType;
		
		cItemEntry@ pItem = cItemEntry(sID, asType);
		if (pItem is null)
		{
			cLux_AddDebugMessage("[ItemHandler] Something went wrong. The crafting preview item " + sID + " is null.");
			return;
		}
		
		iScrItemType@ pType = pItem.GetType();
		if (pType is null)
		{
			cLux_AddDebugMessage("[ItemHandler] Failed to setup a crafting preview item. Unknown item type:'"+asType+"'");
			return;
		}
		
		@mpCraftPreviewItem = pItem;
	}
	
	//------------------------------------------------------------
	
	void ClearCraftingPreviewItem()
	{
		@mpCraftPreviewItem = null;
	}
	
	//------------------------------------------------------------
	
	iScrItem@ GetCraftingPreviewItem()
	{
		return mpCraftPreviewItem;
	}
	
	//------------------------------------------------------------
	
	cInventory@ GetInventoryInstance(eInventoryInstance aInstance)
	{
		if (aInstance == eInventoryInstance_Player)
			return mPlayerInventory;
		else if (aInstance == eInventoryInstance_Auxiliary)
			return mAuxiliaryInventory;

		Error("[Item Handler] Inventory instance doesn't exist!");
		return null;
	}
	
	//------------------------------------------------------------
	
	void ClearInventory(eInventoryInstance aInstance)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return;
		pInst.ClearInventory();
	}
	
	//------------------------------------------------------------
	
	int GetMaxSlotsCount(eInventoryInstance aInstance)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return 0;
		return pInst.mlSlotsMaxLimit;
	}
	
	//------------------------------------------------------------
	
	void SetMaxSlotsCount(eInventoryInstance aInstance, int alValue)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return;
		pInst.SetMaxSlotsCount(alValue);
	}
	
	//------------------------------------------------------------
	
	int GetMinSlotsCount(eInventoryInstance aInstance)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return 0;
		return pInst.mlSlotsMinLimit;
	}
	
	//------------------------------------------------------------
	
	void SetMinSlotsCount(eInventoryInstance aInstance, int alValue)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return;
		pInst.SetMinSlotsCount(alValue);
	}
	
	//------------------------------------------------------------
	
	int GetCurrentSlotsCount(eInventoryInstance aInstance)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return 0;
		return pInst.mlCurrentSlotsCount;
	}
	
	//------------------------------------------------------------
	
	int GetPlayerInventoryDefaultSlotsCount()
	{
		return mlPlayerInventoryDefaultSlotsCount;
	}
	
	//------------------------------------------------------------
	
	int GetItemCount(eInventoryInstance aInstance, bool abIgnoreHidden=false)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return 0;
		return pInst.GetItemCount(abIgnoreHidden);
	}
	
	//------------------------------------------------------------
	
	iScrItem@ GetItem(eInventoryInstance aInstance, int i)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return null;
		return pInst.GetItem(i);
	}
	
	//------------------------------------------------------------
	
	void SetCurrentSlotsCount(eInventoryInstance aInstance, int alValue)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return;
		pInst.SetCurrentSlotsCount(alValue);
	}
	
	//------------------------------------------------------------	
	
	tString AddToInventory(eInventoryInstance aInstance, const tString& in asType, bool abDrawGuiAnimation = false)
	{
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null) return "";
		
		if (abDrawGuiAnimation)
		{
			tString sID = asType + "_" + pInst.mlLastItemID;
			cItemEntry@ pItem = cItemEntry(sID,asType);
			if (pItem is null) return "";
			StartPickUpGuiAnimation(pItem.GetPickupIcon(), pItem.GetTypeID());
		}
		
		return pInst.AddItem(asType);
	}
	
	//------------------------------------------------------------
	
	tString DrawPickupGui(const tString& in asEntityName, bool abLockerItem=false)
	{
		iLuxEntity@ pEntity = cLux_GetCurrentMap().GetEntityByName(asEntityName);
		if (pEntity is null)
		{
			@mHoverGui = null;
			Error("[ItemHandler] Trying to pick up unknown entity "+asEntityName);
			return "";
		}
		
		tString sItemType = "";
		tString sClassName = pEntity.GetClassName();
		
		if (sClassName == "cScrPropReadable")
		{
			cScript_RunGlobalFunc(pEntity.GetName(), "cScrPropReadable", "_Global_GetIsPhoto");
			bool bIsPhoto = cScript_GetGlobalReturnBool();	
			sItemType = bIsPhoto ? "Photo" : "Note";
		}
		else if (sClassName == "cScrPropReadableDogTag")
		{
			sItemType = "DogTag";
		}
		else
		{
			sItemType = GetEntityItemType(asEntityName);
		}
		
		// use name for id. not sure if the best
		tString sID = sItemType;

		if(mHoverGui !is null)
		{
			if(mHoverGui.msID == sID && mHoverGui.mbLockerItem == abLockerItem)
			{
				mHoverGui.mfTimePassed = 0;
				mHoverGui.mbShouldFadeOut = false;
				return sID;
			}
			
			return mHoverGui.msID;
		}
		
		//cLux_AddDebugMessage(sItemType);
		

		if (sItemType=="")
		{
			@mHoverGui = null;
			Error("[ItemHandler] Trying to pick up an entity "+asEntityName+" which has no specified item type.");
			return "";
		}
		
		tString sPickupIcon = "";
		tString sNameID = "";
		
		if (sItemType == "Note")
		{
			sPickupIcon = "inventory/items/inventory_item_note.dds";
			sNameID = "Note";
		}
		else if (sItemType == "Photo")
		{
			sPickupIcon = "inventory/photos/photo_icon.dds";
			sNameID = "Photo";
		}
		else if (sItemType == "DogTag")
		{
			sPickupIcon = "inventory/items/inventory_item_dogtag_code.dds";
			sNameID = "DogTag";
		}
		else
		{
			cItemEntry@ pItem = cItemEntry(sID, sItemType);
			if (pItem is null)
			{
				@mHoverGui = null;
				return "";
			}
			
			sPickupIcon = pItem.GetPickupIcon();
			sNameID = pItem.GetType().GetNameID();
		}
			
		if (sPickupIcon=="" || sNameID=="")
		{
			@mHoverGui = null;
			Error("[ItemHandler] Trying to pick up an entity "+asEntityName+" which has no specified icon or name id.");
			return "";
		}

		////////////////////////
		// Create new pickup gui
		@mHoverGui = cPickupGui(sID, sPickupIcon, sItemType, false, sNameID);
		
		if (mHoverGui is null)
			return "";
		
		mHoverGui.mbLockerItem = abLockerItem;
		mHoverGui.mbShouldAnimate = false;
		mHoverGui.mfSize = mHoverGui.mfIconSmallSize;
		cVector2f vPos = cVector2f(0.5, 0.5); 
		vPos.y += 0.075;
		mHoverGui.mvGoalDest = abLockerItem ? cVector3f(vPos.x, vPos.y, gvItemHandlerGuiPos.z) : GetPickupGuiDestPos(0);
		mHoverGui.mvPos = mHoverGui.mvGoalDest;
		
		mHoverGui.mfFadeInTime = abLockerItem ? 0.1f : 0.2f;
		mHoverGui.mfFadeOutTime = abLockerItem ? 0.1f : 0.2f;
		mHoverGui.mfAnimationTime = 0.2;
		mHoverGui.mbGreyscale = true;
		
		return sID;
	}

	//------------------------------------------------------------

	void StopDrawPickupGui(const tString& in asID)
	{
	}

	//------------------------------------------------------------
	
	tID m_idTempRTUItem;
	tString msTempRTUItemID;
	tString msTempRTUItemRemovalAnim;
	
	void EquipTempRTUItem(const tString&in asItemID, eItemHandlerHand aHand)
	{
		msTempRTUItemRemovalAnim = "";
		
		if (m_idTempRTUItem != tID_Invalid && msTempRTUItemID == asItemID)
			return;
		
		msTempRTUItemID = asItemID;
		
		////////////////
		// Create lighter
		iScrItem@ pItem = GetInventoryInstance(eInventoryInstance_Player).GetByID(asItemID);
		if (pItem is null) return;
		
		cLuxMap@ pMap = cLux_GetCurrentMap();
		pMap.CreateEntity("TempRTUItem", pItem.GetType().GetHandEntityFile(), cMatrixf_Identity, cVector3f(1.f));
			
		iLuxEntity@ pEnt = pMap.GetLatestEntity();
		if (pEnt !is null)
		{
			m_idTempRTUItem = pEnt.GetID();
			
			pEnt.GetMeshEntity().SetRenderLayer(glArmsRenderLayer);
			
			////////////////
			// Equip item
			PlayerBody_AttachProp(pEnt.GetName(), aHand == eItemHandlerHand_Left ? "L_Hand" : "R_Hand", true, true);
		}
	}

