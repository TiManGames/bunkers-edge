		}
	}
	
	//------------------------------------------------------------	
	
	void RemoveFromInventory(eInventoryInstance aInstance, const tString& in asItemID, bool abWholeBulk=false, bool abSkipUnequip=false)
	{
		cLux_AddDebugMessage("Start dropping item.");
		
		cInventory@ pInst = GetInventoryInstance(aInstance);
		if (pInst is null)
		{
			Error("[Itemhandler]" + pInst.msInventoryName + " inventory instance doesn't exist!");
			return;
		}
		
		cLux_AddDebugMessage("Dropping item from " + pInst.msInventoryName);
		
		///////////////////
		// Manage held item
		tString sHeldItem="";
		if (pInst is mPlayerInventory)
		{
			eItemHandlerHand hand = GetHandHoldingItem(asItemID);
			if (hand != eItemHandlerHand_LastEnum)
			{
				sHeldItem = GetHeldEntity(hand);
				StopUsingItem(hand);
				
				if (abSkipUnequip == false)
					Hands_SwitchToDropping(hand);
				else
				{
					Hands_SwitchToNone(hand);
					PlayerBody_StopAnimationLayer(hand == eItemHandlerHand_Left ? ePlayerBodyAnimationLayer_LeftArm : ePlayerBodyAnimationLayer_RightArm, 0);
				}
			}
		}
		
		///////////
		// Callback
		iScrItem@ pItem = GetItemByID(asItemID, aInstance);
		const tString sType = (pItem is null) ? "" : pItem.GetType().GetID();
		mCallbacks.OnRemoveFromInventory(sType, pItem, sHeldItem, aInstance);
		
		if (sHeldItem!="")
			NotifyHeldItemDrop(sType, sHeldItem);
		
		//////////////
		// Remove item
		pInst.RemoveItem(asItemID, abWholeBulk);
	}
	
	//------------------------------------------------------------
	
	void AddToInventoryFromInventory(const tString&in asItemID, eInventoryInstance aSourceInstance, eInventoryInstance aDestinationInstance)
	{
		/////////////////////////
		// Define the inventories
		cInventory@ pSourceInst = GetInventoryInstance(aSourceInstance);
		if (pSourceInst is null) return;
		cInventory pDestinationInst = GetInventoryInstance(aDestinationInstance);
		if (pDestinationInst is null) return;
		
		///////////////////////
		// Define the item type
		iScrItem@ pItemSource = GetItemByID(asItemID, aSourceInstance);
		if (pItemSource is null) return;
		const tString sType = pItemSource.GetType().GetID();
		if (sType == "") return;
		
		cLux_AddDebugMessage("[Itemhandler] Transfering " + asItemID + " of type " + sType + " from " + pSourceInst.msInventoryName + " over to " + pDestinationInst.msInventoryName);
		
		////////////////////
		// Transfer the item
		tString sItemAdded = AddToInventory(aDestinationInstance, sType);
		if (sItemAdded!="")
		{
			///////////////////
			// Copy data
			iScrItem@ pItemDest = GetItemByID(sItemAdded, aDestinationInstance);
			if (pItemDest !is null)
			{
				//CopyItemDataToEntity(pItemSource, pItemDest.GetInternalEntity());
				//CopyEntityToItemData(pItemSource.GetInternalEntity(), pItemDest);
				
				CopyItemDataToItemData(pItemSource, pItemDest);
			}
			
			RemoveFromInventory(aSourceInstance, asItemID);
		}
		
		const tString sSound = "extra/UI/add_remove";
		Sound_PlayGui(sSound, 1.f);
	}
	
	//------------------------------------------------------------
	
	bool Combine(const tString& in asItemAID, const tString& in asItemBID, eInventoryInstance aInventoryInstanceA, eInventoryInstance aInventoryInstanceB)
	{
		cInventory@ pInvInstA = GetInventoryInstance(aInventoryInstanceA);
		if (pInvInstA is null)
			return false;
			
		cInventory@ pInvInstB = GetInventoryInstance(aInventoryInstanceB);
		if (pInvInstB is null)
			return false;
		
		///////////////////
		// Handle Callbacks
		iScrItem@ pItemA = GetItemByID(asItemAID, aInventoryInstanceA);
		if (pItemA is null)
			return false;
        
		iScrItem@ pItemB = GetItemByID(asItemBID, aInventoryInstanceB);
		if (pItemB is null)
			return false;
			
		if (pInvInstB.StackItems(pItemA, pItemB))
			return true;
			
		bool bAltered = false;
		
		/////////////////////////
		// Try map callback first
		cLuxMap @pMap = cLux_GetCurrentMap();
		tString sMethod = "(const tString& in asItemTypeA, iScrItem@ pItemA, const tString& in asItemTypeB, iScrItem@ pItemB, eInventoryInstance aInventoryInstanceA, eInventoryInstance aInventoryInstanceB)";
		if ( pMap.ScriptMethodExists(sMethod) && pMap.ScriptPrepare(sMethod) )
		{
			tString sTypeAID = pItemA.GetType().GetID();
			tString sItemAID = pItemA.GetID();
			tString sTypeBID = pItemB.GetType().GetID();
			tString sItemBID = pItemB.GetID();
			pMap.SetArgString(0, sTypeAID);
			pMap.SetArgString(1, sItemAID);
			pMap.SetArgString(2, sTypeBID);
			pMap.SetArgString(3, sItemBID);
			if (pMap.ScriptExecute())
				bAltered = pMap.GetReturnBool();
		}
		
		//////////////////////
		// Map callback failed or returned false
		// Take some action via game callback
		if (bAltered==false)
			bAltered = mCallbacks.OnItemsCombined(pItemA.GetTypeID(), pItemA, pItemB.GetTypeID(), pItemB, aInventoryInstanceA, aInventoryInstanceB);
		
		///////////////
		// Sanity check
		/*if (bAltered==false)
		{
			int lCount = pInst.mvInventory.size();
			if (lCount != pInst.mvInventory.size())
				bAltered=true;
		}*/
		
		if (bAltered)
			Sound_PlayGui("special_fx/notepad/notebook_item_combine", 1);
			
		return bAltered;
	}
	
