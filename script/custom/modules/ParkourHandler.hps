	bool mbPoleClimbCandidateActive = false;
	bool mbPoleClimbCandidateHasTopExit = false;
	bool mbPoleClimbCandidateTopExitCrouch = false;
	float mfPoleClimbCandidateTime = -1.f;
	float mfPoleClimbCandidateMinY = 0.f;
	float mfPoleClimbCandidateMaxY = 1.f;
	float mfPoleClimbCandidateGrabRadius = 0.9f;
	float mfPoleClimbCandidateMinApproachSpeed = 0.35f;
	float mfPoleClimbCandidateMinVerticalSpeed = -9.0f;
	float mfPoleClimbCandidateAttachRadius = 0.42f;
	float mfPoleClimbCandidateClimbSpeed = 0.85f;
