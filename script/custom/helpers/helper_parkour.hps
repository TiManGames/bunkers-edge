#include "custom/player/PlayerTypes_Custom.hps"

const tString gsParkourModuleName = "ParkourHandler";
const tString gsParkourUserConfigSection = "BunkersEdge";
const tString gsParkourLevelCompletedOnceKey = "ParkourLevelCompletedOnce";

const float gfParkourWallDetect_EntryRayLength = 0.5f;
const float gfParkourWallDetect_SustainRayLength = 1.00f;
const float gfParkourWallDetect_MaxNormalY = 0.35f;
const float gfParkourWallDetect_ForwardProbeMul = 0.55f;
const float gfParkourWallDetect_ForwardProbeMulWide = 1.15f;
const float gfParkourWallDetect_MinTravelBasisSpeed = 0.35f;
const float gfParkourVelocityFallbackTimeStep = 1.0f / 60.0f;

const int geParkourFlowEvent_WallRunStart = 0;
const int geParkourFlowEvent_WallJump = 1;
const int geParkourFlowEvent_WallScrambleStart = 2;
const int geParkourFlowEvent_WallScrambleJump = 3;
const int geParkourFlowEvent_RollSuccess = 4;
const int geParkourFlowEvent_HardLanding = 5;
const int geParkourFlowEvent_LedgeSuccess = 6;
const int geParkourFlowEvent_LedgeFail = 7;
const int geParkourFlowEvent_FrontWallImpact = 8;
const int geParkourFlowEvent_WallRunDropped = 9;
const int geParkourFlowEvent_WallRunTimeout = 10;
const int geParkourFlowEvent_PoleSwingGrab = 11;
const int geParkourFlowEvent_PoleSwingGoodRelease = 12;
const int geParkourFlowEvent_PoleSwingBadRelease = 13;
const int geParkourFlowEvent_PoleSwingDrop = 14;
const int geParkourFlowEvent_SlideStart = 15;
const int geParkourFlowEvent_SlideJump = 16;
const int geParkourFlowEvent_SlideComplete = 17;
const int geParkourFlowEvent_SpeedVault = 18;
const int geParkourFlowEvent_PoleClimbGrab = 19;
const int geParkourFlowEvent_PoleClimbJump = 20;
const int geParkourFlowEvent_PoleClimbTopOut = 21;
const int geParkourFlowEvent_PoleClimbDrop = 22;
const int geParkourFlowEvent_ZiplineGrab = 23;
