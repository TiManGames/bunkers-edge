									   float afFallGrace,
									   float afMaxCameraRoll,
									   float afFallSideSpeed,
									   float afFallDownSpeed,
									   float afExitSpeed)
{
	cScript_SetGlobalArgVector3f(0, avStartPoint);
	cScript_SetGlobalArgVector3f(1, avEndPoint);
	cScript_SetGlobalArgVector3f(2, avForward);
	cScript_SetGlobalArgVector3f(3, avRight);
	cScript_SetGlobalArgFloat(4, afEntryProgress);
	cScript_SetGlobalArgFloat(5, afWalkSpeed);
	cScript_SetGlobalArgFloat(6, afAutoDrift);
	cScript_SetGlobalArgFloat(7, afCorrectionStrength);
	cScript_SetGlobalArgFloat(8, afBalanceDamping);
	cScript_SetGlobalArgFloat(9, afFallGrace);
	cScript_SetGlobalArgFloat(10, afMaxCameraRoll);
	cScript_SetGlobalArgFloat(11, afFallSideSpeed);
	cScript_SetGlobalArgFloat(12, afFallDownSpeed);
	cScript_SetGlobalArgFloat(13, afExitSpeed);
	cScript_RunGlobalFunc(gsParkourModuleName, "", "_Global_RegisterBeamWalkCandidate");
}

//------------------------------------------------------------

bool Parkour_TryStartBeamWalkCandidate(bool abRequireNormalMoveState = true)
{
	cScript_SetGlobalArgBool(0, abRequireNormalMoveState);
	cScript_RunGlobalFunc(gsParkourModuleName, "", "_Global_TryStartBeamWalkCandidate");
	return cScript_GetGlobalReturnBool();
}

//------------------------------------------------------------

bool Parkour_GetWallRunBasis(iCharacterBody@ apBody,
							 cVector3f &out avForward,
							 cVector3f &out avRight,
							 float afTimeStep = 0.f)
{
	if (apBody is null) return false;

	avForward = Parkour_GetFlatVelocity(apBody, afTimeStep);
	if (avForward.Length() <= gfParkourWallDetect_MinTravelBasisSpeed)
	{
		avForward = apBody.GetForceVelocity();
		avForward.y = 0.f;
	}
	if (avForward.Length() <= gfParkourWallDetect_MinTravelBasisSpeed)
	{
		avForward = apBody.GetForward();
		avForward.y = 0.f;
	}
	if (avForward.SqrLength() <= 0.001f)
	{
		avForward = cLux_GetPlayer().GetCamera().GetForward();
		avForward.y = 0.f;
	}
	if (avForward.SqrLength() <= 0.001f) return false;
	avForward.Normalize();

	avRight = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, avForward));
	if (avRight.SqrLength() <= 0.001f) return false;
	avRight.Normalize();

	return true;
}

//------------------------------------------------------------

bool Parkour_IsValidWallRunNormal(const cVector3f &in avNormal)
{
	if (avNormal.SqrLength() <= 0.001f) return false;
	return cMath_Abs(avNormal.y) <= gfParkourWallDetect_MaxNormalY;
}

//------------------------------------------------------------

int Parkour_GetWallRunSideFromNormal(const cVector3f &in avNormal,
									 const cVector3f &in avRight)
{
	return cMath_Vector3Dot(avNormal, avRight) < 0.f ? 1 : -1;
}

//------------------------------------------------------------

bool Parkour_CastSurfaceRay(const cVector3f &in avStart,
							const cVector3f &in avDir,
							float afRayLength,
							float &out afDistance,
							cVector3f &out avNormal)
{
	afDistance = 1000.f;
	avNormal = cVector3f_Zero;

	cVector3f vDir = avDir;
	if (vDir.SqrLength() <= 0.001f) return false;
	vDir.Normalize();

	iPhysicsBody@ pHit = cLux_GetClosestCharCollideBody(avStart, vDir, afRayLength, afDistance, avNormal);
	if (pHit is null)
		@pHit = cLux_GetClosestBody(avStart, vDir, afRayLength, afDistance, avNormal);

	if (pHit is null || avNormal.SqrLength() <= 0.001f) return false;
	avNormal.Normalize();
	return true;
}

//------------------------------------------------------------

bool Parkour_CastWallRunRay(const cVector3f &in avStart,
							const cVector3f &in avDir,
							float afRayLength,
							float &out afDistance,
							cVector3f &out avNormal,
							bool &out abBodyHit)
{
	afDistance = 1000.f;
	avNormal = cVector3f_Zero;
	abBodyHit = false;

	cVector3f vDir = avDir;
	vDir.y = 0.f;
	if (vDir.SqrLength() <= 0.001f) return false;
	vDir.Normalize();

	iPhysicsBody@ pHit = cLux_GetClosestCharCollideBody(avStart, vDir, afRayLength, afDistance, avNormal);
	if (pHit is null)
		@pHit = cLux_GetClosestBody(avStart, vDir, afRayLength, afDistance, avNormal);

	if (pHit is null) return false;
	abBodyHit = true;

	if (Parkour_IsValidWallRunNormal(avNormal) == false) return false;

	avNormal.y = 0.f;
	if (avNormal.SqrLength() <= 0.001f) return false;
	avNormal.Normalize();

	return true;
}

//------------------------------------------------------------

bool Parkour_FindFrontWall(iCharacterBody@ apBody,
						   float afRayLength,
						   bool abUseCameraForward,
						   cVector3f &out avNormal,
						   float &out afDistance,
						   tString &out asFailReason,
						   float afTimeStep = 0.f)
{
	avNormal = cVector3f_Zero;
	afDistance = 1000.f;
	asFailReason = "no front wall hit";

	if (apBody is null)
	{
		asFailReason = "no player body";
		return false;
	}

	cVector3f vForward;
	cVector3f vRight;
	if (abUseCameraForward)
	{
		vForward = cLux_GetPlayer().GetCamera().GetForward();
		vForward.y = 0.f;
		if (vForward.SqrLength() > 0.001f)
			vForward.Normalize();
		else if (Parkour_GetWallRunBasis(apBody, vForward, vRight, afTimeStep) == false)
		{
			asFailReason = "no camera/body basis";
			return false;
		}

		vRight = cMath_Vector3Normalize(cMath_Vector3Cross(cVector3f_Up, vForward));
	}
	else
	{
		if (Parkour_GetWallRunBasis(apBody, vForward, vRight, afTimeStep) == false)
		{
			asFailReason = "no camera/body basis";
			return false;
		}
	}

	if (vForward.SqrLength() <= 0.001f || vRight.SqrLength() <= 0.001f)
	{
		asFailReason = "no front wall basis";
		return false;
	}
	vForward.Normalize();
	vRight.Normalize();

	array<float> vHeights = { 0.65f, 1.05f, 1.45f };
	array<float> vSideOffsets = { -0.22f, 0.f, 0.22f };
	bool bFoundWall = false;
	bool bAnyBodyHit = false;

	for (uint h = 0; h < vHeights.size(); ++h)
	{
		for (uint s = 0; s < vSideOffsets.size(); ++s)
		{
			cVector3f vStart = apBody.GetFeetPosition() + cVector3f(0.f, vHeights[h], 0.f) + vRight * vSideOffsets[s];
			float fDistance;
			cVector3f vNormal;
			bool bBodyHit;

			if (Parkour_CastWallRunRay(vStart, vForward, afRayLength, fDistance, vNormal, bBodyHit))
			{
				if (bFoundWall == false || fDistance < afDistance)
				{
					afDistance = fDistance;
					avNormal = vNormal;
					bFoundWall = true;
				}
			}
			else if (bBodyHit)
			{
				bAnyBodyHit = true;
			}
		}
	}

	if (bFoundWall) return true;
	if (bAnyBodyHit)
		asFailReason = "invalid front wall normal";

	return false;
}

//------------------------------------------------------------

bool Parkour_FindWallRunWall(iCharacterBody@ apBody,
							 int alSideFilter,
							 float afRayLength,
							 bool abUseWideForwardProbe,
							 cVector3f &out avNormal,
							 int &out alWallSide,
							 float &out afDistance,
							 tString &out asFailReason,
							 float afTimeStep = 0.f)
{
	avNormal = cVector3f_Zero;
	alWallSide = 0;
	afDistance = 1000.f;
	asFailReason = "no wall hit";

	cVector3f vForward;
	cVector3f vRight;
	if (Parkour_GetWallRunBasis(apBody, vForward, vRight, afTimeStep) == false)
	{
		asFailReason = "no camera/body basis";
		return false;
	}

	array<float> vHeights = { 0.65f, 1.05f, 1.45f };
	array<float> vForwardProbeMuls = { 0.f, gfParkourWallDetect_ForwardProbeMul };
	if (abUseWideForwardProbe)
		vForwardProbeMuls.push_back(gfParkourWallDetect_ForwardProbeMulWide);

	bool bAnyBodyHit = false;
	bool bAnyInvalidNormal = false;
	bool bFoundWall = false;

	for (int lSide = -1; lSide <= 1; lSide += 2)
	{
		if (alSideFilter < 0 && lSide > 0) continue;
		if (alSideFilter > 0 && lSide < 0) continue;

		cVector3f vSideDir = vRight * float(lSide);

		for (uint h = 0; h < vHeights.size(); ++h)
		{
			cVector3f vStart = apBody.GetFeetPosition() + cVector3f(0.f, vHeights[h], 0.f);

			for (uint d = 0; d < vForwardProbeMuls.size(); ++d)
			{
				cVector3f vProbeDir = vSideDir + vForward * vForwardProbeMuls[d];
				float fDistance;
				cVector3f vNormal;
				bool bBodyHit;

				if (Parkour_CastWallRunRay(vStart, vProbeDir, afRayLength, fDistance, vNormal, bBodyHit))
				{
					int lDetectedSide = Parkour_GetWallRunSideFromNormal(vNormal, vRight);
					if (alSideFilter < 0 && lDetectedSide > 0) continue;
					if (alSideFilter > 0 && lDetectedSide < 0) continue;

					if (bFoundWall == false || fDistance < afDistance)
					{
						afDistance = fDistance;
						avNormal = vNormal;
						alWallSide = lDetectedSide;
						bFoundWall = true;
					}
				}
				else if (bBodyHit)
				{
					bAnyBodyHit = true;
					bAnyInvalidNormal = true;
				}
			}
		}
	}

	if (bFoundWall) return true;
	if (bAnyBodyHit || bAnyInvalidNormal)
		asFailReason = "invalid wall normal";

	return false;
}

//------------------------------------------------------------
