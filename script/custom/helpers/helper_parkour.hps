const int geParkourFlowEvent_BeamWalkStart = 26;
const int geParkourFlowEvent_BeamWalkComplete = 27;
const int geParkourFlowEvent_BeamWalkFall = 28;

//------------------------------------------------------------

bool Parkour_GetLevelCompletedOnce()
{
	cConfigFile@ pConfig = cLux_GetUserConfig();
	return pConfig !is null && pConfig.GetBool(gsParkourUserConfigSection,
											 gsParkourLevelCompletedOnceKey,
											 false);
}

//------------------------------------------------------------

void Parkour_SetLevelCompletedOnce()
{
	cConfigFile@ pConfig = cLux_GetUserConfig();
	if (pConfig is null) return;
	if (pConfig.GetBool(gsParkourUserConfigSection, gsParkourLevelCompletedOnceKey, false)) return;

	pConfig.SetBool(gsParkourUserConfigSection, gsParkourLevelCompletedOnceKey, true);
	pConfig.Save();
}

//------------------------------------------------------------

float Parkour_GetSafeVelocityTimeStep(float afTimeStep)
{
	return afTimeStep > 0.0001f ? afTimeStep : gfParkourVelocityFallbackTimeStep;
}

//------------------------------------------------------------

cVector3f Parkour_GetFlatVelocity(iCharacterBody@ apBody,
								  float afTimeStep = 0.f,
								  float afFallbackSqr = 0.001f)
{
	if (apBody is null) return cVector3f_Zero;

	cVector3f vFlatVel = apBody.GetVelocity(Parkour_GetSafeVelocityTimeStep(afTimeStep));
	vFlatVel.y = 0.f;
	if (vFlatVel.SqrLength() <= afFallbackSqr)
	{
		vFlatVel = apBody.GetForceVelocity();
		vFlatVel.y = 0.f;
	}

	return vFlatVel;
}

//------------------------------------------------------------

void Parkour_StartWallSlide(const cVector3f &in avForward,
								float afStartDownSpeed = 4.0f,
								float afDownAcceleration = 2.25f,
								float afMaxDownSpeed = 10.0f,
								float afWallPressSpeed = 1.6f,
								float afSideSpeed = 2.4f)
{
	cScript_SetGlobalArgVector3f(0, avForward);
	cScript_SetGlobalArgFloat(1, afStartDownSpeed);
	cScript_SetGlobalArgFloat(2, afDownAcceleration);
	cScript_SetGlobalArgFloat(3, afMaxDownSpeed);
	cScript_SetGlobalArgFloat(4, afWallPressSpeed);
	cScript_SetGlobalArgFloat(5, afSideSpeed);
	cScript_RunGlobalFunc("State_ParkourWallSlide", "", "SetupParkourWallSlide");
	cLux_GetPlayer().ChangeState(ePlayerState_Custom_ParkourWallSlide);
}

void Parkour_StopWallSlide()
{
	cLux_GetPlayer().ChangeState(ePlayerState_Normal);
}

