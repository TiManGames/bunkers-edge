//-------------------------------------------------

bool Player_GetShowUseItemPromptForState(int alState)
{
	if (Player_GetIsInUsingItemState() == false)
		return false;
	
	cLuxPlayer@ pPlayer = cLux_GetPlayer();
	
	if (pPlayer is null) return false;
	if (pPlayer.GetCurrentStateId() != alState)
		return false;
		
	cScript_RunGlobalFunc(pPlayer.GetCurrentStateName(), "", "_Global_GetShowUseItemPrompt");
	return cScript_GetGlobalReturnBool();
}

//-------------------------------------------------

bool Player_GetIsInUsingItemState()
{
	int lStateId = cLux_GetPlayer().GetCurrentStateId();	
	bool bPlayerInItemUseState = lStateId == ePlayerState_Custom_UsingGun_Aim ||
								 lStateId == ePlayerState_Custom_UsingGun_Reload ||
								 lStateId == ePlayerState_Custom_UsingShotgun_Aim ||
								 lStateId == ePlayerState_Custom_UsingShotgun_Reload ||
								 lStateId == ePlayerState_Custom_UsingVolleyGun_Aim ||
								 lStateId == ePlayerState_Custom_UsingVolleyGun_Reload ||
								 lStateId == ePlayerState_Custom_UsingLantern;		
		
	if (Item_GetUsingState(Item_GetHeldType(eItemHandlerHand_Right)) == lStateId) 	bPlayerInItemUseState = true;
	if (Item_GetUsingState(Item_GetHeldType(eItemHandlerHand_Left)) == lStateId) 	bPlayerInItemUseState = true;
	
	return bPlayerInItemUseState;
}

