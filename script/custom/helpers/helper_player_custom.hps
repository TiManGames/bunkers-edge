void Player_ApplyHeal(bool abFullHeal=false, bool abFeedbackOnly=false)
{
	cLuxMap@ pMap = cLux_GetCurrentMap();
	if (pMap is null) return;
	
	float fHealAmount = abFullHeal ? 1.f : 0.5f;
	cScript_SetGlobalArgFloat(0, fHealAmount);
	cScript_SetGlobalArgBool(1, abFeedbackOnly);
	cScript_RunGlobalFunc("LuxPlayer","","_Global_Heal");
}

