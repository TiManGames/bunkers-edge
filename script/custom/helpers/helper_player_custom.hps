//-------------------------------------------------

void Player_AttachHelmet(const tString &in asHelmetEnt)
{
	cLuxMap@ pMap = cLux_GetCurrentMap();
	iScrPlayerBodyHandler_Interface@ pPlayerBody = cast<iScrPlayerBodyHandler_Interface>(cLux_GetUserModuleFromID(eModuleType_PlayerBodyHandler));
	
	if (pMap is null) return;
	if (pPlayerBody is null) return;
	
	cNode3D@ pSocket = pPlayerBody.GetSocket("CameraSocket");
	iLuxEntity@ pHelmet = pMap.GetEntityByName(asHelmetEnt, eLuxEntityType_Prop);
	cMeshEntity@ pHelmetMeshEnt = pHelmet !is null ? pHelmet.GetMeshEntity() : null;
		
	if (pHelmet is null) return;
	if (pHelmetMeshEnt is null) return;
	if (pSocket is null) return;
	
	pHelmet.SetActive(true);
			
	cMatrixf mtxSocket = pSocket.GetWorldMatrix();
	cMatrixf mtxHelmet = pHelmet.GetMatrix();
	cVector3f vOffset =  mtxSocket.GetTranspose().GetForward() * -0.13f + mtxSocket.GetTranspose().GetUp() * -0.015f;
			
	mtxHelmet.SetTranslation(mtxSocket.GetTranslation() + vOffset);
	mtxHelmet.SetRotation(mtxSocket.GetRotation());		
	pHelmet.SetMatrix(mtxHelmet);
			
	pHelmetMeshEnt.SetRenderFlagBit(eRenderableFlag_VisibleInNonReflection, false);
	pHelmetMeshEnt.SetRenderFlagBit(eRenderableFlag_VisibleInReflection, false);
	
	bool bShadowsActive = cLux_GetUserConfig().GetBool("Graphics", "BodyShadows", true);
	pHelmetMeshEnt.SetRenderFlagBit(eRenderableFlag_ShadowCaster, bShadowsActive);
	
		
	Entity_AttachToSocket(asHelmetEnt, pPlayerBody.GetEntityName(), "CameraSocket", true, false);
}

