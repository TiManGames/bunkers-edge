//-------------------------------------------------

void Player_AddAimAssistTarget(tID a_idEntity, const tString &in asBone, const tString &in asSkipBoolVar, 
							   const cVector3f &in avOffset, float afTargetRadiusMul, float afMaxDist, 
							   float afMinCoverage, bool abUseJointChildPos, bool abRemoveOnSkip, int alWeaponType)
{
	cScript_SetGlobalArgID(0, a_idEntity);
	cScript_SetGlobalArgString(1, asBone);
	cScript_SetGlobalArgString(2, asSkipBoolVar);
	cScript_SetGlobalArgVector3f(3, avOffset);
	cScript_SetGlobalArgFloat(4, afTargetRadiusMul);
	cScript_SetGlobalArgFloat(5, afMaxDist);
	cScript_SetGlobalArgFloat(6, afMinCoverage);
	cScript_SetGlobalArgBool(7, abUseJointChildPos);
	cScript_SetGlobalArgBool(8, abRemoveOnSkip);
	cScript_SetGlobalArgInt(9, alWeaponType);
	cScript_RunGlobalFunc("LuxPlayer", "", "_Global_AddCustomAimAssistTarget");
}

