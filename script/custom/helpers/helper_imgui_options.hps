	disabledLabelData.mFont.mvSize = gfFontSize_MainMenu;
	disabledLabelData.mFontAlign = eFontAlign_Left;
	disabledLabelData.mFont.mColor = cColor(100.f / 255.f, afAlpha);


	//MainMenu_DoButton(asName, OptionMenu_GetTopLeftOffset(avBasePos + cVector2f(0, kOptionMenu_ButtonSpacing * alEntryPos)), false, afAlpha);
	ImGui_DoLabelExt(asName, disabledLabelData, OptionMenu_GetTopLeftOffset(avBasePos + cVector2f(0, kOptionMenu_ButtonSpacing * alEntryPos + 7), 0.0f));
}

