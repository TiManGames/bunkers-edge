//-------------------------------------------------------

bool OptionMenu_MainMenuButton(tString asName, const cVector2f &in avBasePos, int alEntryPos, int alID, tString asSelectedID, int alClickedID, float afAlpha=1.f)
{
	bool bClicked = false;
	
	//////////////////////
	// Define if selected
	bool bSelected = (asSelectedID == asName && alClickedID == -1) || alClickedID == alID;
	if (ImGui_TimerExists("ButtonClicked") && bSelected)
		bSelected = false;
	
	/////////////
	// Draw Btn
	cVector2f vButtonPos2D = avBasePos + cVector2f(0, kOptionMenu_ButtonSpacing * alEntryPos);
	cVector3f vButtonPos = OptionMenu_GetTopLeftOffset(vButtonPos2D, 1.0);
	
	if (MainMenu_DoButton(asName, vButtonPos, bSelected, afAlpha) && alClickedID == -1)
	{
		if (asName != "ReturnToGame" && 
			asName != "Exit" && 
			asName != "LoadLastSave" &&
			asName != "SaveAndExit" && 
			asName != "QuitToMainMenu" &&
			asName != "QuitToDesktop" &&
			ImGui_TimerExists("TransitionOut") == false)
		{
			ImGui_AddTimer("TransitionOut",10.f);
		}
			
		ImGui_AddTimer("ButtonClicked", 0.15f);
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		
		bClicked = true;
	}

	return bClicked;
}

