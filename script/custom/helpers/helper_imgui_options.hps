//------------------------------------------------------- 

bool OptionMenu_ButtonOptions(tString asName, cVector2f avPos, int alID, tString asSelected, bool abSubMenu=true, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBox=cVector3f_Zero, float afAlpha=1)
{
	if (MainMenu_DoButton(asName, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 0.0), asSelected == asName, afAlpha, 1.f, abSubMenu))
	{
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		
		if (asName != "ResetToDefault" && 
			asName != "AutoDetect" &&
			ImGui_TimerExists("TransitionOut") == false)
		{
			ImGui_AddTimer("TransitionOut",10.f);
		}
			
		return true;
	}
	
	return false;
}

//-------------------------------------------------------

bool OptionMenu_ButtonModOptions(tString asName, cVector2f avPos, tString asSelected, bool bFadeOnClick=false, float afAlpha=1, bool abUseSmallFont = false)
{
	//////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = (asSelected == asName ? cColor(1, afAlpha) * gHoverColor : cColor(1,afAlpha)); 
	buttonData.mFont.mColor = buttonData.mFont.mColor * gOptionMenu_ModColor;
	
	if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_ButtonSize.x * 0.45, kOptionMenu_ButtonSize.y))))
	{
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		if (bFadeOnClick && ImGui_TimerExists("TransitionOut") == false)
			ImGui_AddTimer("TransitionOut", 10.f);
			
		return true;
	}
	
	return false;
}

//-------------------------------------------------------

bool OptionMenu_ButtonSaveSlot(tString asName, tWString asTitle, tString asDate, cVector2f avPos, bool abSelected, bool abExpanded, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, afAlpha);
	if (abSelected)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	labelData.mFont.mvSize = gfFontSize_MainMenu;
	labelData.mFont.mColor = buttonData.mFont.mColor;
	labelData.mFontAlign = eFontAlign_Right;
	
	int lSep = cString_GetFirstCharPos(asDate,'-');
	tString sDate = cString_Sub(asDate,0,lSep) + "/" + cString_Sub(asDate,lSep+3);

	//////////////
	// Draw button
	bool bClicked = false;
	
	cImGuiGfx arrowImage("notespage_arrow", eImGuiGfx_Image);
	cVector2f vArrowPosOffset = cVector2f(-25, 10);
			
	if (abExpanded)
	{
		ImGui_SetModRotateAngle(90);
		vArrowPosOffset.y += 5;
	}
	
	cLux_GetCurrentImGui().DoImage(arrowImage, OptionMenu_GetTopLeftOffset(avPos + vArrowPosOffset, 0.3f), OptionMenu_GetScaledSize(cVector2f(20, 20)));
	
	ImGui_SetModRotateAngle(0);
	
	///////////////////
	// Save slot btn
	ImGui_SetTransCategory("Menu");
	if(cLux_GetCurrentImGui().DoButton(asName, asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos, 0.3f), OptionMenu_GetScaledSize(cVector2f(420, 40))))
	{
		bClicked = true;
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
	}

	if (abExpanded)
		return bClicked;
		
	////////////////
	// Date label when collapsed
	ImGui_SetTransCategory("");
	cVector2f vDatePos = avPos + cVector2f(350, 0);
	ImGui_DoLabelExt(sDate, labelData, OptionMenu_GetTopLeftOffset(vDatePos, 1.0), 0);
	ImGui_SetTransCategory("Menu");
	
	return bClicked;
}

//-------------------------------------------------------

bool OptionMenu_ButtonSaveFile(tString asName, tString asTitle, cVector2f avPos, bool abSelected, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = gfFontSize_InfoBox * 0.9;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, afAlpha);
	if (abSelected) buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;

	//////////////
	// Draw button
	bool bClicked = false;
	
	//////////////////////////////
	// Translate if it's not a quicksave
	//ImGui_SetTransCategory("Levels");
	ImGui_SetTransCategory("");
	
	///////////////////
	// Save file btn
	if(cLux_GetCurrentImGui().DoButton(asName, cString_To16Char(asTitle), buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.5f), OptionMenu_GetScaledSize(cVector2f(130, 40))))
	{
		bClicked = true;
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
	}

	ImGui_SetTransCategory("Menu");

	return bClicked;
}

//-------------------------------------------------------

bool OptionMenu_ButtonMod(tString&in asName, tString&in asTitle, cVector2f avPos, bool abInFocus, tString&in asProvider, float afAlpha=1, bool abDownload=false, float afDownloadProgress=0)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	const float fAlpha = abDownload ? afAlpha * 0.75 : afAlpha;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, fAlpha) ;
	if (abInFocus)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	
	ImGui_LayoutBegin(eImGuiLayout_X, cVector3f_Zero, cVector2f_MinusOne, cVector2f(2));
	{
		// Provider img
		if (abDownload==false)
		{
			const cVector2f vProvImgSize = cVector2f(25);
			const cVector2f vProvImgPos = avPos + cVector2f(0,8);
			cImGuiGfx gfxProviderImg = cImGuiGfx(asProvider, eImGuiGfx_Texture);
			gfxProviderImg.mColor = buttonData.mFont.mColor;
			ImGui_DoImage(gfxProviderImg, OptionMenu_GetTopLeftOffset(vProvImgPos, 1.0), OptionMenu_GetScaledSize(vProvImgSize));
		}
		// download %
		else
		{
			cImGuiLabelData labelData;
			labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
			labelData.mFont.mvSize = cVector2f(28, 28);
			labelData.mFontAlign = eFontAlign_Left;
			labelData.mColorBase = buttonData.mFont.mColor;
			const cVector2f vProvImgPos = avPos + cVector2f(0,8);
			tString sLabel = ""+ cMath_RoundToInt(100 * afDownloadProgress) +" % ";
			ImGui_DoLabelExt(sLabel, labelData, OptionMenu_GetTopLeftOffset(vProvImgPos, 1.0), cVector2f_MinusOne, 0.8);
		}
		
		// Button
		const cVector2f vBtnSize = cVector2f(360, 38);
		if (ImGui_DoButtonExt(asName, asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(vBtnSize)))
		{
			if (abDownload==false)
			{
				Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
				return true;
			}
		}
	}
	ImGui_LayoutEnd();
	
	return false;
}

bool OptionMenu_ButtonModHeader(tString asName, const cVector3f &in avPos, bool abSelected, float afAlpha=1.f, float afBrightness=1.f)
{
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor =  cColor(1.0, afAlpha) * gOptionMenu_ModColor * afBrightness;
	
	if (abSelected)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	
	cVector2f vBtnSize = OptionMenu_GetScaledSize(cVector2f(150, 30));
	
	if (ImGui_DoButtonExt(asName, asName, buttonData, avPos, vBtnSize))
	{
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		return true;
	}
	
	return false;
}

bool OptionMenu_ButtonModBase(uint32 alID, tString&in asTitle, cVector2f avPos, bool abInFocus, const array<tString> &in avProviderIcons, float afAlpha=1, bool abDoCheckbox=false, bool abIsChecked=false)
{
	uint32 lProviderIndex = cLux_GetModHandler().GetProviderIndexFromModID(alID);
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, afAlpha) ;
	if (abInFocus)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;

	cImGuiLabelData labelData;
	labelData.mFont = buttonData.mFont;
	labelData.mFontAlign = eFontAlign_Left;
	labelData.mColorBase = cColor(1);
	labelData.mbScrolling = true;
	labelData.mfScrollSpeed = abInFocus ? 45.f : 0.f;
	labelData.mfScrollResetDelay = 1.f;
	labelData.mfScrollStartDelay = 1.f;
	
	// Hack to make labels reset scrolling when not in focus
	if (abInFocus == false)
		ImGui_SetStateFloat(asTitle + "$value", -labelData.mfScrollStartDelay);

	bool bRet = false;

	cVector3f vBtnPos = OptionMenu_GetTopLeftOffset(avPos, 1.0f);
	const cVector2f vBtnSize = OptionMenu_GetScaledSize(cVector2f(360, labelData.mFont.mvSize.y));
	cVector2f vLabelSize = OptionMenu_GetScaledSize(cVector2f(320, labelData.mFont.mvSize.y));
	
	ImGui_GroupBegin(vBtnPos, vBtnSize);
	{
		ImGui_LayoutBegin(eImGuiLayout_X, cVector3f_Zero, cVector2f_MinusOne, cVector2f(0));
		{
			float fYOffset;

			if(abDoCheckbox)
			{
				tString sTickboxImg = abIsChecked ? "startmenu_options_tickbox_true" : "startmenu_options_tickbox_false";
				cImGuiGfx gfxTickbox(sTickboxImg);
				float fTickboxSize = vBtnSize.y*0.8f;
				fYOffset = (vBtnSize.y - fTickboxSize)*0.5f;
			
				gfxTickbox.mColor = cColor(1, afAlpha) * gOptionMenu_ModColor;
				if (abInFocus)
					gfxTickbox.mColor = gfxTickbox.mColor * gHoverColor;

				ImGui_DoImage(gfxTickbox, cVector3f(0, fYOffset, 0), fTickboxSize);
				ImGui_AddLayoutHorizontalSpace(5);
			}

			// Provider img
			const cVector2f vProvImgSize = OptionMenu_GetScaledSize(25);
			fYOffset = (vBtnSize.y - vProvImgSize.y)*0.5f;
			
			cImGuiGfx gfxProviderImg;
			
			if(alID != -1)
			{
				gfxProviderImg = cImGuiGfx(avProviderIcons[lProviderIndex], eImGuiGfx_Texture);
				gfxProviderImg.mColor = buttonData.mFont.mColor;
			}
			else
			{
				gfxProviderImg.mColor = cColor(0,0);
			}
			
			ImGui_DoImage(gfxProviderImg, cVector3f(0,fYOffset, 0), vProvImgSize);

			fYOffset = (vBtnSize.y - labelData.mFont.mvSize.y)*2.f;
			ImGui_DoLabelExt(asTitle, labelData, cVector3f(2, fYOffset, 0), vLabelSize);
			
			//ImGui_DoLabelExt("Mod" + alID, labelData, cVector3f(0, fYOffset, 0), cVector2f_MinusOne);
		}
		ImGui_LayoutEnd();
	
		// Button
		ImGui_LayoutBegin(eImGuiLayout_X, cVector3f_Zero, cVector2f_MinusOne, cVector2f(2));	
		if (ImGui_DoButtonExt("Mod" + alID, "", buttonData, cVector3f_Zero, vBtnSize))
		{
			bRet = true;
			Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		}
		ImGui_LayoutEnd();
	}
	ImGui_GroupEnd();
	
	return bRet;
}

bool OptionMenu_ModDownload(uint32 alID, tString&in asTitle, cVector2f avPos, bool abInFocus, const array<tString> &in avProviderIcons, float afDownloadProgress, float afAlpha=1)
{
	uint32 lProviderIndex = cLux_GetModHandler().GetProviderIndexFromModID(alID);
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;	// overridden below
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
	buttonData.mFont.mvSize = gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	const float fAlpha = afAlpha * 0.75;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, fAlpha) ;
	if (abInFocus)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	
	ImGui_LayoutBegin(eImGuiLayout_X, cVector3f_Zero, cVector2f_MinusOne, cVector2f(2));
	{
		// Provider img
		const cVector2f vProvImgSize = cVector2f(25);
		const cVector2f vProvImgPos = avPos + cVector2f(0,8);
		cImGuiGfx gfxProviderImg = cImGuiGfx(avProviderIcons[lProviderIndex], eImGuiGfx_Texture);
		gfxProviderImg.mColor = buttonData.mFont.mColor;
		ImGui_DoImage(gfxProviderImg, OptionMenu_GetTopLeftOffset(vProvImgPos, 1.0), OptionMenu_GetScaledSize(vProvImgSize));
		
		cImGuiLabelData labelData;
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,56));
		labelData.mFont.mvSize = cVector2f(28, 28);
		labelData.mFontAlign = eFontAlign_Left;
		labelData.mColorBase = buttonData.mFont.mColor;
		tString sLabel = ""+ cMath_RoundToInt(100 * afDownloadProgress) +" % ";
		ImGui_DoLabelExt(sLabel, labelData, OptionMenu_GetTopLeftOffset(vProvImgPos, 1.0), cVector2f_MinusOne, 0.8);
				
		// Button
		const cVector2f vBtnSize = cVector2f(360, 38);
		if (ImGui_DoButtonExt("Download" + alID, asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(vBtnSize)))
		{
		}
	}
	ImGui_LayoutEnd();
	
	return false;
}

//-------------------------------------------------------

bool OptionMenu_ButtonModStandAlone(uint32 alID, tString&in asTitle, cVector2f avPos, bool abInFocus, const array<tString> &in avProviderIcons, float afAlpha=1, bool abIsChecked=false)
{
	return OptionMenu_ButtonModBase(alID, asTitle, avPos, abInFocus, avProviderIcons, afAlpha, true, abIsChecked);
}

//-------------------------------------------------------

bool OptionMenu_ButtonModAddOn(uint32 alID, tString&in asTitle, cVector2f avPos, bool abInFocus, bool abIsChecked, const array<tString> &in avProviderIcons, float afAlpha=1)
{
	return OptionMenu_ButtonModBase(alID, asTitle, avPos, abInFocus, avProviderIcons, afAlpha, true, abIsChecked);
}

//-------------------------------------------------------

int OptionMenu_ButtonKeybind(tString asName, tString asTitle, tString asBindPrimary, tString asBindSecondary, cVector2f avPos, bool abSelected, int alTypeFocus, int&out alFocusChange, bool abDuplicate, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBox=cVector3f_Zero, float afAlpha=1)
{
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mGfxBackground.SetFile("keybind_grid_slot");// =  = cImGuiGfx("keybind_grid_slot", eImGuiGfx_Texture);
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_MainMenu * 0.8;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, afAlpha);
	if (abSelected) buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	buttonData.mfClipAreaPaddingLeft = 12;
	buttonData.mfClipAreaPaddingRight = 16;
	buttonData.mfScrollSpeed = 45;
	buttonData.mfScrollResetDelay = 1;
	
	buttonData.mGfxInFocus = cImGuiGfx("keybind_grid_slot_hover", eImGuiGfx_Texture);
	buttonData.mGfxInFocus.mColor = gOptionMenu_ModColor * gHoverColor * cColor(1, afAlpha);
	
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,3);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	
	cVector2f vButtonSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_Keybind, -5));
	cVector3f vButtonLeftPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x-30,vPosNrm.y+5, vPosNrm.z);
	cVector3f vButtonRightPosNrm = cVector3f(vRightAnchorNrm.x-vButtonSizeNrm.x/2-30,vPosNrm.y+5, vPosNrm.z);
	
	cColor mPrimaryColor = (abDuplicate) ? cColor(1, 0.0f, 0.0, afAlpha) : cColor(1, afAlpha) * gOptionMenu_ModColor;
	cColor mSecondaryColor = cColor(1, afAlpha) * gOptionMenu_ModColor;
	
	//////////////
	// Draw button
	int lClicked = 0;
	alFocusChange = 0;

	/////////////
	// Label
	ImGui_SetTransCategory("Actions"); 

	{
		if(ImGui_DoButtonExt(asName,asTitle, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, 3), 2.0), OptionMenu_GetScaledSize(kOptionMenu_KeybindBaseButtonSize)))
		{
			lClicked = 1;
			//cLux_AddTodoMessage("Sound: Keybind file pressed");
			//Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		}
		if(ImGui_PrevBecameInFocus()) alFocusChange = 1; //Update focus
	}
	
	buttonData.mFontAlign = eFontAlign_Center;
	buttonData.mbClipText = true;
	
	buttonData.mbUseBackgroundGfx = true;
	buttonData.mbUseInFocusGfx = true;

	/////////////////
	// Primary button
	{
		buttonData.mFont.mColor = mPrimaryColor;
		ImGui_SetTransCategory("ButtonNames"); 
		if(ImGui_DoButtonExt(asName+"Primary",asBindPrimary, buttonData, vButtonLeftPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y)))
		{
			lClicked = 1;
			//cLux_AddTodoMessage("Sound: Keybind file pressed");
			Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		}
		if(ImGui_PrevBecameInFocus())
			alFocusChange = 2; //Update focus
	}
			
	///////////////
	// Secondary button
	{
		buttonData.mFont.mColor = mSecondaryColor;

		if(ImGui_DoButtonExt(asName+"Secondary",asBindSecondary, buttonData, vButtonRightPosNrm, cVector2f(vButtonSizeNrm.x/2,vButtonSizeNrm.y)))
		{
			lClicked = 2;
			//cLux_AddTodoMessage("Sound: Keybind file pressed");
			Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		}
		if(ImGui_PrevBecameInFocus())
			alFocusChange = 3; //Update focus
	}
	
	ImGui_SetTransCategory("Menu");

	return lClicked;
}

//-------------------------------------------------------

tString GetGameModeNameByID(int alGameModeID)
{
	if (alGameModeID == eGameMode_VeryEasy) return "VeryEasy";
	else if (alGameModeID == eGameMode_Easy) return "Easy";
	else if (alGameModeID == eGameMode_Normal) return "Normal";
	else if (alGameModeID == eGameMode_Hard) return "Hard";
	else if (alGameModeID == eGameMode_UltraHard) return "ShellShock";
	else if (alGameModeID == eGameMode_Custom) return "Custom";
	return "";
}

//-------------------------------------------------------

bool OptionMenu_LoadSlot(bool abDisabled, int alGameMode, bool abSelected, tString&in asName, tWString&in asMapName, tString&in asDate, cVector2f avPos, tString&in asDescription, bool abHovered, float afAlpha)
{
	ImGui_SetTransCategory("Menu");
	
	bool bClicked = false;
	float fBrightness = 1.f;
	bool bUsed = alGameMode != -1;
	
	//cLux_AddDebugMessage("asMapName " + cString_To8Char(asMapName));
	
	/////////////////////////////////////
	// Label
	cImGuiLabelData labeldata;
	labeldata.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labeldata.mFont.mvSize = gfFontSize_MainMenu * 0.75;
	labeldata.mFontAlign = eFontAlign_Center;
	//labeldata.mFont.mColor = cColor_White;
	labeldata.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
	ImGui_DoLabelExt(asName, labeldata, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, -35), 2.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_SaveSlotTextSize.x, 30)));
	
	/////////////////////////////////////
	// Date
	if (abDisabled || bUsed==false) afAlpha *= 0.25;
	labeldata.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
	if (bUsed && abSelected==false)
	{
		ImGui_SetTransCategory("");

		cImGuiLabelData detailsLabeldata;
		detailsLabeldata.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
		detailsLabeldata.mFont.mvSize = gfFontSize_MainMenu * 0.65;
		detailsLabeldata.mFontAlign = eFontAlign_Center;
		detailsLabeldata.mFont.mColor = cColor_White;
		detailsLabeldata.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
		
		ImGui_SetTransCategory("Levels");
		ImGui_DoLabelExt(cString_To8Char(asMapName), detailsLabeldata, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, 120), 2.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_SaveSlotTextSize.x, 30)));
		ImGui_SetTransCategory("");
		ImGui_DoLabelExt(asDate, detailsLabeldata, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, 140), 2.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_SaveSlotTextSize.x, 30)));
	}
	
	/////////////////////////////////////
	// Do slot button
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = true;
	tString sImg = bUsed ? "startmenu_saveslot_used" : "startmenu_saveslot";
	buttonData.mGfxBackground = cImGuiGfx(sImg);
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_MainMenu_Small;
	buttonData.mFontAlign = eFontAlign_Center;	
	buttonData.mFont.mColor = cColor(fBrightness, afAlpha);
	buttonData.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
	buttonData.mbClipText = true;
	buttonData.mfScrollSpeed = abHovered ? 45.f : 0.f;
	buttonData.mfScrollResetDelay = 1.f;
	buttonData.mfScrollStartDelay = 1.f;
	buttonData.mfClipAreaPaddingLeft = OptionMenu_GetScaledSize(15.f).x;
	buttonData.mfClipAreaPaddingRight = OptionMenu_GetScaledSize(15.f).x;
	
	if ((abSelected && abDisabled && bUsed) || (abHovered && abDisabled==false && bUsed))
		buttonData.mColorBase = gHoverColor;
	
	ImGui_SetTransCategory("Menu");
	tString sLabelText = abSelected ? "" : "Empty";
	tWString sLabel = cString_To16Char(sLabelText);
	if (bUsed && abSelected==false)
		sLabel = cString_To16Char(GetGameModeNameByID(alGameMode));
	
	sLabel = _ImGui_GetTextString(cString_To8Char(sLabel));
	if(cLux_GetCurrentImGui().DoButton(asName, sLabel, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotTextSize)))
	{
		if (abDisabled==false && bUsed)
		{
			bClicked = true;
			Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
		}
	}

	//ImGui_SetTransCategory("Menu");
	return bClicked;
}

//-------------------------------------------------------
	
bool OptionMenu_SaveSlot(int alGameMode, tString&in asName, tWString&in asMapName, tString&in asDate, cVector2f avPos, tString&in asDescription, bool abHovered, float afAlpha, bool abSmallFont=false)
{
	bool bClicked = false;
	float fBrightness = 0.9f;
	bool bUsed = alGameMode != -1;
		
	/////////////////////////////////////
	// Label
	cImGuiLabelData labeldata;
	labeldata.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labeldata.mFont.mvSize = gfFontSize_MainMenu * 0.75;
	labeldata.mFontAlign = eFontAlign_Center;
	labeldata.mFont.mColor = cColor_White;
	labeldata.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
	ImGui_DoLabelExt(asName, labeldata, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, -35), 2.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_SaveSlotTextSize.x, 30)));
	
	/////////////////////////////////////
	// Map & Date
	if (bUsed)
	{
		cImGuiLabelData detailsLabeldata;
		detailsLabeldata.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
		detailsLabeldata.mFont.mvSize = gfFontSize_MainMenu * 0.65;
		detailsLabeldata.mFontAlign = eFontAlign_Center;
		detailsLabeldata.mFont.mColor = cColor(1, 1);
		detailsLabeldata.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
		
		ImGui_SetTransCategory("Levels");
		ImGui_DoLabelExt(cString_To8Char(asMapName), detailsLabeldata, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, 120), 2.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_SaveSlotTextSize.x, 30)));
		ImGui_SetTransCategory("");
		ImGui_DoLabelExt(asDate, detailsLabeldata, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, 140), 2.0), OptionMenu_GetScaledSize(cVector2f(kOptionMenu_SaveSlotTextSize.x, 30)));
	}
	
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = true;
	tString sImage = bUsed ? "startmenu_saveslot_used" : "startmenu_saveslot";
	buttonData.mGfxBackground = cImGuiGfx(sImage);
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_MainMenu_Small;
	buttonData.mFontAlign = eFontAlign_Center;
	float fFontBrightness = bUsed ? fBrightness : fBrightness * 0.75;
	buttonData.mFont.mColor = cColor(fFontBrightness, afAlpha);
	buttonData.mColorBase = cColor(fBrightness, afAlpha) * gOptionMenu_ModColor;
	buttonData.mbClipText = true;
	buttonData.mfScrollSpeed = abHovered ? 45.f : 0.f;
	buttonData.mfScrollResetDelay = 1.f;
	buttonData.mfScrollStartDelay = 1.f;
	buttonData.mfClipAreaPaddingLeft = OptionMenu_GetScaledSize(15.f).x;
	buttonData.mfClipAreaPaddingRight = OptionMenu_GetScaledSize(15.f).x;
	
	if (abHovered)
		buttonData.mColorBase = gHoverColor;

	/////////////////////////////////////
	// Translate if it's not a quicksave
	ImGui_SetTransCategory("Menu");
	tWString sLabel = bUsed ? cString_To16Char(GetGameModeNameByID(alGameMode)) : cString_To16Char("Empty");
	
	sLabel = _ImGui_GetTextString(cString_To8Char(sLabel));
	if(cLux_GetCurrentImGui().DoButton(asName, sLabel, buttonData, OptionMenu_GetTopLeftOffset(avPos, 1.0), OptionMenu_GetScaledSize(kOptionMenu_SaveSlotTextSize)))
	{
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
		bClicked = true;
	}

	ImGui_SetTransCategory("Menu");
	return bClicked;
}

//-------------------------------------------------------
	
bool OptionMenu_ButtonOptionsToggle(tString asName, cVector2f avPos, int alID, tString asSelected, bool abValue, int alUIActionHorizontal, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1, bool abUseSmallFont=false, bool abActive=true, const tString&in asInfoBoxContent="", const tWString&in asInfoBoxSecondLine=cString_To16Char(""), bool abCustomSettings=false)
{
	float fAlphaMul = (abActive==false) ? 0.5f : 1.f;
	bool bSelected = asSelected == asName;
	
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 72));
	buttonData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = gOptionMenu_ModColor * cColor(1, afAlpha * fAlphaMul);
		
	if (abCustomSettings)
	{
		buttonData.mbClipText = true;
		buttonData.mfScrollSpeed = bSelected ? 45.f : 0.f;
		buttonData.mfScrollResetDelay = 1.f;
		buttonData.mfScrollStartDelay = 1.f;
		buttonData.mfClipAreaPaddingRight = OptionMenu_GetScaledSize(kOptionMenu_SliderSize + cVector2f(gfOptionsMenu_ExtraWidth_Toggle, 0)).x;
	}
	
	if (bSelected) buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	
	//////////////////////////////
	// Check if button was clicked
	if(ImGui_DoButtonExt(asName,asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0),  OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))
	{
		//cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		abValue = !abValue;
		if (abActive == false)
			abValue = true;
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}

	/////////////
	// Check for gamepad input
	if(bSelected && ((alUIActionHorizontal == 1 && abValue == false) || (alUIActionHorizontal ==-1 && abValue == true)))
	{
		//cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		abValue = !abValue;
		if (abActive == false)
			abValue = true;
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}
			
	/////////////////
	// Draw checkbox
	bool bCheckboxValue = abActive ? abValue : false;
	OptionMenu_OptionsCheckbox(avPos+ cVector2f(OptionMenu_GetExtraWidth()-gfOptionsMenu_ExtraWidth_Toggle, kOptionMenu_ButtonSpacing * alID), asSelected == asName, bCheckboxValue, "Off", "On", asName, avRightAnchor, avInfoBoxPos, afAlpha, asInfoBoxContent, asInfoBoxSecondLine, abActive);

	return abValue;
}

//-------------------------------------------------------
	
int OptionMenu_ButtonOptionsMultiSelect(tString asName, cVector2f avPos, int alID, tString asSelected, array<tString> avValues, int alValue, bool abInvert, int alUIActionHorizontal, tString asCategory="Menu", int afExtraSpacingFromLabel=0, cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1, bool abSkipAccept=false, bool abUseSmallFont=false, bool abActive=true, const tString&in asInfoBoxContent="", const tWString&in asInfoBoxSecondLine=cString_To16Char(""), bool abCustomSettings=false, bool abUseInputIcons=false)
{
	if (abActive==false) afAlpha*=0.5f;
	bool bSelected = asSelected == asName;
	
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor =  cColor(1.0, afAlpha) * gOptionMenu_ModColor;
	
	if (abCustomSettings)
	{
		buttonData.mbClipText = true;
		buttonData.mfScrollSpeed = bSelected ? 45.f : 0.f;
		buttonData.mfScrollResetDelay = 1.f;
		buttonData.mfScrollStartDelay = 1.f;
		buttonData.mfClipAreaPaddingRight = OptionMenu_GetScaledSize(kOptionMenu_MultiSize + cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0)).x;
	}
	
	if (bSelected)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
	
	if (abActive==false)
	{
		ImGui_DoButtonExt(asName, asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0), OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y)));
		return alValue;
	}
	
	int lDirection = 0;
	if (ImGui_DoButtonExt(asName, asName, buttonData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0), OptionMenu_GetScaledSize(cVector2f(avRightAnchor.x-avPos.x, kOptionMenu_ButtonSize.y))))
	{
		/////////////////////////////////////////////
		// Select based on which side the mouse was
		//if(ImGui_GetMouseVisible()) 
		if(cLux_GetInputHandler().GetLastDeviceUsed()==eInputDeviceType_Mouse)
		{
			if (mlCurrentDir == 0) 
				lDirection++;
			else 
			{
				lDirection += mlCurrentDir;
				mlCurrentDir = 0;
			}
		}
		else if(abSkipAccept == false)
		{
			lDirection++;
		}

		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}

	////////////
	// Check gamepad input
	int lHorizontalAction = ImGui_GetStateInt(asName + "_HorizontalAction");
	if (bSelected && alUIActionHorizontal != 0)
	{
		lDirection += alUIActionHorizontal;
		lHorizontalAction = alUIActionHorizontal;
		
		Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
	}
	else if (bSelected == false)
	{
		lHorizontalAction = 0;
	}	
	
	ImGui_SetStateInt(asName + "_HorizontalAction", + lHorizontalAction);

	/////////////
	// Wrap data
	if(lDirection != 0)
	{
		if(abInvert) alValue -= lDirection;
		else		 alValue += lDirection;

		alValue = (alValue + avValues.size()) % avValues.size();
	}

	OptionMenu_OptionsMultiSelect(avPos+ cVector2f(OptionMenu_GetExtraWidth()-gfOptionsMenu_ExtraWidth_MultiSelect, kOptionMenu_ButtonSpacing * alID)+cVector2f(afExtraSpacingFromLabel,0), avValues, alValue, asSelected == asName, asCategory, asName, avRightAnchor, avInfoBoxPos, afAlpha, abUseSmallFont, abActive, asInfoBoxContent, asInfoBoxSecondLine, abCustomSettings, abUseInputIcons);
	
	return alValue;
}

//-------------------------------------------------------

int OptionMenu_ButtonOptionsMultiSelectSlider(tString asName, cVector2f avPos, int alID, tString asSelected,  array<tString> avValues, int alValue, int alUIActionHorizontal, tString asTextValue="", tString asTextValueTransCat="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1, bool abUseSmallFont=false, bool abActive=true, const tString&in asInfoBoxContent="", const tWString&in asInfoBoxSecondLine=cString_To16Char(""), bool abCustomSettings=false)
{
	if (avValues.size() == 0) return 0;
	if (abActive==false) afAlpha *= 0.5f;
	
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = cColor(1, afAlpha) * gOptionMenu_ModColor;
	if (asSelected == asName)
		buttonData.mFont.mColor = gHoverColor * buttonData.mFont.mColor;
		
	if (abCustomSettings)
	{
		buttonData.mbClipText = true;
		buttonData.mfScrollSpeed = asSelected == asName ? 45.f : 0.f;
		buttonData.mfScrollResetDelay = 1.f;
		buttonData.mfScrollStartDelay = 1.f;
		buttonData.mfClipAreaPaddingRight = OptionMenu_GetScaledSize(kOptionMenu_SliderSize + cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0)).x;
	}
	
	cVector2f vRealPos = avPos;
	vRealPos.x += OptionMenu_GetExtraWidth();
	
	int lMaxNum = avValues.size()-1;
	float fValue = float(alValue) / float(lMaxNum);
	float fStepSize = (lMaxNum > 0.f) ? float(1.f / lMaxNum) : 0.f;
	
	fValue = OptionMenu_OptionsSlider(avPos, vRealPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), fValue, alID, fStepSize, alUIActionHorizontal, buttonData, asTextValue, asSelected == asName, asTextValueTransCat, asName, avRightAnchor, avInfoBoxPos, true, afAlpha, abUseSmallFont, abActive, abCustomSettings, asInfoBoxContent, asInfoBoxSecondLine);
	int lMappedValue = cMath_RoundToInt(fValue * lMaxNum);
	
	return lMappedValue;
}

//-------------------------------------------------------

float OptionMenu_ButtonOptionsSlider(tString asName, cVector2f avPos, int alID, tString asSelected, float afValue, float afStepSize, int alUIActionHorizontal, tString asTextValue="", tString asTextValueTransCat="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1, bool abUseSmallFont=false, bool abActive=true, bool abCustomSettings=false, bool abSnap = false)
{
	if (abActive==false) afAlpha *= 0.5f;
	
	/////////////////////////////////////
	//Button setup
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor = cColor(1, afAlpha) * gOptionMenu_ModColor;
	if (asSelected == asName) buttonData.mFont.mColor = gHoverColor * buttonData.mFont.mColor;
	
	cVector2f vRealPos = avPos;
	vRealPos.x += OptionMenu_GetExtraWidth();
	
	///////////////
	// Repeat or normal button?
	//cVector2f vSliderMin = kOptionMenu_SliderMin;
	//cVector2f vSliderMax = kOptionMenu_SliderMax;
	
	float fValue = OptionMenu_OptionsSlider(avPos, vRealPos+ cVector2f(0, kOptionMenu_ButtonSpacing * alID), afValue, alID, afStepSize, alUIActionHorizontal, buttonData, asTextValue, asSelected == asName, asTextValueTransCat, asName, avRightAnchor, avInfoBoxPos, abSnap, afAlpha, abUseSmallFont, abActive, abCustomSettings);

	return fValue;
}

//-------------------------------------------------------

void OptionMenu_ShowGamepadButtons(bool abShowArrows, bool abShowCancel = true, cVector2f avOffset = cVector2f(0), bool abShowAccept=true)
{
	if(cLux_GetInputHandler().IsGamepadConnected() == false) return;
	if(cLux_GetInputHandler().GetGamepadWasLastDeviceUsed() == false) return;

	////////////
	// Buttons
	eGamepadProfile connectedGamepadProfile = Input_GetCurrentGamepadProfile();
	tString sButtonAccept, sButtonBack;
	cColor colButtonAccept, colButtonBack;

	if(connectedGamepadProfile == eGamepadProfile_PS4)
	{
		sButtonAccept = "startmenu_button_x";
		colButtonAccept = cColor(0.42,0.54,0.78,1);
	
		sButtonBack = "startmenu_button_circle";
		colButtonBack = cColor(1,0.4,0.4,1);
	}
	else 
	{
		sButtonAccept = "startmenu_button_xbox_A";
		colButtonAccept = cColor(0,0.8,0.4,1);
	
		sButtonBack = "startmenu_button_xbox_B";
		colButtonBack = cColor(1,0.4,0.4,1);
	}
	
	tString sButtonA = Platform_IsPlayStation() ? "startmenu_button_x" : "startmenu_button_xbox_A";
	tString sButtonB = Platform_IsPlayStation() ? "startmenu_button_circle" : "startmenu_button_xbox_B";
	
	cColor colButtonA = Platform_IsPlayStation() ? cColor(0.42,0.54,0.78,1) : cColor(0,0.8,0.4,1);
	cColor colButtonB = Platform_IsPlayStation() ? cColor(1,0.4,0.4,1) : cColor(1,0.4,0.4,1);

	//cImGuiGfx gfxConfirm(sButtonA);
	//cImGuiGfx gfxCancel(sButtonB);
	cImGuiGfx gfxConfirm(sButtonAccept);
	cImGuiGfx gfxCancel(sButtonBack);
	cImGuiGfx gfxArrows("startmenu_button_direction2");

	/////////////
	// Text
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_GamepadPrompt, 56));
	labelData.mFont.mvSize = gfFontSize_GamepadPrompts;
	labelData.mFont.mColor = cColor(1,1);
	
	float fX = 50;
	float fXOffset = 0;
	float fY = 63;
	
	if (abShowAccept)
	{
		ImGui_DoLabelExt("Accept",labelData, OptionMenu_GetBotLeftOffset(cVector2f(fX+fXOffset, fY) + avOffset, 10.0));
		fXOffset += GetFontLengthW(labelData.mFont, 1, ImGui_TranslatePlatformSpecific("Accept"));
		ImGui_DrawGfx(gfxConfirm, OptionMenu_GetBotLeftOffset(cVector2f(fX-8+fXOffset, 70) + avOffset, 10.5), OptionMenu_GetScaledSize(36), colButtonAccept);
		fXOffset += 37;
	}

	if(abShowCancel)
	{
		ImGui_DoLabelExt("Cancel",labelData, OptionMenu_GetBotLeftOffset(cVector2f(fX+fXOffset, fY) + avOffset, 10.0));
		fXOffset += GetFontLengthW(labelData.mFont, 1, ImGui_TranslatePlatformSpecific("Cancel"));
		ImGui_DrawGfx(gfxCancel, OptionMenu_GetBotLeftOffset(cVector2f(fX-8+fXOffset, 70) + avOffset, 10.5), OptionMenu_GetScaledSize(36), colButtonBack);
		fXOffset += 37;
	}

	if(abShowArrows)
	{
		ImGui_DoLabelExt("Select",labelData, OptionMenu_GetBotLeftOffset(cVector2f(fX+fXOffset, fY) + avOffset, 10.0));
		fXOffset += GetFontLengthW(labelData.mFont, 1, ImGui_TranslatePlatformSpecific("Select"));
		ImGui_DrawGfx(gfxArrows, OptionMenu_GetBotLeftOffset(cVector2f(fX-18+fXOffset, 85) + avOffset, 10.5), OptionMenu_GetScaledSize(72), cColor(1,1));
	}
}

//------------------------------------------------------- 

void OptionMenu_SectionTitle(tString asTitle, cVector2f avPos)
{
	/////////////
	// Text
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,92));
	labelData.mFont.mvSize = cVector2f(84, 84);
	labelData.mFont.mColor = cColor(1,1);
	labelData.mFontAlign = eFontAlign_Right;

	ImGui_DoLabelExt(asTitle,labelData, OptionMenu_GetTopLeftOffset(avPos + cVector2f(0, -8), 1.0), OptionMenu_GetScaledSize(cVector2f(190, 72)));

	////////////
	// Borders
	cImGuiGfx border;

	float fSize = GetFontLengthW(labelData.mFont, 1.0f, _ImGui_GetTextString(asTitle)) + 18;
	
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5), cVector2f(10, 90), cColor(1,1));
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5) - cVector3f(fSize, 0, 0), cVector2f(fSize, 10), cColor(1,1));
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5) - cVector3f(fSize,-80, 0), cVector2f(fSize, 10), cColor(1,1));
	ImGui_DrawGfx(border, OptionMenu_GetTopLeftOffset(avPos + cVector2f(193, -13), 10.5) - cVector3f(fSize,0, 0), cVector2f(10, 90), cColor(1,1));
}

