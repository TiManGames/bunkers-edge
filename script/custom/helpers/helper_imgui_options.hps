void OptionMenu_SetModColor(const cColor &in aCol)
{
	gOptionMenu_ModColor = aCol;
}

// Scaling
float gfOptionsMenu_ExtraWidth = 0;
float gfOptionsMenu_ExtraWidth_Toggle = 0;
float gfOptionsMenu_ExtraWidth_MultiSelect = 0;
float gfOptionsMenu_ExtraWidth_Slider = 0;
float gfOptionsMenu_ExtraWidth_Keybind = 0;

void OptionMenu_UpdateButtonWidth(const tString &in asButton, float afMaxWidth = -1.f)
{
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
		
	float fWidth = GetFontLengthW(font, 1, ImGui_TranslatePlatformSpecific(asButton));
	//cLux_AddDebugMessage(asButton+" Width: "+fWidth+" - ExtraWidth: "+gfOptionsMenu_ExtraWidth);
	if (fWidth > gfOptionsMenu_ExtraWidth)
		gfOptionsMenu_ExtraWidth = fWidth;
		
	if (afMaxWidth > 0.f)
	{
		if (gfOptionsMenu_ExtraWidth > afMaxWidth)
			gfOptionsMenu_ExtraWidth = afMaxWidth;
	}
}

//------------------------------------------------------- 

void OptionMenu_UpdateExtraButtonWidth_Toggle()
{
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
	float fMax = OptionMenu_GetScaledSize(60).x;
	
	float fOnWidth = GetFontLengthW(font, 1, ImGui_TranslatePlatformSpecific("On"));
	if (fOnWidth > fMax && (fOnWidth-fMax) > gfOptionsMenu_ExtraWidth_Toggle)
		gfOptionsMenu_ExtraWidth_Toggle = (fOnWidth-fMax);
	float fOffWidth = GetFontLengthW(font, 1, ImGui_TranslatePlatformSpecific("Off"));
	if (fOffWidth > fMax && (fOffWidth-fMax) > gfOptionsMenu_ExtraWidth_Toggle)
		gfOptionsMenu_ExtraWidth_Toggle = (fOffWidth-fMax);
}

//------------------------------------------------------- 

void OptionMenu_UpdateKeybindExtraWidth(const tString &in asPrimary, const tString &in asSecondary)
{
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
	
	float fWidth = cMath_Max(GetFontLengthW(font, 1, asPrimary),GetFontLengthW(font, 1, asSecondary));
	//cLux_AddDebugMessage("STRING: "+asPrimary+" - WIDTH: "+fWidth+" - EXTRA: "+gfOptionsMenu_ExtraWidth_Keybind+" - CHECK: "+OptionMenu_GetScaledSize(kOptionMenu_CheckboxSize).x);
	if (fWidth > OptionMenu_GetScaledSize(kOptionMenu_CheckboxSize).x)
		gfOptionsMenu_ExtraWidth_Keybind = cMath_Clamp(fWidth-OptionMenu_GetScaledSize(kOptionMenu_CheckboxSize).x + 60.f, 0, 80);
}

//------------------------------------------------------- 

void OptionMenu_UpdateToggleExtraWidth()
{
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
	
	float fWidth = cMath_Max(GetFontLengthW(font, 1, ImGui_Translate("On")),GetFontLengthW(font, 1, ImGui_Translate("Off")));
	
	if (fWidth > OptionMenu_GetScaledSize(kOptionMenu_CheckboxSize).x)
		gfOptionsMenu_ExtraWidth_Toggle = fWidth - OptionMenu_GetScaledSize(kOptionMenu_CheckboxSize).x + 60.f;
}

//-------------------------------------------------------

void OptionMenu_AlignExtraButtonWidth()
{
	//cLux_AddDebugMessage("TOGGLE: "+gfOptionsMenu_ExtraWidth_Toggle+" - MULTI: "+gfOptionsMenu_ExtraWidth_MultiSelect);
	
	if (gfOptionsMenu_ExtraWidth_Toggle > gfOptionsMenu_ExtraWidth_MultiSelect) 
		gfOptionsMenu_ExtraWidth_MultiSelect = gfOptionsMenu_ExtraWidth_Toggle;
	else if (gfOptionsMenu_ExtraWidth_MultiSelect > gfOptionsMenu_ExtraWidth_Toggle)
		gfOptionsMenu_ExtraWidth_Toggle = gfOptionsMenu_ExtraWidth_MultiSelect;
}

//------------------------------------------------------- 

void OptionMenu_UpdateExtraButtonWidth_MultiSelection(const array<tString> &in avValues, const tString &in asCategory="Menu")
{
	ImGui_SetTransCategory(asCategory);
	
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
	
	float fMax = OptionMenu_GetScaledSize(200).x;
	
	for (uint i = 0; i < avValues.length(); i++)
	{
		float fWidth = GetFontLengthW(font, 1, ImGui_TranslatePlatformSpecific(avValues[i]));
		if (fWidth > fMax && (fWidth-fMax) > gfOptionsMenu_ExtraWidth_MultiSelect)
			gfOptionsMenu_ExtraWidth_MultiSelect = (fWidth-fMax);
	}
	
	ImGui_SetTransCategory("Menu");
}

//------------------------------------------------------- 

void OptionMenu_UpdateMultiSelectionExtraWidth(const array<tString> &in avValues, const tString &in asCategory="Menu", 
											   const cVector2f &in avSize=gfFontSize_MainMenu, float afMaxWidth = -1.f)
{
	// LATEST 
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
	ImGui_SetTransCategory(asCategory);
	
	for (uint i = 0; i < avValues.length(); i++)
	{
		float fWidth = GetFontLengthW(font, 1.0, ImGui_TranslatePlatformSpecific(avValues[i]));
		if (fWidth > (kOptionMenu_MultiSize.x)-40)
			gfOptionsMenu_ExtraWidth_MultiSelect = fWidth - (kOptionMenu_MultiSize.x) + 80.f;
	}

	if (afMaxWidth > 0.f)
	{
		if (gfOptionsMenu_ExtraWidth_MultiSelect > afMaxWidth)
			gfOptionsMenu_ExtraWidth_MultiSelect = afMaxWidth;
	}

	ImGui_SetTransCategory("Menu");
}

//------------------------------------------------------- 

void OptionMenu_UpdateSliderExtraWidth(const array<tString> &in avValues, const tString &in asCategory="Menu")
{
	cImGuiFont font;
	font.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	font.mvSize = gfFontSize_MainMenu;
	ImGui_SetTransCategory(asCategory);
	
	for (uint i = 0; i < avValues.length(); i++)
	{
		float fWidth = GetFontLengthW(font, 1, ImGui_TranslatePlatformSpecific(avValues[i]));
		
		if (fWidth > OptionMenu_GetScaledSize(kOptionMenu_SliderSize).x-40)
			gfOptionsMenu_ExtraWidth_Slider = fWidth-OptionMenu_GetScaledSize(kOptionMenu_SliderSize).x + 80.f;
	}
	ImGui_SetTransCategory("Menu");
}

//------------------------------------------------------- 

float OptionMenu_GetExtraWidth()
{
	return gfOptionsMenu_ExtraWidth + cMath_Max(gfOptionsMenu_ExtraWidth_MultiSelect, gfOptionsMenu_ExtraWidth_Toggle);
}

//------------------------------------------------------- 

void OptionMenu_ResetExtraWidth()
{
	gfOptionsMenu_ExtraWidth = 0;
	gfOptionsMenu_ExtraWidth_Toggle = 0;
	gfOptionsMenu_ExtraWidth_MultiSelect = 0;
	gfOptionsMenu_ExtraWidth_Keybind = 0;
}

//-------------------------------------------------------

cVector3f OptionMenu_GetTopLeftOffset(cVector2f avPos, float aZ = 0.0)
{
	cVector2f vRealPos = OptionMenu_GetOffsetPosHelper(avPos);
	return cVector3f(vRealPos.x, vRealPos.y, aZ+20.0);
}

//------------------------------------------------------- 

cVector3f OptionMenu_GetBotLeftOffset(cVector2f avPos, float aZ = 0.0)
{
	cVector2f vRealPos = OptionMenu_GetOffsetPosHelper(avPos);
	cVector2f vSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize();
	return cVector3f(vRealPos.x, vSize.y - vRealPos.y, aZ+20.0);
}

//------------------------------------------------------- 

cVector3f OptionMenu_GetTopRightOffset(cVector2f avPos, float aZ = 0.0)
{
	cVector2f vRealPos = OptionMenu_GetOffsetPosHelper(avPos);
	cVector2f vSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize();
	return cVector3f(vRealPos.x + vSize.x, vRealPos.y, aZ+20.0);
}

//------------------------------------------------------- 

cVector3f OptionMenu_GetBotRightOffset(cVector2f avPos, float aZ = 0.0)
{
	cVector2f vRealPos = OptionMenu_GetOffsetPosHelper(avPos);
	cVector2f vSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize();
	return cVector3f(vRealPos.x + vSize.x, vSize.y - vRealPos.y, aZ+20.0);
}

//------------------------------------------------------- 

cVector3f OptionMenu_GetCenterOffset(cVector2f avPos, float aZ = 0.0)
{
	cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
	cVector2f vRealPos = OptionMenu_GetOffsetPosHelper(avPos) + pSet.GetVirtualSize()*0.5f;
	return cVector3f(vRealPos.x, vRealPos.y, aZ+20.0);
}

//------------------------------------------------------- 

cVector2f OptionMenu_GetOffsetPosHelper(const cVector2f &in avPos)
{
	cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
	cVector2f vSize = pSet.GetVirtualSize();
	cVector2f vOffset = pSet.GetVirtualSizeOffset();
	cVector2f vAspectRatio = cGraphics_GetLowLevel().GetScreenSizeFloat();
	vAspectRatio /= vAspectRatio.y;
	
	return vSize * avPos / (vAspectRatio * 720.0) - vOffset;
}

//------------------------------------------------------- 

cVector2f OptionMenu_GetScaledSize(cVector2f avSize)
{
	cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
	cVector2f vSize = pSet.GetVirtualSize();
	cVector2f vAspectRatio = cGraphics_GetLowLevel().GetScreenSizeFloat();
	vAspectRatio /= vAspectRatio.y;

	return avSize * vSize / (vAspectRatio * 720.0);
}

//-------------------------------------------------------

bool OptionMenu_GetMouseInsideSliderArrow(cVector2f avMin, cVector2f avMax)
{
	if (ImGui_GetModUseInput() == false)
		return false;

	cVector3f vMin = OptionMenu_GetTopLeftOffset(avMin, 1.5);
	cVector3f vMax = OptionMenu_GetTopLeftOffset(avMax, 1.5);
	cVector2f vMousePos = ImGui_GetMousePosition();
	
	//cLux_AddDebugMessage("MIN: "+vMin+" - MAX: "+vMax+" - MOUSE: "+vMousePos);
		
	vMousePos.x = (vMousePos.x - vMin.x) / (vMax.x - vMin.x);

	if(vMousePos.x >= 0 && vMousePos.x <= 1)
	{
		return true;
	}

	return false;
}

//-------------------------------------------------------

int mlLastDir = 0;

int OptionMenu_GetMouseInsideMultiSelectArrows(cVector3f avPos, cVector2f avSize)
{
	if (ImGui_GetModUseInput() == false)
		return 0;

	int lArrow = 0;
	
	cVector2f vMousePos = ImGui_GetMousePosition();
	
	if (vMousePos.x >= avPos.x && vMousePos.x <= avPos.x+avSize.x/2) lArrow = -1;
	else if (vMousePos.x > avPos.x+avSize.x/2 && vMousePos.x <= avPos.x+avSize.x) lArrow = 1;
		
	mlCurrentDir = lArrow;
	
	if (mlCurrentDir != mlLastDir)
	{
		//cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		mlLastDir = mlCurrentDir;
	}
		
	return lArrow;
}

//-------------------------------------------------------

int OptionMenu_GetMouseInsideSliderArrowsNew(cVector3f avLeft, cVector3f avRight, cVector2f avSize)
{
	///////////////////////////////////////////
	// -1 = left, 1 = right, 0 = not hovering
	if(ImGui_GetModUseInput() == false)
		return 0;

	int lArrow = 0;
	float fMargin = 5;
	cVector2f vMousePos = ImGui_GetMousePosition();

	if (vMousePos.y < avLeft.y || vMousePos.y > avLeft.y+avSize.y) return 0;
	
	if (vMousePos.x >= avLeft.x-fMargin && vMousePos.x <= avLeft.x+avSize.x+fMargin) lArrow = -1;
	else if (vMousePos.x >= avRight.x-fMargin && vMousePos.x <= avRight.x+avSize.x+fMargin) lArrow = 1;
	
	//cLux_AddDebugMessage("ARROW: "+lArrow);
	
	mlCurrentDir = lArrow;
	
	if (mlCurrentDir != mlLastDir && mlCurrentDir != 0)
	{
		//cLux_AddTodoMessage("Sound: Menu toggle button pressed");
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		mlLastDir = mlCurrentDir;
	}
	
	return lArrow;
}

//-------------------------------------------------------

cVector2f OptionMenu_GetMouseInsideSlider(cVector2f avMin, cVector2f avMax)
{
	if (ImGui_GetModUseInput() == false)
		return -1.0;

	cVector2f vMousePos = ImGui_GetMousePosition();
		
	vMousePos.x = (vMousePos.x - avMin.x) / (avMax.x - avMin.x);
	vMousePos.y = (vMousePos.y - avMin.y) / (avMax.y - avMin.y);

	if(vMousePos.y >= 0 && vMousePos.y <= 1 &&
		vMousePos.x >= 0 && vMousePos.x <= 1)
	{
		return vMousePos;
	}

	return -1.0;
}

//------------------------------------------------------- 

int OptionMenu_GetMouseInsideSliderArrows(cVector2f avPos)
{
	if (ImGui_GetModUseInput() == false)
		return 0;

	///////////////////////////////////////////
	// -1 = left, 1 = right, 0 = not hovering
	
	int lArrow = 0;
	
	if (OptionMenu_GetMouseInsideSliderArrow(avPos+cVector2f(kOptionMenu_SliderArrowOffsetL.x-40,0), avPos+cVector2f(kOptionMenu_SliderArrowOffsetL.x+20,1))) lArrow = -1;
	else if (OptionMenu_GetMouseInsideSliderArrow(avPos+cVector2f(kOptionMenu_SliderArrowOffsetR.x-40,0), avPos+cVector2f(kOptionMenu_SliderArrowOffsetR.x+60,1))) lArrow = 1;
	
	return lArrow;
}

//------------------------------------------------------- 

cVector2f OptionMenu_GetMouseInside(cVector2f avMin, cVector2f avMax)
{
	if (ImGui_GetModUseInput() == false)
		return -1.0;

	cVector3f vMin = OptionMenu_GetTopLeftOffset(avMin, 1.5);
	cVector3f vMax = OptionMenu_GetTopLeftOffset(avMax, 1.5);
	cVector2f vMousePos = ImGui_GetMousePosition();
		
	vMousePos.x = (vMousePos.x - vMin.x) / (vMax.x - vMin.x);
	vMousePos.y = (vMousePos.y - vMin.y) / (vMax.y - vMin.y);

	if(vMousePos.y >= 0 && vMousePos.y <= 1 &&
		vMousePos.x >= 0 && vMousePos.x <= 1)
	{
		return vMousePos;
	}

	return -1.0;
}

//------------------------------------------------------- 

tString OptionMenu_UpdateFocus(tString asID, tString asSelector)
{	
	if (ImGui_PrevBecameInFocus())
	{
		Sound_PlayGui("special_fx/frontend/frontend_menu_focus", 1.0f, eSoundEntryType_Gui);
		return asID;
	}
	//cLux_AddDebugMessage("SELECTOR:"+asSelector);
	return asSelector;
}

//-------------------------------------------------------

void OptionMenu_OptionsCheckbox(cVector2f avPos, bool abIsSelected, bool abIsChecked, tString asOffText = "Off", tString asOnText="On", const tString &in asName="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1, const tString&in asInfoBoxContent="", const tWString&in asInfoBoxSecondLine=cString_To16Char(""), bool abActive = true)
{
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,3);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	
	cVector2f vButtonSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_MultiSize + cVector2f(gfOptionsMenu_ExtraWidth_Toggle, 0));
	cVector3f vButtonLeftPosNrm = cVector3f(vRightAnchorNrm.x - vButtonSizeNrm.x, vPosNrm.y + 5, vPosNrm.z);
	
	tString sTickboxImg = abIsChecked ? "startmenu_options_tickbox_true" : "startmenu_options_tickbox_false";
	cImGuiGfx gfxTickbox(sTickboxImg);
	vButtonSizeNrm.y *= 0.65;
	
	float fAlphaMul = abActive ? 1.f : 0.5f;
	cColor tickboxColor = cColor(1, afAlpha * fAlphaMul) * gOptionMenu_ModColor;
	if (abIsSelected)
		tickboxColor = gHoverColor * tickboxColor;
	ImGui_DrawGfx(gfxTickbox, vButtonLeftPosNrm + cVector3f(14,0,1), vButtonSizeNrm.y, tickboxColor);
	
	/////////////
	// Info
	if (abIsSelected)
	{
		tString sInfoBox = asInfoBoxContent;
		if (sInfoBox=="") sInfoBox = asName+"_Info";
		cVector3f vInfoBoxPos = OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_TextedSliderTextOffset + cVector2f(kOptionMenu_TextedSliderSize.x,0), 0) + OptionMenu_GetTopLeftOffset(kOptionMenu_InfoBoxBgOffset);
		OptionMenu_InfoBox("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, sInfoBox, afAlpha, asInfoBoxSecondLine);
	}
}

//-------------------------------------------------------

tString sSliderActive = "";
	
float OptionMenu_OptionsSlider(cVector2f avMainPos, cVector2f avPos, float afValue, int alID, float afStepSize, int alUIActionHorizontal, cImGuiButtonData aButtonData, tString asTextValue, bool abSelected, tString asTextValueTransCat="", const tString &in asName="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, bool abSnap=false, float afAlpha=1, bool abUseSmallFont=false, bool abActive=true, bool abCustomSettings=false, const tString&in asInfoBoxContent="", const tWString&in asInfoBoxSecondLine=cString_To16Char(""))
{
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	cVector3f vLeftAnchorNrm = OptionMenu_GetTopLeftOffset(avMainPos + cVector2f(0, kOptionMenu_ButtonSpacing * alID), 1.0);
	
	if (abActive==false)
	{
		ImGui_DoRepeatButtonExt(asName,asName, aButtonData, vLeftAnchorNrm+cVector3f(0,0,0), cVector2f(vRightAnchorNrm.x-vLeftAnchorNrm.x,kOptionMenu_ButtonSize.y));
		return afValue;
	}
	
	bool bTexted = asTextValue.length() > 0;
	float fLabelWidth = (bTexted) ? 24 : 0;
	
	cImGuiGfx gfxArrow("startmenu_options_arrow");
	cImGuiGfx gfxBar;
	
	///////////////////////////////
	// Absolute left of the entire row left
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,1);	
	
	cVector2f vButtonAreaSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderSize+cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0));
	cVector3f vButtonAreaPosNrm = cVector3f(vRightAnchorNrm.x-vButtonAreaSizeNrm.x,vPosNrm.y, vPosNrm.z);
	cVector3f vArrowLeftPosNrm = cVector3f(vButtonAreaPosNrm.x+8,vButtonAreaPosNrm.y-5,vPosNrm.z+2);
	cVector3f vArrowRightPosNrm = cVector3f(vButtonAreaPosNrm.x + vButtonAreaSizeNrm.x - OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize).x + 10 - fLabelWidth, vButtonAreaPosNrm.y - 4, vPosNrm.z + 2);
	cVector2f vArrowSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize);
	cVector2f vArrowHoverSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverUnderlineSize);
	
	////////////////////
	// Interaction Area
	cVector2f vSliderMin = cVector2f(vArrowLeftPosNrm.x + vArrowSizeNrm.x);
	cVector2f vSliderMax = cVector2f(vArrowRightPosNrm.x);
	
	cVector2f vVal = OptionMenu_GetMouseInsideSlider(vSliderMin - cVector2f(0, 1024), vSliderMax + cVector2f(0, 1024));
	float fVal = vVal.x;

	if(fVal != -1)
	{
		////////////////////////////////////
		// Repeat button if it is being clicked
		if(ImGui_DoRepeatButtonExt(asName,asName, aButtonData, vLeftAnchorNrm+cVector3f(0,0,100), cVector2f(vRightAnchorNrm.x-vLeftAnchorNrm.x,kOptionMenu_ButtonSize.y)))
		{
			sSliderActive = asName;
			cLux_GetCurrentImGui().LockMouseFocus();
			
			////////////////////
			// Any value changes?
			float fStep = abSnap ? afStepSize*0.9 : 0.001f;
			if(cMath_Abs(fVal-afValue) > fStep)
			{
				afValue = fVal;
				if (ImGui_TimerExists("SliderDelay") == false)
				{
					Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
					ImGui_AddTimer("SliderDelay", 0.08f);
				}					
			}
		}
	}
	else
	{
		////////////////////////////////////////
		// Snap to min-max when out of boundaries
		if (sSliderActive == asName)
		{
			if (ImGui_ActionIsDown(eImGuiAction_MouseLeft) == false)
			{
				cLux_AddDebugMessage("RELEASE");
				sSliderActive = "";
			}
			else
			{
				cLux_GetCurrentImGui().LockMouseFocus();
				afValue = (afValue <= 0.5) ? 0 : 1;
			}
		}
		
		/////////////////
		// Normal button
		if(ImGui_DoButtonExt(asName,asName, aButtonData, vLeftAnchorNrm, cVector2f(vRightAnchorNrm.x-vLeftAnchorNrm.x,kOptionMenu_ButtonSize.y)))
		{
			// Select based on which side the mouse was
			if(ImGui_GetMouseVisible()) 
			{
				fVal = cMath_Clamp(afValue + afStepSize*mlCurrentDir, 0.0f, 1.0f);
			}
			
			if(afValue != fVal && fVal != -1)
			{
				afValue = fVal;
				if (ImGui_TimerExists("SliderDelay") == false)
				{
					Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
					ImGui_AddTimer("SliderDelay", 0.08f);
				}
			}
		}
	}

	///////////
	// Gamepad input
	int lHorizontalAction = ImGui_GetStateInt(asName + "_HorizontalAction");
	if (abSelected)
	{
		afValue += alUIActionHorizontal * afStepSize;

		if(alUIActionHorizontal != 0)
		{
			lHorizontalAction = alUIActionHorizontal;
			
			if (ImGui_TimerExists("SliderDelay") == false)
			{
				Sound_PlayGui("special_fx/frontend/frontend_menu_slider", 1.0f, eSoundEntryType_Gui);
				ImGui_AddTimer("SliderDelay", 0.08f);
			}
		}
	}
	else
	{
		lHorizontalAction = 0;
	}
	
	ImGui_SetStateInt(asName + "_HorizontalAction", + lHorizontalAction);

	/////////////
	// Clamp
	afValue = cMath_Clamp(afValue, 0.0, 1.0);
	
	int lHoveredArrow = 0;	
	if (abSelected)
	{
		int lLastInputDevice = cLux_GetInputHandler().GetLastDeviceUsed();
		if (lLastInputDevice == eInputDeviceType_Gamepad ||
			lLastInputDevice == eInputDeviceType_Keyboard)
		{
			int lHorizontalAction = ImGui_GetStateInt(asName + "_HorizontalAction");
			if (lHorizontalAction != 0)
				lHoveredArrow = lHorizontalAction;
		}
		else
		{
			lHoveredArrow = OptionMenu_GetMouseInsideSliderArrowsNew(vArrowLeftPosNrm, vArrowRightPosNrm, vArrowSizeNrm);
		}
	}
	
	bool bHighlightArrows = lHoveredArrow != 0;
	cColor arrowColor_L = cColor(1,afAlpha);
	cColor arrowColor_R = cColor(1,afAlpha);
	
	if (bHighlightArrows)
	{
		if (lHoveredArrow == -1)
			arrowColor_L = gHoverColor * cColor(1, afAlpha);
		else
			arrowColor_R = gHoverColor * cColor(1, afAlpha);
	}
	
	//////////////////////
	// Slider with text
	gfxBar.mColor = abSelected ? gHoverColor * cColor(1, afAlpha) : cColor(1,afAlpha);
	
	if (bTexted)
	{
		//////////////
		// Draw text at the end
		cImGuiLabelData labelData;
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
		labelData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
		labelData.mFont.mColor = gOptionMenu_ModColor * cColor(1,afAlpha);
		if (abSelected) labelData.mFont.mColor = gHoverColor * labelData.mFont.mColor;
		labelData.mFontAlign = eFontAlign_Left;
		labelData.mbScrolling = true;
		labelData.mfScrollSpeed = abSelected ? 45.f : 0.f;
		labelData.mfScrollStartDelay = 1.f;
		labelData.mfScrollResetDelay = 1.f;
		ImGui_SetTransCategory(asTextValueTransCat);
		ImGui_DoLabelExt(asTextValue,labelData, vButtonAreaPosNrm+cVector3f(vButtonAreaSizeNrm.x-fLabelWidth,8,0), cVector2f(180, -1));
		ImGui_SetTransCategory("Menu");
			
		/////////////
		// Draw arrows
		ImGui_SetModRotateAngle(180);
		gfxArrow.mColor = arrowColor_L;
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, vArrowSizeNrm, cColor(1,afAlpha) * gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(0.0);
		gfxArrow.mColor = arrowColor_R;
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, vArrowSizeNrm, cColor(1,afAlpha) * gOptionMenu_ModColor);

		//////////////
		// Draw bar
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x, (vPosNrm.y + vButtonAreaSizeNrm.y/2) - 5, vArrowLeftPosNrm.z), cVector2f(vSliderMax.x - vSliderMin.x, 5), gOptionMenu_ModColor * cColor(1,afAlpha));
		cColor sliderPointerColor = cColor(1,afAlpha) * cColor(gOptionMenu_ModColor.a, 1);
		float fPointerWidth = 8;
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x - fPointerWidth/2 + afValue*(vSliderMax.x - vSliderMin.x), vPosNrm.y + 8,vArrowLeftPosNrm.z), OptionMenu_GetScaledSize(cVector2f(fPointerWidth, 16)), sliderPointerColor);
	}
	else
	{
		/////////////
		// Draw arrows
		ImGui_SetModRotateAngle(180);
		gfxArrow.mColor = arrowColor_L;
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, vArrowSizeNrm, cColor(1,afAlpha) * gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(0.0);
		gfxArrow.mColor = arrowColor_R;
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, vArrowSizeNrm, cColor(1,afAlpha) * gOptionMenu_ModColor);
		
		//////////////
		// Draw bar
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x, (vPosNrm.y + vButtonAreaSizeNrm.y/2) - 5, vArrowLeftPosNrm.z), cVector2f(vSliderMax.x - vSliderMin.x, 5), gOptionMenu_ModColor * cColor(1,afAlpha));
		cColor sliderPointerColor = cColor(1,afAlpha) * cColor(gOptionMenu_ModColor.a, 1);
		float fPointerWidth = 8;
		ImGui_DrawGfx(gfxBar, cVector3f(vSliderMin.x - fPointerWidth/2 + afValue*(vSliderMax.x - vSliderMin.x), vPosNrm.y + 8, vArrowLeftPosNrm.z), OptionMenu_GetScaledSize(cVector2f(6, 16)), sliderPointerColor);
	}
	
	if (abSelected)
	{
		////////////////
		// InfoBox
		tString sInfoBox = asInfoBoxContent;
		if (sInfoBox=="") sInfoBox = asName+"_Info";
		
		float fInfoBoxPosY = ImGui_GetStateFloat("CustomInfoBoxPosYAdd", 0.f);
		cVector3f vInfoBoxPos = OptionMenu_GetTopLeftOffset(avPos + kOptionMenu_TextedSliderTextOffset + cVector2f(kOptionMenu_TextedSliderSize.x, fInfoBoxPosY), 0) + OptionMenu_GetTopLeftOffset(kOptionMenu_InfoBoxBgOffset);
		OptionMenu_InfoBox("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, sInfoBox, afAlpha, asInfoBoxSecondLine);
	}
	
	return afValue;
}

//------------------------------------------------------- 

void OptionMenu_InfoBox(tString asGfx, cVector3f avPos, cVector2f avSize, const tString &in asText, float afAlpha=1, const tWString&in asSecondLine=cString_To16Char(""))
{
	if (cLux_HasTranslation("Menu",asText) == false) return;
	
	float fClampedSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize().x-cLux_GetCurrentImGui().GetSet().GetVirtualSizeOffset().x-60-avPos.x;
	cVector3f vPos = avPos;
	cVector2f vSize = cVector2f(cMath_Min(avSize.x,fClampedSize),avSize.y);
		
	cImGuiTextFrameData textData = ImGui_GetDefaultTextFrame();
	textData.mbUseBackgroundGfx = false;
	textData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu_InfoBox,56));
	textData.mFont.mvSize = cVector2f(gfFontSize_InfoBox);
	textData.mFont.mColor = cColor(1, afAlpha) * gOptionMenu_ModColor;
	textData.mFontAlign = eFontAlign_Left;
	
	array<tWString> vLines;
	GetFontWordWrapRows(textData.mFont, 1, asText, vSize.x, vLines);
	
	bool bHasSecondLine = asSecondLine != cString_To16Char("");
	
	const float fTextVertSpacing = 12;
	int lLinesCount = vLines.length();
	
	const float fLineHeight = (textData.mFont.mvSize.y + fTextVertSpacing);
	const float fTextHeight = fLineHeight * lLinesCount;
	float fBkgHeight = fTextHeight + fTextVertSpacing + 20;
	
	if (bHasSecondLine)
	{
		array<tWString> vSecondLineLines;
		GetFontWordWrapRowsW(textData.mFont, 1, asSecondLine, vSize.x, vSecondLineLines);
		
		int lSecondLineLinesCount = vSecondLineLines.size();
		const float fSecondLineTextHeight = fLineHeight * lSecondLineLinesCount;
		fBkgHeight += fSecondLineTextHeight + 20;
	}
	
	cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
	if (vPos.y + fBkgHeight > pSet.GetVirtualSize().y)
		vPos.y-=(vPos.y+fBkgHeight-pSet.GetVirtualSize().y);
	
	cVector3f vBkgPos = cVector3f(vPos.x,vPos.y-12,22);
	cVector3f vTextPos = cVector3f(vBkgPos.x + 30, vPos.y + 10, 23);
	cImGuiGfx gfxBkg("", eImGuiGfx_Texture);
	ImGui_DrawGfx(gfxBkg, vBkgPos, cVector2f(vSize.x + 50, fBkgHeight), cColor(0.03,afAlpha) * gOptionMenu_ModColor);
	
	ImGui_DoTextFrameExt(asText, cVector2f_Zero, fTextVertSpacing, 0, textData, vTextPos, cVector2f(vSize.x,fTextHeight));
	
	if (bHasSecondLine)
	{
		vTextPos.y += fTextHeight + fLineHeight;
		ImGui_DoTextFrameExtW(asSecondLine, cVector2f_Zero, fTextVertSpacing, 0, textData, vTextPos, cVector2f(vSize.x,fTextHeight));
	}
}

//-------------------------------------------------------

void OptionMenu_InfoBoxInputIcons(tString asGfx, cVector3f avPos, cVector2f avSize, const tString &in asText, float afAlpha=1)
{
	if (cLux_HasTranslation("Menu",asText) == false) return;
	
	float fClampedSize = cLux_GetCurrentImGui().GetSet().GetVirtualSize().x-cLux_GetCurrentImGui().GetSet().GetVirtualSizeOffset().x-15-avPos.x;
	cVector3f vPos = avPos;
	cVector2f vSize = cVector2f(cMath_Min(avSize.x,fClampedSize),avSize.y);

	cLuxScreenTextFormatParameters format;
	format.mLabelText.mFontAlign = eFontAlign_Left;
	format.mLabelText.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu_InfoBox,56));
	format.mLabelText.mFont.mvSize = cVector2f(gfFontSize_InfoBox);
	format.mLabelText.mFont.mColor = cColor(1, afAlpha) * gOptionMenu_ModColor;
	format.mfIconGamepadHeight = format.mLabelText.mFont.mvSize.y;
	format.mfIconKeyHeight = format.mLabelText.mFont.mvSize.y;
	format.mfIconMouseHeight = format.mLabelText.mFont.mvSize.y;
	format.mfOutputLineWidth = vSize.x;
	
	array<tWString> vLines;
	array<cLuxScreenTextIcon@> vIcons;
	array<array<int>> vIconsPerLine;							
	
	float fLineHeight = 0.f;
	float fTextVertSpacing = 12;	
	float fDisplayTime = 0.f;
	bool bGamepad = Platform_IsConsole() || cLux_GetInputHandler().GetGamepadWasLastDeviceUsed();
	
	cLux_ParseStringIntoScreenText(cLux_Translate("Menu", asText), cLux_GetCurrentImGui(), format, vLines, 
								   vIcons, vIconsPerLine, fLineHeight, fDisplayTime, bGamepad);  
						
	fLineHeight += fTextVertSpacing;
	
	int lLinesCount = vLines.length();	
	float fTextHeight = fLineHeight * lLinesCount;
	float fBkgHeight = fTextHeight + fTextVertSpacing + 20;
	
	cGuiSet@ pSet = cLux_GetCurrentImGui().GetSet();
	if (vPos.y + fBkgHeight > pSet.GetVirtualSize().y)
		vPos.y-=(vPos.y+fBkgHeight-pSet.GetVirtualSize().y);
	
	cVector3f vBkgPos = cVector3f(vPos.x,vPos.y-12,22);
	cVector3f vTextPos = cVector3f(vBkgPos.x + 30, vPos.y + 10, 23);
	cImGuiGfx gfxBkg("", eImGuiGfx_Texture);
	ImGui_DrawGfx(gfxBkg, vBkgPos, cVector2f(vSize.x + 50, fBkgHeight), cColor(0.03,afAlpha) * gOptionMenu_ModColor);	
	
	cLux_DrawScreenText(cLux_GetCurrentImGui(), cEngine_GetGameTime(), format.mLabelText, vTextPos, vSize.x, fLineHeight, 
						vLines, vIcons, vIconsPerLine);
}

//-------------------------------------------------------

int mlCurrentDir = 0;
	
void OptionMenu_OptionsMultiSelect(cVector2f avPos, array<tString> aArray, int aValue, bool abSelected, tString asCategory="Menu", tString asName="", cVector2f avRightAnchor=cVector2f_Zero, cVector3f avInfoBoxPos=cVector3f_Zero, float afAlpha=1, bool abUseSmallFont=false, bool abActive=true, const tString&in asInfoBoxContent="", const tWString&in asInfoBoxSecondLine=cString_To16Char(""), bool abScrollingLabel=false, bool abUseInputIcons = false)
{
	///////////////
	// Check language
	bool bIsEnglish = false;
	{
		cConfigFile@ pConfig = cLux_GetUserConfig();
		tString sLang = cString_SetFileExt(pConfig.GetString("Main", "StartLanguage", cLux_GetDefaultGameLanguage()), "");
		bIsEnglish = (sLang=="english");
	}
	
	/////////////////
	// Check screen ratio
	cConfigFile@ pConfig = cLux_GetUserConfig();
	const cVector2l vResolution = cVector2l(pConfig.GetInt("Screen", "Width", 1280), pConfig.GetInt("Screen", "Height", 720));
	const cVector2l vScreenRatio = MainMenu_GetScreenRatio(vResolution.x, vResolution.y);
	bool bIsSquareScreen = vScreenRatio == cVector2l(4,3) || vScreenRatio == cVector2l(5,4);
	bool bIsUltraWideScreen = vScreenRatio == cVector2l(8,3) || vScreenRatio == cVector2l(21,9) || vScreenRatio == cVector2l(64,27) || vScreenRatio == cVector2l(12,5) || vScreenRatio == cVector2l(43,18);
	
	//////////////
	// Shuld we scroll?
	const bool bShouldScroll = abScrollingLabel && bIsEnglish==false;
		
	////////////////
	// Setup gfx
	cVector3f vPosNrm = OptionMenu_GetTopLeftOffset(avPos,2);
	cVector3f vRightAnchorNrm = OptionMenu_GetTopLeftOffset(avRightAnchor);
	cVector2f vButtonSizeNrm = OptionMenu_GetScaledSize(kOptionMenu_MultiSize+cVector2f(gfOptionsMenu_ExtraWidth_MultiSelect, 0));
	cVector3f vButtonPosNrm = cVector3f(vRightAnchorNrm.x - vButtonSizeNrm.x, vPosNrm.y + 5, vPosNrm.z);
	cVector3f vArrowLeftPosNrm = cVector3f(vButtonPosNrm.x + 8,vButtonPosNrm.y - 10,vPosNrm.z + 2);
	cVector3f vArrowRightPosNrm = cVector3f(vButtonPosNrm.x+vButtonSizeNrm.x-OptionMenu_GetScaledSize(kOptionMenu_SliderArrowHoverSize).x - 14,vButtonPosNrm.y-8,vPosNrm.z+2);
	cVector3f vLabelPosNrm = cVector3f(vButtonPosNrm.x + (vButtonSizeNrm.x/2), vButtonPosNrm.y + 4, vPosNrm.z + 1);
	cImGuiGfx gfxArrow("startmenu_options_arrow");
	
	///////////////////////////////
	// Do switch value arrows
	if(abSelected)
	{
		int lArrowHovered = 0;
		int lLastInputDevice = cLux_GetInputHandler().GetLastDeviceUsed();
		if (lLastInputDevice == eInputDeviceType_Gamepad ||
			lLastInputDevice == eInputDeviceType_Keyboard)
		{
			int lHorizontalAction = ImGui_GetStateInt(asName + "_HorizontalAction");
			if (lHorizontalAction != 0)
				lArrowHovered = lHorizontalAction;
		}
		else
		{
			lArrowHovered = OptionMenu_GetMouseInsideMultiSelectArrows(vButtonPosNrm, vButtonSizeNrm);
		}
		
		bool bHighlightArrow = lArrowHovered != 0;
		cColor arrowColor_L = cColor(1,afAlpha);
		cColor arrowColor_R = cColor(1,afAlpha);		
		
		if (bHighlightArrow)
		{
			////////////////////
			// Arrow hover color
			if (lArrowHovered == 1)
				arrowColor_L = gHoverColor * cColor(1, afAlpha);
			else
				arrowColor_R = gHoverColor * cColor(1, afAlpha);
		}
		
		///////////////
		// Draw arrows
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), arrowColor_L * gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(180);
		
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), arrowColor_R * gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(0.0);
		
		////////////////
		// InfoBox
		cVector3f vInfoBoxPos = vLabelPosNrm+cVector3f(kOptionMenu_MultiSize.x/2+60,0,0);
		tString sInfoBox = asInfoBoxContent;
		if (sInfoBox=="") sInfoBox = asName+"_Info";
		
		if (abUseInputIcons)
		{
			sInfoBox += "_" + aValue;
			OptionMenu_InfoBoxInputIcons("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, sInfoBox, afAlpha);
		}
		else
		{
			OptionMenu_InfoBox("", cVector3f(avInfoBoxPos.x,vInfoBoxPos.y,avInfoBoxPos.z), kOptionMenu_InfoBoxBgSize, sInfoBox, afAlpha, asInfoBoxSecondLine);
		}
	}
	else
	{
		/////////////
		// Draw arrows
		ImGui_DrawGfx(gfxArrow, vArrowRightPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), cColor(1,afAlpha)*gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(180);
		ImGui_DrawGfx(gfxArrow, vArrowLeftPosNrm, OptionMenu_GetScaledSize(kOptionMenu_SliderArrowSize), cColor(1,afAlpha)*gOptionMenu_ModColor);
		ImGui_SetModRotateAngle(0.0);
	}
		
	/////////////////////////////////
	// Draw multi-select items
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labelData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	cColor labelColor = abSelected ? gHoverColor * cColor(1,afAlpha) : cColor(1,afAlpha);
	labelData.mFont.mColor = labelColor * gOptionMenu_ModColor;
	labelData.mFontAlign = eFontAlign_Center;
	labelData.mbScrolling = bShouldScroll;
	labelData.mfScrollSpeed = abSelected ? 45.f : 0.f;
	labelData.mfScrollStartDelay = 1.f;
	labelData.mfScrollResetDelay = 1.f;

	if(aValue < aArray.size())
	{
		const float fLabelSizeNrm = vButtonSizeNrm.x * 0.6;
		ImGui_SetTransCategory(asCategory);
		
		if (bShouldScroll)
		{
			////////////////////////////////
			// TODO: Temp solution because aigmnet while scrolling seems broken in the source. Find a better way to center the labels across screen types if time. 
			vLabelPosNrm.x -= bIsUltraWideScreen ? 32 : 25;
			vLabelPosNrm.x -= fLabelSizeNrm/2;
		}
		else
			vLabelPosNrm.x -= 12;
		
		/////////////////
		// Hack to make labels reset scrolling when not in focus		
		bool bWasSelected = ImGui_GetStateBool(asName + "_IsSelected", false);
		ImGui_SetStateBool(asName + "_IsSelected", abSelected);
		
		if (bWasSelected == false && abSelected)
			ImGui_SetStateFloat(cString_To8Char(ImGui_Translate(aArray[aValue])) + "$value", -labelData.mfScrollStartDelay);
		
		// Hack to fix issue with scroll speed when there are multiple labels with the same name
		tWString sLabelText = ImGui_Translate(aArray[aValue]);
		if (abSelected == false) 
			sLabelText += "\n";
		
		/////////////////
		// Do label
		cVector2f vLabelSize = labelData.mbScrolling ? OptionMenu_GetScaledSize(cVector2f(fLabelSizeNrm, -1)) : 0;
		ImGui_DoLabelExtW(sLabelText, labelData, vLabelPosNrm, vLabelSize);		
	}
	
	ImGui_SetTransCategory("Menu");
}

//-------------------------------------------------------

int OptionMenu_MessageBox(const tString &in asMessage, const tString &in asButton, tString &out asFocusIn, tString &out asFocusOut, const bool abPlaySound=true)
{
	return OptionMenu_MessageBox(asMessage, asButton, "", asFocusIn, asFocusOut, tWString(""), abPlaySound);
}

//------------------------------------------------------- 

int mlPrevSelectedButton = 0;
int mlSelectedButton = 0;

bool OptionMenu_MessageBox_GameCompleted(const tString &in asMessage, const tString &in asButton, tString &out asFocusIn, tString &out asFocusOut, const bool abPlaySound=true)
{
	////////////////////////////////////
	// ImGui Data
	cImGuiTextFrameData textFrameData;
	textFrameData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	textFrameData.mFont.mvSize = gfFontSize_MainMenu_Small;
	textFrameData.mFont.mColor = cColor(1,0);
	textFrameData.mFontAlign = eFontAlign_Left;
	textFrameData.mbUseBackgroundGfx = false;
	
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_PromptButtons;
	buttonData.mFontAlign = eFontAlign_Center;
	buttonData.mFont.mColor =  cColor(1,1) * gOptionMenu_ModColor;
	
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labelData.mFont.mvSize = gfFontSize_MainMenu;
	labelData.mFont.mColor = cColor(1,1) * gOptionMenu_ModColor;
	labelData.mFontAlign = eFontAlign_Center;
	
	///////////////////////
	// Position & scale
	const float fRowHeight = 0.03;
	cVector2f vFrameSize = ImGui_NrmSize(0.65, fRowHeight);
	cVector3f vFramePos = ImGui_NrmPos(0.5f,0.25f,30.0f) - cVector3f(vFrameSize.x, vFrameSize.y, 0)/2.0f;
	cVector2f vFrameEdgeSpacing = cVector2f(40);
	
	////////////////////////////////////
	// Draw black overlay
	cVector3f vScreenCoverPos = ImGui_FullScreenPos(25);
	cVector2f vScreenOverlay = ImGui_FullScreenSize();
	ImGui_DrawGfx(cImGuiGfx(), vScreenCoverPos, vScreenOverlay, cColor(0.0, 0.75));
	
	///////////////
	// Draw Header
	const float fHeaderHeight = 40;
	ImGui_DoLabelExt("NewGamePlus", labelData, vFramePos + cVector3f(0, vFrameEdgeSpacing.y/2, 0), cVector2f(vFrameSize.x, fHeaderHeight));
	
	////////////////////
	// Ugly hack to get the text frame length
	vFramePos.y += fHeaderHeight;
	const float fTextFrameLength = ImGui_DoTextFrameExt(asMessage, vFrameEdgeSpacing, 0, 0, textFrameData, vFramePos, vFrameSize);
	vFrameSize += ImGui_NrmSize(0.f, fRowHeight * fTextFrameLength);
	vFrameSize.y += fHeaderHeight; // Header height
	
	//////////////////
	// Draw Txt
	textFrameData.mFont.mColor = cColor(1,1) * gOptionMenu_ModColor;
	ImGui_DoTextFrameExt(asMessage, vFrameEdgeSpacing, 0, 0, textFrameData, vFramePos, vFrameSize);
	
	///////////////////////
	// Calculate button size
	cVector2f vButtonSize = cVector2f(116,43);
	const float fButtonAspectRatio = vButtonSize.x / vButtonSize.y;
	vButtonSize.y = buttonData.mFont.mvSize.y * 1;
	vButtonSize.x = vButtonSize.y * fButtonAspectRatio * 2;
	
	//////////////////////////
	// Draw background slip
	cVector3f vBgFramePos = vFramePos;
	vFramePos.y -= fHeaderHeight;
	cVector2f vBgFrameSize = vFrameSize + cVector2f(0.f, vButtonSize.y * 3.5);
	ImGui_DrawGfx(cImGuiGfx(), vFramePos + cVector3f(0, 0, -0.1), vBgFrameSize, cColor(0.03, 1));
	
	///////////////
	// White Lines
	cVector2f vLineSize = cVector2f(vBgFrameSize.x * 0.95, 2);
	cVector3f vLinePos = ImGui_NrmPos(0.5f,0.25f,30.0f) - cVector3f(vLineSize.x, vLineSize.y, 0)/2.0f;
	cVector3f vLinePos_Top = vLinePos + cVector3f(0, vFrameEdgeSpacing.y/2 + fHeaderHeight/1.5, 0.1);
	cVector3f vLinePos_Bottom = vLinePos + cVector3f(0, (vFrameEdgeSpacing.y/2) - 12, 0.1) + cVector3f(0, vFrameSize.y, 0);
	ImGui_DrawGfx(cImGuiGfx(), vLinePos_Top, vLineSize, cColor(1, 0.5));
	ImGui_DrawGfx(cImGuiGfx(), vLinePos_Bottom, vLineSize, cColor(1, 0.5));
	
	/////////////////////
	// Draw button
	cVector3f vButtonPos = vFramePos + cVector3f(vBgFrameSize.x/2.0f, vBgFrameSize.y - (vButtonSize.y * 2), 0.1f); // Middle
	bool bVal = false;
	
	if(asButton!="")
	{
		if(mlSelectedButton == 1)
			buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
		
		if(ImGui_DoButtonExt(asButton,asButton, buttonData, vButtonPos + cVector3f(-vButtonSize.x/2, 0.0f, 1.0f), vButtonSize))
		{
			bVal = true;
			if (abPlaySound)
				Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		}
		
		asFocusOut = OptionMenu_UpdateFocus(asButton, asFocusIn);
		mlSelectedButton = (ImGui_PrevInFocus() ? 1 : -1);
	}
	
	return bVal;
}

//------------------------------------------------------- 

int OptionMenu_MessageBox(const tString &in asMessage, const tString &in asLeft, const tString &in asRight, tString &out asFocusIn, tString &out asFocusOut, const tWString &in asSecondRow=tWString(""), const bool abPlaySound=true)
{	
	////////////////////////////////////
	// ImGui Data
	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	labelData.mFont.mvSize = gfFontSize_Prompts;
	labelData.mFont.mColor = cColor(1,1) * gOptionMenu_ModColor;
	labelData.mFontAlign = eFontAlign_Center;
	
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_PromptButtons;
	buttonData.mFontAlign = eFontAlign_Center;
	buttonData.mFont.mColor =  cColor(1,1) * gOptionMenu_ModColor;
	
	cImGuiButtonData buttonLeftData = buttonData;
	buttonLeftData.mGfxInFocus = cImGuiGfx("startmenu_selection_ring_on.tga");
		
	cImGuiButtonData buttonRightData = buttonData;
	buttonRightData.mGfxInFocus = cImGuiGfx("startmenu_selection_ring_off.tga");
	
	
	// Second row used for timer countdown
	tWString sMessage = ImGui_TranslatePlatformSpecific(asMessage);
	tWString sSecondRow = asSecondRow;
	tWString sThirdRow = "";
		
	cVector2f vButtonSize = cVector2f(116,43);
	float fButtonAspectRatio = vButtonSize.x/vButtonSize.y;
	vButtonSize.y = buttonData.mFont.mvSize.y;
	vButtonSize.x = vButtonSize.y*fButtonAspectRatio;
	
	cVector2f vMessageSize(cLux_GetCurrentImGui().GetFontLength(labelData.mFont,  1.0f,  sMessage), labelData.mFont.mvSize.y);
	vMessageSize = OptionMenu_GetScaledSize(vMessageSize);
	
	// Padding between Buttons (x) and between Message and Buttons (y)
	//cVector2f vPadding = OptionMenu_GetScaledSize(cVector2f(15.0f, 15.0f));
	cVector2f vPadding = OptionMenu_GetScaledSize(cVector2f(2.0f, 2.0f));
	
	/////////////////////
	// Calculate Message wrapping
	
	float fMinWidth = vButtonSize.x*2+80;
	float fMaxWidth = cLux_GetCurrentImGui().GetSet().GetVirtualSize().x-200;
	
	if (vMessageSize.x + 2*vPadding.x > fMaxWidth)
	{
		int lHalfLength = sMessage.length()/2;
		tWString sWhitespaceCheck = cString_SubW(sMessage, lHalfLength);
		int lWhitespace = cString_GetFirstStringPosW(sWhitespaceCheck, cString_To16Char(" "));
		if (lWhitespace < 0)
		{
			sWhitespaceCheck = cString_SubW(sMessage, 0, lHalfLength);
			lWhitespace = cString_GetLastStringPosW(sWhitespaceCheck, cString_To16Char(" "));
		}
		else
		{
			lWhitespace += lHalfLength;
		}
		
		if (lWhitespace > 0)
		{
			sThirdRow = sSecondRow;
			sSecondRow = cString_SubW(sMessage, lWhitespace+1);
			sMessage = cString_SubW(sMessage, 0, lWhitespace);
			if (lWhitespace >= lHalfLength)
				vMessageSize = cVector2f(cLux_GetCurrentImGui().GetFontLength(labelData.mFont,  1.0f,  sMessage), labelData.mFont.mvSize.y);
			else
				vMessageSize = cVector2f(cLux_GetCurrentImGui().GetFontLength(labelData.mFont,  1.0f,  sSecondRow), labelData.mFont.mvSize.y);
			vMessageSize = OptionMenu_GetScaledSize(vMessageSize);
		}
	}
	
	///////////////////////
	// Positioning
	
	cVector2f vFrameSize = cVector2f(cMath_Max(vPadding.x + vMessageSize.x + vPadding.x, fMinWidth), (vPadding.y + vMessageSize.y + vPadding.y + vButtonSize.y + vPadding.y));
	cVector3f vFramePos = ImGui_NrmPos(0.5f,0.5f,30.0f) - cVector3f(vFrameSize.x, vFrameSize.y, 0)/2.0f;
	
	cVector3f vMessagePos = vFramePos + cVector3f(0, vPadding.y, 1.0f);
	//cVector3f vButtonPos = vFramePos + cVector3f(vFrameSize.x/2.0f, vPadding.y + vMessageSize.y + vPadding.y - 6, 1.0f); // Middle
	cVector3f vButtonPos = vFramePos + cVector3f(vFrameSize.x/2.0f, vPadding.y + vMessageSize.y + vPadding.y + 2, 1.0f); // Middle
	
	////////////////////////////////////
	// Draw black overlay
	cVector3f vScreenCoverPos = ImGui_FullScreenPos(25);
	cVector2f vScreenOverlay = ImGui_FullScreenSize();
	ImGui_DrawGfx(cImGuiGfx(), vScreenCoverPos, vScreenOverlay, cColor(0.0, 0.75));
	
	//////////////////////////
	// Draw background slip
	float fHeight = (sSecondRow.length() != 0) ? 180 : 116;
	float fVOffset = (sSecondRow.length() != 0) ? 30 : 0;
	cVector2f vSize = cVector2f(cMath_Max(vMessageSize.x,475.f),fHeight);
	
	cVector2f kScreenCenter = cVector2f(512, 384); // Virtual size: 1024x768
	cImGuiGfx gfxBkg;
	cVector3f vTextFramePos = cVector3f(kScreenCenter.x,kScreenCenter.y+fVOffset,30);
	ImGui_DrawAlignedGfx(gfxBkg, vTextFramePos, eImGuiAlign_CenterCenter, vSize, cColor(0.03,1) * gOptionMenu_ModColor);
	
	//////////////////////
	// Draw message
	ImGui_SetTextOverride(sMessage);
	ImGui_DoLabelExt("",labelData, vMessagePos, cVector2f(vFrameSize.x, -1));
	ImGui_ClearTextOverride();
	
	if(sSecondRow.length()!=0)
	{
		ImGui_SetTextOverride(sSecondRow);
		ImGui_DoLabelExt("",labelData, vMessagePos + cVector3f(0, vMessageSize.y * 0.9, 0.0f), cVector2f(vFrameSize.x, -1));
		ImGui_ClearTextOverride();
		
		vButtonPos.y += vMessageSize.y + vPadding.y + fVOffset;
		vFrameSize.y += vMessageSize.y + vPadding.y;
	}
	
	if(sThirdRow.length()!=0)
	{
		ImGui_SetTextOverride(sThirdRow);
		ImGui_DoLabelExt("",labelData, vMessagePos + cVector3f(0, vMessageSize.y * 2 * 0.9, 0.0f), cVector2f(vFrameSize.x, -1));
		ImGui_ClearTextOverride();
		
		vButtonPos.y += vMessageSize.y + vPadding.y + fVOffset;
		vFrameSize.y += vMessageSize.y + vPadding.y;
	}
	
	/////////////////////
	// Draw two buttons
	int lVal = 0; // Output value
	int lSelectedButton = 0; // Currently selected
	float fButtonSep = vPadding.x/2;
	cVector2f vUnderlineSizeNrm = OptionMenu_GetScaledSize(cVector2f(70,5));
	cImGuiGfx gfxHover = cImGuiGfx("startmenu_underscore_yesno", eImGuiGfx_Texture);
	
	if(asLeft!="" && asRight!="")
	{
		ImGui_LayoutBegin(eImGuiLayout_X, vButtonPos-cVector3f(vButtonSize.x+fButtonSep/2, 0.0f, 0.0f), cVector2f_MinusOne, cVector2f(fButtonSep,0));
		
			ImGui_SetUIMoveWrapMode(eImGuiWrap_None);
			
			if (mlSelectedButton == 1)
				buttonRightData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
			else if (mlSelectedButton == -1)
				buttonLeftData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
				
			if(ImGui_DoButtonExt(asLeft,asLeft, buttonLeftData, 0, vButtonSize+cVector2f(0,6)))
			{
				lVal = -1;
				if (abPlaySound) Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
			}
			asFocusOut = OptionMenu_UpdateFocus(asLeft, asFocusIn);
				
			if(ImGui_DoButtonExt(asRight,asRight, buttonRightData, 0, vButtonSize+cVector2f(0,6)) ||
			   ImGui_ActionTriggered(eImGuiAction_Cancel, true))
			{
				lVal = 1;
				if (abPlaySound) Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
			}
			asFocusOut = OptionMenu_UpdateFocus(asRight, asFocusOut);
		
			lSelectedButton = (ImGui_PrevInFocus()) ? 1 : -1;
			mlSelectedButton = lSelectedButton;
	
		ImGui_LayoutEnd();
	}
	
	///////////////////
	// Only one option
	else if(asLeft!="" || asRight!="")
	{
		tString sButton = (asLeft!="") ? asLeft : asRight;
		
		ImGui_LayoutBegin(eImGuiLayout_X, vButtonPos+cVector3f(-vButtonSize.x/2, 0.0f, 1.0f), cVector2f_MinusOne, cVector2f(0,0));
		
			if(mlSelectedButton == 1)
				buttonLeftData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
			
			if(ImGui_DoButtonExt(asLeft,asLeft, buttonLeftData, 0, vButtonSize+cVector2f(0,6)))
			{
				lVal = 1;
				if (abPlaySound) Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
			}
			asFocusOut = OptionMenu_UpdateFocus(asLeft, asFocusIn);
			

			mlSelectedButton = (ImGui_PrevInFocus() ? 1 : -1);
		
		ImGui_LayoutEnd();
	}
	
	return lVal;
}

