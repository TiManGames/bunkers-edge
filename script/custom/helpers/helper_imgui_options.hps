void OptionMenu_ButtonBackgroundSaveFile(cVector2f avPos, cVector2f avSize = kOptionMenu_ButtonBgSize, float afAlpha=1)
{
	///////////
	// Draw background
	{
		cImGuiGfx gfx("startmenu_selection_submenu", eImGuiGfx_Texture);
		ImGui_DrawGfx(gfx, OptionMenu_GetTopLeftOffset(avPos + cVector2f(-6, 6), 0.29), OptionMenu_GetScaledSize(avSize+cVector2f(368,0)), kOptionMenu_ButtonBgColor*gOptionMenu_ModColor*cColor(1, afAlpha));
	}
}

//-------------------------------------------------------

bool MainMenu_DoButton(tString asName, const cVector3f &in avPos, bool abSelected, float afAlpha=1.f, float afBrightness=1.f, bool abUseSmallFont=false, cVector2f avScale=kOptionMenu_ButtonSize)
{
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = abUseSmallFont ? gfFontSize_MainMenu_Small : gfFontSize_MainMenu;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor =  cColor(1.0, afAlpha) * gOptionMenu_ModColor * afBrightness;
	
	if (abSelected)
		buttonData.mFont.mColor = buttonData.mFont.mColor * gHoverColor;
		
	return ImGui_DoButtonExt(asName, asName, buttonData, avPos, OptionMenu_GetScaledSize(avScale));
}

//-------------------------------------------------------

bool MainMenu_DoBackButton(const tString&in asSelected, float afAlpha=1.f)
{
	if (cLux_GetInputHandler().GetGamepadWasLastDeviceUsed())
		return false;
	
	bool bClicked = false;
	bool bSelected = asSelected == "Back";
	
	cImGuiButtonData buttonData = ImGui_GetDefaultButton();
	buttonData.mbUseBackgroundGfx = false;
	buttonData.mbUseInFocusGfx = false;
	buttonData.mbUseTriggeredGfx = false;
	buttonData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu,72));
	buttonData.mFont.mvSize = gfFontSize_MainMenu_ConfirmButton;
	buttonData.mFontAlign = eFontAlign_Left;
	buttonData.mFont.mColor =  cColor(1.0, afAlpha) * gOptionMenu_ModColor;
	
	if (bSelected)
		buttonData.mFont.mColor = gHoverColor * cColor(1, afAlpha);
	
	cVector3f vButtonPos = OptionMenu_GetTopLeftOffset(kBackButtonPos, 1.0);
	
	if (ImGui_DoButtonExt("Back", "Back", buttonData, vButtonPos, OptionMenu_GetScaledSize(cVector2f(256, 40))))
	{
		if (ImGui_TimerExists("TransitionOut") == false)
			ImGui_AddTimer("TransitionOut", 10.f);
		Sound_PlayGui("special_fx/frontend/frontend_menu_select", 1.0f, eSoundEntryType_Gui);
		bClicked = true;
	}
	
	return bClicked;
}

