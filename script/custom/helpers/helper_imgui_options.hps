//------------------------------------------------------- 

void OptionMenu_ShowCurrentUser(bool abShowPicker)
{
	///////////////////////////////////
	// Users handler will always return empty string on non-GDK platforms
	tWString sAccountName = cLux_GetUsersHandler().GetCurrentUser();
	if (sAccountName.length() == 0)
		return;
	
	tString sPrevCategory = ImGui_GetTransCategory();
	ImGui_SetTransCategory("");

	/////////////////
	// Account picker on Xbox
	cImGuiGfx gfxAccount("but_x");
	cVector2f vButtonXSize = OptionMenu_GetScaledSize(36);

	cVector2f vOffset = cVector2f(-(vButtonXSize.x + 10), 10);
	
	if(abShowPicker)
		ImGui_DrawGfx(gfxAccount, OptionMenu_GetTopRightOffset(vOffset, -20), vButtonXSize, cColor(0.04,0.57,0.78,1));

	cImGuiLabelData labelData;
	labelData.mFont.SetFile(FontHandler_GetFont(eFontType_AccountName, 28));
	labelData.mFont.mvSize =  28;
	labelData.mFont.mColor = cColor(1,1);
	labelData.mFontAlign = eFontAlign_Right;

	float fXOffset = -GetFontLengthW(labelData.mFont, 1, sAccountName) + 10;

	vOffset += cVector2f(-5, vButtonXSize.y/2);

	ImGui_DoLabelExtW(sAccountName, labelData, OptionMenu_GetTopRightOffset(vOffset, -20), 1);

	ImGui_SetTransCategory(sPrevCategory);
}