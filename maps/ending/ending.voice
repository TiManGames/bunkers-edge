 <Subjects>
  <Subject Name="SeeingGrunt" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="What is this place?" FileName="general_seeinggrunt_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="this is the sitting room, of course" VoiceOffset="0.75" FileName="general_seeinggrunt_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_1" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Where am I?" FileName="general_question_1_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="I already told you. This is the sitting room" VoiceOffset="0.75" FileName="general_question_1_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_2" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Who are you?" FileName="general_question_2_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="I am the god of chairs. This is my sitting room. You can sit if you'd like." VoiceOffset="0.75" FileName="general_question_2_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_3" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="how old am I?" FileName="general_question_3_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="You were manufactured twenty years ago in Sweden" VoiceOffset="0.75" FileName="general_question_3_002_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_4" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="What time is it?" FileName="general_question_4_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Soon it will be time to sit. but for now, we stand." VoiceOffset="0.75" FileName="general_question_4_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_5" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="How did i end up here?" FileName="general_question_5_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Everyone finds their way to the sitting room eventually" VoiceOffset="0.75" FileName="general_question_5_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_6" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Is the moon made of cheese?" FileName="general_question_6_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="It's made of sitting cheese, of course." VoiceOffset="0.75" FileName="general_question_6_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_7" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="What's your favorite color?" FileName="general_question_7_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Brown." FileName="general_question_7_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="oh..." VoiceOffset="1.0" FileName="general_question_7_003_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_8" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Is the war still going on?" FileName="general_question_8_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="War cannot reach the sitting room." VoiceOffset="0.75" FileName="general_question_8_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_9" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="What's your favorite food?" FileName="general_question_9_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Dinner will be prepared soon. You can stay. I have space." VoiceOffset="0.75" FileName="general_question_9_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_10" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="How tall are you?" FileName="general_question_10_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="idk lol" VoiceOffset="0.75" FileName="general_question_10_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="question_11" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="1" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Are you the grunt from amnesia the dark descend?" FileName="general_question_11_001_player_001" Timestamp="2026-09-04 11:29" />
   </Line>
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Yes. My actual name is chair sitman." VoiceOffset="0.75" FileName="general_question_11_002_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="SitOnYou_Threat" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
   <Line CharacterId="0" Prio="0" TextStatus="Placeholder" PlayOnce="True">
    <Sound Text="Enough talk. This is the sitting room. And I'm gonna sit on youuuuuu~" VoiceOffset="" FileName="general_sitonyou_001_grunt_001" Timestamp="2026-09-04 11:29" />
   </Line>
  </Subject>
  <Subject Name="SitOnYou_Plea" UseSingleRandomLine="False" ShowSubtitlesIfMissing="False" SceneId="0" EffectId="-1" Section="Conversation">
