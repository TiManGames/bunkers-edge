//--------------------------------------------------
 
const tString gsBunkersEdgeCreditsFile = "BunkersEdge_Credits.cfg";
const tString gsBunkersEdgeCreditsMusic = "Bunker_EndCredits.ogg";
 
//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		GetBase().SetDisplayNameEntry("ending");
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		// Any general setup of script / entities
		Sound_FadeGlobalVolume(1.0f, 0, eSoundEntryType_AllExceptGui);
		
		/////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
		}
		
		Game_AutoSave();

		Effect_Shake_Start(0.012f, 4.f, 0.35f, 0.5f);
		Effect_Rumble_Start(0.06f, 4.f, 0.35f, 0.5f);
		Effect_Flash_Start(0.1f, 0.2f, 1.0f, 1.0f);
		Sound_PlayGui("DW_tunnel/portal/portal_close", 1.0f, eSoundEntryType_Gui);

		Player_SetFallDamageActive(false);
		Parkour_SetEnabled(false);
		Player_SetAmbientLight_None();
		Sketchbook_SetInventoryEnabled(false);
		PlayerBody_SetActive(true);

		Entity_PlayAnimation("Grunt", "idle", 0.f, true, false);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		Dialog_Stop("SittingRoomConversation");
		Voice_SetFocusScene("");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed == false) return;
		
		if (alAction == eAction_Test1)
		{
			Player_GiveDamage(1.0f, 0.0f, eDamageType_Default, ""); // Die!
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}

	//-------------------------------------------------------

	void Update(float afTimeStep)
	{
		UpdateSittingRoomGruntThreatRotation(afTimeStep);

		////////////////////////////
		// DEATH BOX
		////////////////////////////
		
		// Increment timer
		if(mbPlayerInDeathBox) mfPlayerDeathTimer += afTimeStep;
		else if(mfPlayerDeathTimer > 0) mfPlayerDeathTimer -= afTimeStep;

		//cLux_AddDebugMessage("Time until death: "+cMath_Clamp(60-mfPlayerDeathTimer, 0, 60));

		// Hints
		if(mbPlayerInDeathBox)
		{
			if(mfPlayerDeathTimer >= 5.0f)
			{
				Hint_ShowInfo("BunkersEdgeHints", "HintBEDie", false);
			}
			if(mfPlayerDeathTimer >= 20.0f)
			{
				Hint_ShowInfo("BunkersEdgeHints", "HintBEDie2", false);
			}
			if(mfPlayerDeathTimer >= 40.0f)
			{
				Hint_ShowInfo("BunkersEdgeHints", "HintBEDie3", false);
			}
			if(mfPlayerDeathTimer >= 54.0f)
			{
				Hint_ShowInfo("BunkersEdgeHints", "HintBEDie4", false);
			}
		}

		if(mfPlayerDeathTimer >= 60.0f) Player_GiveDamage(1.0f, 0.0f, eDamageType_Default, ""); // Die!

		//END DEATH BOX STUFF
	}

	tString sCountdownSeconds = "SECONDS";

	void OnGui(float afTimeStep)
	{
		cImGuiLabelData labelData = ImGui_GetDefaultLabel();
		labelData.mFont.SetFile(FontHandler_GetFont(eFontType_MainMenu, 96));
		
		if(mbPlayerInDeathBox)
		{
			Player_SetCrossHairEnabled(false);
			
			if(mfPlayerDeathTimer >= 58.0f) sCountdownSeconds = "SECOND";
			if(mfPlayerDeathTimer >= 59.0f) sCountdownSeconds = "SECONDS";

			ImGui_SetAlignment(eImGuiAlign_CenterCenter);
				ImGui_GroupBegin(cLux_GetHudVirtualCenterScreenStartPos(), cLux_GetHudVirtualCenterScreenSize(), false);
				tString sCountdownLabel;
				if(mfPlayerDeathTimer < 60.0f) 
				sCountdownLabel = "YOU WILL DIE IN "+ cMath_Clamp(60-mfPlayerDeathTimer, 0, 60) + " " + sCountdownSeconds;
				else
				{
					sCountdownLabel = "YOU ARE DEAD";
					ImGui_DoLabelExt("You lost the coin toss!", labelData, ImGui_NrmPosGroup(cVector3f(0.5, 0.6, 1)), -1, 2);
				}

				ImGui_DoLabelExt(sCountdownLabel, labelData, ImGui_NrmPosGroup(cVector3f(0.5, 0.5, 1)), -1, 3);
				
				ImGui_GroupEnd();
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		}
		
		if (mbInsideTimeBox)
		{
			ImGui_SetAlignment(eImGuiAlign_CenterCenter);
				ImGui_GroupBegin(cLux_GetHudVirtualCenterScreenStartPos(), cLux_GetHudVirtualCenterScreenSize(), false);
				tString sDate =  "Current Time: " + FormatDate(cString_To8Char(cLux_GetStringWFromDate(cSystem_GetDate())));
				ImGui_DoLabelExt(sDate, labelData, ImGui_NrmPosGroup(cVector3f(0.5, 0.5, 1)), -1, 3);
				ImGui_GroupEnd();
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		}
	}

	tString FormatDate(tString&in asDate)
	{
		tString sHour = cString_Sub(asDate, 8, 2);
		tString sMinute = cString_Sub(asDate, 10, 2);
		tString sSecond = cString_Sub(asDate, 12, 2);
		return sHour + ":" + sMinute + ":" + sSecond;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS
 
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	bool mbInsideTimeBox = false;
 
	//-------------------------------------------------------
 
	bool OnCollide_TimeBox(const tString &in asParent, const tString &in asChild, int alState)
	{
		if(alState == 1)
		{
			mbInsideTimeBox = true;
			Player_ShowCrossHairIcons(false, false);
		}
		if(alState == -1)
		{
			mbInsideTimeBox = false;
			Player_ShowCrossHairIcons(true, false);
		}

		return true;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE X *NAME OF SCENE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		/*Put any variables that are used by many events in Scene X here.*/
	 
		//-------------------------------------------------------
	 
		//-------------------------------------------------------
		
		//} END General	

		/////////////////////////////////////////
		// DEAD ROOM
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------
	 
		bool mbPlayerInDeathBox;
		float mfPlayerDeathTimer;
	 
		//-------------------------------------------------------
	 
		bool OnCollide_DeathBox(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState == 1)
			{
				mbPlayerInDeathBox = true;
				Player_ShowCrossHairIcons(false, false);
			}
			if(alState == -1)
			{
				mbPlayerInDeathBox = false;
				Player_ShowCrossHairIcons(true, false);
			}

			return true;
		}
	 
		//-------------------------------------------------------
		
		//} END DEAD ROOM

		////////////////////////////////////////
		// DEBUG ROOM
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------

		bool mbPickedUpShotgun = false;
		bool mbInsideDebugRoom = false;
		bool mbWaterFilled;
		bool mbLightsOff;
	 
		//-------------------------------------------------------
	 
		bool OnCollide_DebugBox(const tString &in asParent, const tString &in asChild, int alState)
		{
			if(alState==1)
			{
				mbInsideDebugRoom = true;
				if(mbPickedUpShotgun) 
				{
					Item_AddToInventory("Shotgun", eInventoryInstance_Player, false);
					cLux_AddDebugMessage("[DebugRoom] Add dummy shotgun so the STUPID PLAYER thinks it's the same shotgun. Idiot.");
					cLux_SetHideDebugOutputOn(false);
				}
			}
			else if(alState==-1)
			{
				mbInsideDebugRoom = false;

				// Bunch of stupid hacks because stuff related to the shotgun doesn't want to behave
				Player_ChangeStateToNormal();
				PlayerBody_StopAnimationLayer(ePlayerBodyAnimationLayer_Arms, 0.0f);
				Item_PutAway(eItemHandlerHand_Right);
				Item_ClearInventory(eInventoryInstance_Player);
				Map_AddTimer("FreeSocket", 0.7f, "OnTimer_FreeSocket");
			}

			return true;
		}

		//-------------------------------------------------------

		void OnGui_DebugPanel(const tString&in asEntityName, float afTimeStep)
		{
			ImGui_SetAlignment(eImGuiAlign_CenterCenter);
				ImGui_DoLabelExt("DEBUG ACTION #"+asEntityName, ImGui_GetDefaultLabel(), ImGui_NrmPosGroup(cVector3f(0.5, 0.5, 1)), -1, 6);
			ImGui_SetAlignment(eImGuiAlign_TopLeft);
		}

		//-------------------------------------------------------

		void OnInteract_Shotgun(const tString &in asEntity)
		{
			Entity_SetActive("shotgun", false);
			Entity_SetActive("Trigger_1", false);
			Item_AddToInventory("Shotgun", eInventoryInstance_Player, true); //"player/UI/menu/add_inventory"
			Sound_CreateAtEntity("PickupSound", "player/UI/menu/add_inventory", "shotgun", 0.0f);
			mbPickedUpShotgun = true;

			cLux_AddDebugMessage("[DebugRoom] Fake pickup because this engine sucks!");
		}

		//-------------------------------------------------------

		void OnTimer_FreeSocket(const tString &in asTimer)
		{
			PlayerBody_FreeSocket("R_Hand");
		}

		void OnInteract_Button1(const tString &in asEntity)
		{
			
			if(!mbLightsOff)
			{
				Light_FadeBrightnessTo("Light_Box_17", 0.0f, 1.0f); 
				Light_FadeBrightnessTo("Light_Box_19", 0.0f, 1.0f);
				Light_FadeBrightnessTo("Light_Spot_2", 0.0f, 1.0f);
				mbLightsOff = true;
			}
			else
			{
				Light_FadeBrightnessTo("Light_Box_17", 0.35f, 1.0f); 
				Light_FadeBrightnessTo("Light_Box_19", 0.35f, 1.0f);
				Light_FadeBrightnessTo("Light_Spot_2", 0.7f, 1.0f);
				mbLightsOff = false;
			}

			
		}

		void OnInteract_Button2(const tString &in asEntity)
		{
			if(mbWaterFilled) Seq_WaterDrain("");
			else Seq_WaterFill("");
		}

		cSequenceStatesData mSeqWaterFill;
		void Seq_WaterFill(const tString &in asX = "")
		{
			Sequence_Begin("Seq_WaterFill", mSeqWaterFill);
			
			if (Sequence_DoStepAndWait(4.0))
			{
				Player_SetInteractionAllowed("NoPressing", false);
				SlideDoor_SetClosed("DebugDoor", true, false);
			}
			else if (Sequence_DoStepAndWait(5.7))
			{
				Sound_CreateAtEntity("Sound_Start", "player/ladder/debug/attach_bottom", "player", 0, false, 0.5f);
				cLux_AddDebugMessage("[DEBUG ROOM] Water rising!");
				LiquidArea_MoveLinearTo("Liquid_1", "LiquidTarget_Fill", 0.2, 1, 0.5, false);
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				Sound_CreateAtEntity("Sound_Stop", "player/ladder/debug/hand_place", "player", 0, false, 0.5f);
				Player_SetInteractionAllowed("NoPressing", true);

				mbWaterFilled = true;
			}
			
			Sequence_End();
		}
	
		cSequenceStatesData mSeqWaterDrain;
		void Seq_WaterDrain(const tString &in asX = "")
		{
			Sequence_Begin("Seq_WaterDrain", mSeqWaterDrain);
			
			
			if (Sequence_DoStepAndWait(1.2))
			{
				Player_SetInteractionAllowed("NoPressing", false);
			}
			else if (Sequence_DoStepAndWait(1.5))
			{
				Sound_CreateAtEntity("Sound_Start", "player/ladder/debug/attach_bottom", "player", 0, false, 0.5f);
			}
			else if (Sequence_DoStepAndWait(4.7))
			{
				cLux_AddDebugMessage("[DEBUG ROOM] Water draining!");
				LiquidArea_MoveLinearTo("Liquid_1", "LiquidTarget_Drain", 0.3, 1, 0.5, false);
			}
			else if (Sequence_DoStepAndWait(0.5))
			{
				Sound_CreateAtEntity("Sound_Stop", "player/ladder/debug/hand_place", "player", 0, false, 0.5f);
				
				mbWaterFilled = false;
			}
			else if (Sequence_DoStepAndWait(2.0))
			{
				SlideDoor_SetClosed("DebugDoor", false, false);
				Player_SetInteractionAllowed("NoPressing", true);
			}
			
			Sequence_End();
		}
	 
		//-------------------------------------------------------
		
		//} END General	
	 
		/////////////////////////////////////////
		// SITTING ROOM
		//{//////////////////////////////////////

		//-------------------------------------------------------

		bool mbGruntThreatRotating = false;
		float mfGruntThreatRotationTime = 0.f;
		cMatrixf m_mtxGruntThreatRotationStart;
		cMatrixf m_mtxGruntThreatRotationGoal;

		//-------------------------------------------------------

		void UpdateSittingRoomGruntThreatRotation(float afTimeStep)
		{
			if (mbGruntThreatRotating == false) return;

			iLuxEntity@ pGrunt = Map_GetEntity("Grunt");
			if (pGrunt is null)
			{
				mbGruntThreatRotating = false;
				return;
			}

			mfGruntThreatRotationTime += afTimeStep;
			float fT = cMath_Clamp(mfGruntThreatRotationTime / 4.5f, 0.f, 1.f);
			pGrunt.SetMatrix(cMath_MatrixSlerp(fT, m_mtxGruntThreatRotationStart, m_mtxGruntThreatRotationGoal, true));

			if (fT >= 1.f)
				mbGruntThreatRotating = false;
		}

		//-------------------------------------------------------

		void AddSittingRoomQuestion(const tString &in asEntry, const tString &in asBranch, int alOptionId)
		{
			tString sAskedVar = "Asked_"+asBranch;

			// First-time version: marks the question and advances the finale count.
			Dialog_AddResponseOption(asEntry, asBranch, alOptionId);
			Dialog_AddResponseCondition_VarNotSet(sAskedVar);
			Dialog_AddResponseEvent_SetVar(sAskedVar);
			Dialog_AddResponseEvent_IncVar("SittingRoom_QuestionsAsked");

			// Repeat version: keeps the entry visible after it has been asked. This
			// guarantees that the dialog handler always has all eleven responses;
			// it otherwise auto-selects the final remaining response.
			Dialog_AddResponseOption(asEntry, asBranch, alOptionId);
			Dialog_AddResponseCondition_VarIsSet(sAskedVar);
		}

		//-------------------------------------------------------

		void AddAllSittingRoomQuestions()
		{
			AddSittingRoomQuestion("Question_1_Option", "Question_1", 1);
			AddSittingRoomQuestion("Question_2_Option", "Question_2", 2);
			AddSittingRoomQuestion("Question_3_Option", "Question_3", 3);
			AddSittingRoomQuestion("Question_4_Option", "Question_4", 4);
			AddSittingRoomQuestion("Question_5_Option", "Question_5", 5);
			AddSittingRoomQuestion("Question_6_Option", "Question_6", 6);
			AddSittingRoomQuestion("Question_7_Option", "Question_7", 7);
			AddSittingRoomQuestion("Question_8_Option", "Question_8", 8);
			AddSittingRoomQuestion("Question_9_Option", "Question_9", 9);
			AddSittingRoomQuestion("Question_10_Option", "Question_10", 10);
			AddSittingRoomQuestion("Question_11_Option", "Question_11", 11);
		}

		//-------------------------------------------------------

		void AddSittingRoomQuestionBranch(const tString &in asBranch, const tString &in asSubject)
		{
			Dialog_AddBranch(asBranch);
				Dialog_AddSubject(asSubject);
				AddAllSittingRoomQuestions();
				Dialog_AddEndEvent_VarEquals("SittingRoom_QuestionsAsked", 11, "Finale");
		}

		//-------------------------------------------------------

		int mlGruntAnimationStage = 1;
		void OnSubject_SitOnYouThreat(const tString &in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject) return;

			iLuxEntity@ pGrunt = Map_GetEntity("Grunt");
			if (pGrunt is null) return;

			Light_FadeBrightnessTo("Light_Sit", 1.0f, 1.0f, eEasing_Linear);
			Light_FadeBrightnessTo("Light_Sit_1", 1.0f, 1.0f, eEasing_Linear);

			pGrunt.FadeMeshScaleMul(cVector3f(4.0f), 4.5f);

			m_mtxGruntThreatRotationStart = pGrunt.GetMatrix();
			m_mtxGruntThreatRotationGoal = cMath_MatrixMul(cMath_MatrixRotateY(cMath_Pi), m_mtxGruntThreatRotationStart);
			m_mtxGruntThreatRotationGoal.SetTranslation(m_mtxGruntThreatRotationStart.GetTranslation());
			mfGruntThreatRotationTime = 0.f;
			mbGruntThreatRotating = true;

			Map_AddTimer("1", 4.5f, "Timer_GruntAnimation");
			Map_AddTimer("1", 6.3f, "Timer_MoveButt");
		}

		void Timer_GruntAnimation(const tString&in asTimer)
		{
			Entity_SetActive("Grunt", false);

			Entity_SetActive("grunt_anim_" + asTimer, true);

			if (mlGruntAnimationStage <= 2)
			{
				Map_AddTimer("" + (mlGruntAnimationStage + 1), 0.7f, "Timer_GruntAnimation");

				if (mlGruntAnimationStage > 1)
					Entity_SetActive("grunt_anim_" + (mlGruntAnimationStage - 1), false);

				mlGruntAnimationStage++;
			}
			
		}

		void Timer_MoveButt(const tString&in asTimer)
		{
			Player_StartLookAt("GruntButtTarget_1", 3.0f, 3.0f, 5.0f, true);
			Area_MoveLinearTo("GruntButtController", "GruntButtTarget", 0.1f, 0.3f, 1.0f, false, "");

			Map_AddTimer("FadeOutAndCredits", 4.5f, "Timer_FadeOutAndCredits");
		}

		void Timer_FadeOutAndCredits(const tString&in asTimer)
		{
			Effect_Fade_Out(0.25f);
			Map_AddTimer("DoCredits", 3.0f, "Timer_DoCredits");
		}

		void Timer_DoCredits(const tString&in asTimer)
		{
			Parkour_SetLevelCompletedOnce();
			Player_SetActive(false);
			Sound_FadeGlobalVolume(0.f, 0.5f, eSoundEntryType_WorldAll);
			Credits_Start(gsBunkersEdgeCreditsFile, "OnEndOfBunkersEdgeCredits", "", cVector3f_Zero, gsBunkersEdgeCreditsMusic);
		}

		void OnEndOfBunkersEdgeCredits()
		{
			Music_StopAll(2.f);
			Sound_FadeGlobalVolume(1.f, 0.5f, eSoundEntryType_WorldAll);
			MainMenu_GameOver();
		}

		//-------------------------------------------------------

		void OnSubject_SitOnYouScream(const tString &in asSubject, bool abStartOfSubject)
		{
			if (abStartOfSubject) return;
			Voice_SetFocusScene("");
		}

		//-------------------------------------------------------

		bool Trigger_Conversation(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState != 1) return true;

			Player_SetActive(false);

			Voice_SetSource("Grunt", "Grunt", 1.f, 20.f, true);
			Voice_SetFocusScene("General");

			Dialog_Begin("SittingRoomConversation");
				Dialog_AddBranch("Opening");
					Dialog_AddSubject("SeeingGrunt");
					AddAllSittingRoomQuestions();

				AddSittingRoomQuestionBranch("Question_1", "question_1");
				AddSittingRoomQuestionBranch("Question_2", "question_2");
				AddSittingRoomQuestionBranch("Question_3", "question_3");
				AddSittingRoomQuestionBranch("Question_4", "question_4");
				AddSittingRoomQuestionBranch("Question_5", "question_5");
				AddSittingRoomQuestionBranch("Question_6", "question_6");
				AddSittingRoomQuestionBranch("Question_7", "question_7");
				AddSittingRoomQuestionBranch("Question_8", "question_8");
				AddSittingRoomQuestionBranch("Question_9", "question_9");
				AddSittingRoomQuestionBranch("Question_10", "question_10");
				AddSittingRoomQuestionBranch("Question_11", "question_11");

				Dialog_AddBranch("Finale");
					Dialog_AddSubject("SitOnYou_Threat", "OnSubject_SitOnYouThreat");
					Dialog_AddSubject("SitOnYou_Plea");
					Dialog_AddSubject("SitOnYou_Laughter");
					Dialog_AddSubject("SitOnYou_Scream", "OnSubject_SitOnYouScream");

				Dialog_StartConversation_PosBased("Grunt", "Grunt", "ConversationSource", "CenterHead");

			Dialog_End("Opening");

			return false;
		}

		//-------------------------------------------------------

		//} END Event *Name Of Event*
	 
	//} END SCENE X 
}
