const float gfBeastTraversalApproachFallDistance = 1.25f;
const int glBeastTraversalMaxLaunchRecoveries = 1;


//--------------------------------------------------
 
/*Place any global values here. These must be const variables as they will not be saved*/
/*This is also the place for enums and classes, but these should be avoided whenever possible*/
 
//--------------------------------------------------
 
class cScrMap : iScrMap
{
	//--------------------------------------------
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN CALLBACKS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	////////////////////////////
	// Set up map environment
	void Setup()
	{
		// Put display name entry in english.lang / Levels
		GetBase().SetDisplayNameEntry("parkour-level");
		
		// etc.
		Map_SetSkyboxRotation(cVector3f(0, cMath_ToRad(45), 0));

		Light_FadeTo("Light_Box_45", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_46", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_47", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_52", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_55", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_56", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_23", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_21", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_42", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_43", cColor(0,0,0,0), -1, 1.0f);
		Light_FadeTo("Light_Box_49", cColor(0,0,0,0), -1, 1.0f);
	}
	
	//-------------------------------------------------------
		
	void PreloadData()
	{
		/////////////////
		// Preload gui
		//ImGui_PreloadImage("some_image");

		///////////////
		// Preload particles
		//ParticleSystem_Preload("some_particle.ps");

		//////////////
		// Preload screen effects
		//Material_Preload("some_material.mat");
	}
	
	//-------------------------------------------------------

	////////////////////////////
	// Run first time starting map
	void OnStart()
	{
		// Any general setup of script / entities
		SetupStalkerJumpNetwork();
		SetupStalkerNarrowBodySections();

		Music_PlayExt("amb.ogg", true, 0.6f, 1.0f, 1.0f, 0.0f, eMusicPrio_AgentAmb, true);

		/////////////////////////
		// Debug
		if (cLux_ScriptDebugOn())
		{
		}
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when entering map
	void OnEnter()
	{	
		EnsureStalkerNarrowBodySectionsSetup();
		SetBeastNarrowSectionBody(false);
		Entity_SetActive("stalker", false);
		cScript_SetGlobalArgBool(0, false);
		cScript_RunGlobalFunc("stalker", "cScrAgentStalker", "_Global_SetLampsFlicker");


		///////////////////////
		// Setup player body
		if (PlayerBody_IsActive() == false)
		{
			PlayerBody_SetActive(true);
			PlayerBody_SetModel("player_bunker.ent");
			Parkour_SetEnabled(true);
			Parkour_SetDebug(true);
			Player_SetAmbientLight_None();
		}

		Player_SetGravity(cVector3f(0,-18,0));
		Sketchbook_SetInventoryEnabled(false);

		Light_FadeBrightnessTo("Light_RunnerObject_Helper_*", 0, 0, eEasing_Linear);
	}

	//-------------------------------------------------------

	////////////////////////////
	// Run when leaving map
	void OnLeave()
	{
		SetBeastNarrowSectionBody(false);
	}
	
	//-------------------------------------------------------

	int jumpArea = 1;

	////////////////////////////
	// To get when player makes input (mostly used for debug)
	void OnAction(int alAction, bool abPressed) 
	{
		if (abPressed == false) return;
		
		if (alAction == eAction_Test0)
		{
			
			Stalker_Jump("stalker", "Jump_interior_Target_" + jumpArea);
			jumpArea++;
		}
	}

	//-------------------------------------------------------



	////////////////////////////
	// This only used for pure debug purposes when info needs to printed.
	float DrawDebugOutput(cGuiSet@ apSet, iFontData@ apFont, float afY)
	{
		//afY = cLux_DrawDebugText("My Debug value:"+..., afY);
		return afY;
	}
 
	//-------------------------------------------------------
 
	//} END MAIN CALLBACKS
 
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// MAIN FUNCTIONS
	// ==============
	//{///////////////////////////////////////////////////////////////////////////////////////
 
	//-------------------------------------------------------
 
	bool Trigger_RunnerObjectLight(const tString &in asParent, const tString &in asChild, int alState)
	{
		tString lights = Entity_GetVarString(asParent, "");
		float fBrightness;

		if (alState == 1)
		{
			fBrightness = 1.0f;

			if (cString_GetFirstStringPos(lights, "Light_RunnerObject_Helper_6") >= 0 
			|| cString_GetFirstStringPos(lights, "Light_RunnerObject_Helper_5") >= 0) 
			{
				fBrightness = 3.0f;
			}
		}
		else
		{
			fBrightness = 0.0f;
		}

		Light_FadeBrightnessTo(lights, fBrightness, 0.5f);

		return true;
	}
 
	//-------------------------------------------------------

	bool IndoorLightingArea_DoorWay(const tString &in asArea, const tString &in asEntity, int alState)
	{
		if (alState == 1)
		{
			Effect_ToneMapping_FadeWorldGrading("grading_parkour_interior.dds", 2.0f);
			Light_FadeTo("Light_Box_45", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_47", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_46", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_52", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_55", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_56", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_23", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_21", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_42", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_43", cColor_White, -1, 1.0f);
			Light_FadeTo("Light_Box_49", cColor_White, -1, 1.0f);

		}
		else
		{
			Effect_ToneMapping_FadeWorldGrading("grading_parkour_new.dds", 2.0f);
			Light_FadeTo("Light_Box_45", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_47", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_46", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_52", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_55", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_56", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_23", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_21", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_42", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_43", cColor(0,0,0,0), -1, 1.0f);
			Light_FadeTo("Light_Box_49", cColor(0,0,0,0), -1, 1.0f);
		}

		return true;
	}

	//-------------------------------------------------------

	void Stalker_Jump(const tString&in asStalkerName, const tString&in asTarget,
		bool abHighJump = false)
	{
		cScript_SetGlobalArgBool(0, abHighJump);
		cScript_RunGlobalFunc(asStalkerName, "cScrAgentStalker", "_Global_BossFight_SetNextJumpHigh");

		cScript_SetGlobalArgVector3f(0, Entity_GetPosition(asTarget));
		cScript_RunGlobalFunc(asStalkerName, "cScrAgentStalker", "_Global_SetClosestJumpPos");

		cScript_SetGlobalArgVector3f(0, Entity_GetPosition(asTarget));
		cScript_SetGlobalArgBool(1, true);
		cScript_SetGlobalArgBool(2, false);
		cScript_SetGlobalArgBool(3, false);
		cScript_RunGlobalFunc(asStalkerName, "cScrAgentStalker", "_Global_Jump");
	}

	//-------------------------------------------------------
	
	//} END MAIN FUNCTIONS
 
	//////////////////////////////////////////////////////////////////////////////////////////
	// ==============
	// SCENE X *NAME OF SCENE*
	// ==============
	//{//////////////////////////////////////////////////////////////////////////////////////
 
		/////////////////////////////////////////
		// General
		//{//////////////////////////////////////
		 
		//-------------------------------------------------------

		cStalkerJumpNetwork mStalkerJumpNetwork;
		array<tString> mvBeastNarrowSectionAreas;
		tString msPlayerStalkerRegion = "";
		tString msBeastStalkerRegion = "";
		bool mbBeastActivated = false;
		bool mbBeastTraversalActive = false;
		bool mbBeastExternalTraversalActive = false;
		bool mbBeastTraversalHighJump = false;
		bool mbBeastNarrowSectionActive = false;
		bool mbBeastNodePathChaseActive = false;
		bool mbBeastTraversalRetryBlocked = false;
		float mfBeastTraversalTime = 0.0f;
		float mfBeastTraversalHighestApproachY = 0.0f;
		int mlBeastTraversalLaunchRecoveryCount = 0;
		tString msBeastTraversalStage = "";
		tString msBeastTraversalRouteId = "";
		tString msBeastTraversalLaunchNode = "";
		tString msBeastTraversalJumpTarget = "";
		tString msBeastTraversalTargetRegion = "";
		tString msBeastLastRouteWarning = "";
		tString msBeastSameRegionRouteLatch = "";

		//-------------------------------------------------------

		void RegisterStalkerNarrowBodySection(const tString &in asAreaName)
		{
			if (asAreaName == "") return;

			for (uint i = 0; i < mvBeastNarrowSectionAreas.size(); ++i)
			{
				if (mvBeastNarrowSectionAreas[i] == asAreaName)
					return;
			}

			mvBeastNarrowSectionAreas.push_back(asAreaName);
		}

		//-------------------------------------------------------

		void SetupStalkerNarrowBodySections()
		{
			mvBeastNarrowSectionAreas.resize(0);
			RegisterStalkerNarrowBodySection("Trigger_StalkerNarrowSection_1");
		}

		//-------------------------------------------------------

		void EnsureStalkerNarrowBodySectionsSetup()
		{
			if (mvBeastNarrowSectionAreas.size() == 0)
				SetupStalkerNarrowBodySections();
		}

		//-------------------------------------------------------

		void SetBeastNarrowSectionBody(bool abActive)
		{
			if (mbBeastNarrowSectionActive != abActive)
			{
				mbBeastNarrowSectionActive = abActive;
				Debug_Log("Stalker narrow-section body: " + abActive, false);
			}

			cScript_SetGlobalArgBool(0, abActive);
			cScript_RunGlobalFunc("stalker", "cScrAgentStalker", "_Global_SetNarrowSectionBodyActive");
		}

		//-------------------------------------------------------

		void UpdateBeastNarrowSectionBody()
		{
			EnsureStalkerNarrowBodySectionsSetup();

			bool bInsideNarrowSection = false;
			for (uint i = 0; i < mvBeastNarrowSectionAreas.size(); ++i)
			{
				if (mStalkerJumpNetwork.IsAgentInsideArea("stalker", mvBeastNarrowSectionAreas[i]))
				{
					bInsideNarrowSection = true;
					break;
				}
			}

			SetBeastNarrowSectionBody(bInsideNarrowSection);
		}

		//-------------------------------------------------------

		void SetupStalkerJumpNetwork()
		{
			bool bValid = mStalkerJumpNetwork.Discover("stalker");
			Debug_Log("Discovered " + mStalkerJumpNetwork.GetRegionCount() +
				" Stalker jump region group(s) and " + mStalkerJumpNetwork.GetRouteCount() +
				" directed route(s).", false);
			int lSameRegionRouteCount = mStalkerJumpNetwork.GetSameRegionRouteCount();
			if (lSameRegionRouteCount > 0)
				Debug_Log("Discovered " + lSameRegionRouteCount + " same-region Stalker jump route(s).", false);

			if (bValid == false)
				Debug_Log("Editor-authored Stalker jump network has validation errors.", false);
		}

		//-------------------------------------------------------

		void EnsureStalkerJumpNetworkSetup()
		{
			if (mStalkerJumpNetwork.GetRegionCount() == 0)
				SetupStalkerJumpNetwork();
		}

		//-------------------------------------------------------

		void SetBeastBossFightBehaviour(int alBehaviour)
		{
			cScript_SetGlobalArgInt(0, alBehaviour);
			cScript_RunGlobalFunc("stalker", "cScrAgentStalker", "_Global_BossFight_UpdateBehaviour");
		}

		//-------------------------------------------------------

		void SetBeastExternalTraversal(bool abActive)
		{
			if (mbBeastExternalTraversalActive == abActive) return;

			mbBeastExternalTraversalActive = abActive;
			cScript_SetGlobalArgBool(0, abActive);
			cScript_RunGlobalFunc("stalker", "cScrAgentStalker", "_Global_BossFight_SetExternalTraversalActive");
		}

		//-------------------------------------------------------

		void SetBeastAlwaysChase(bool abActive)
		{
			cScript_SetGlobalArgBool(0, abActive);
			cScript_RunGlobalFunc("stalker", "cScrAgentStalker", "_Global_BossFight_SetAlwaysChase");
		}

		//-------------------------------------------------------

		void RefreshStalkerRegions()
		{
			msPlayerStalkerRegion = mStalkerJumpNetwork.ResolvePlayerRegion(msPlayerStalkerRegion);
			msBeastStalkerRegion = mStalkerJumpNetwork.ResolveAgentRegion("stalker", msBeastStalkerRegion);
		}

		//-------------------------------------------------------

		void LogBeastRouteWarning(const tString &in asWarning)
		{
			if (msBeastLastRouteWarning == asWarning) return;

			msBeastLastRouteWarning = asWarning;
			Debug_Log("Stalker jump router: " + asWarning, false);
		}

		//-------------------------------------------------------

		void ClearBeastRouteWarning()
		{
			msBeastLastRouteWarning = "";
		}

		//-------------------------------------------------------

		void ReleaseBeastTraversalControl()
		{
			if (mbBeastExternalTraversalActive == false) return;

			SetBeastExternalTraversal(false);
			SetBeastBossFightBehaviour(0);
		}

		//-------------------------------------------------------

		void EnableBeastNodePathChase()
		{
			// BossFightDefault resolves the PathNode nearest the player and moves
			// to that node every 0.1 seconds while external traversal is disabled.
			ReleaseBeastTraversalControl();
			if (mbBeastNodePathChaseActive) return;

			mbBeastNodePathChaseActive = true;
			SetBeastAlwaysChase(true);
			SetBeastBossFightBehaviour(0);
		}

		//-------------------------------------------------------

		bool BeginBeastTraversal(const tString &in asRouteId, bool abForceSourceRegion = false)
		{
			if (mbBeastActivated == false || mbBeastTraversalActive) return false;

			cStalkerJumpRoute@ pRoute = mStalkerJumpNetwork.GetRoute(asRouteId);
			if (pRoute is null)
			{
				LogBeastRouteWarning("unknown route '" + asRouteId + "'.");
				ReleaseBeastTraversalControl();
				return false;
			}

			if (abForceSourceRegion)
				msBeastStalkerRegion = pRoute.msSourceRegionId;
			else if (msBeastStalkerRegion != pRoute.msSourceRegionId)
			{
				LogBeastRouteWarning("route '" + asRouteId + "' expects source region '" +
					pRoute.msSourceRegionId + "', but the Stalker is in '" + msBeastStalkerRegion + "'.");
				ReleaseBeastTraversalControl();
				return false;
			}

			ClearBeastRouteWarning();
			msBeastTraversalRouteId = pRoute.msId;
			msBeastTraversalLaunchNode = pRoute.msLaunchNodeName;
			msBeastTraversalJumpTarget = pRoute.msLandingAreaName;
			msBeastTraversalTargetRegion = pRoute.msDestinationRegionId;
			mbBeastTraversalHighJump = pRoute.mbHighJump;
			msBeastTraversalStage = "moving";
			mfBeastTraversalTime = 0.0f;
			mfBeastTraversalHighestApproachY = Entity_GetPosition("stalker").y;
			mlBeastTraversalLaunchRecoveryCount = 0;
			mbBeastTraversalActive = true;
			mbBeastNodePathChaseActive = false;
			mbBeastTraversalRetryBlocked = false;

			Debug_Log("Stalker traversal route '" + pRoute.msId + "': " +
				pRoute.msSourceRegionId + " -> " + pRoute.msDestinationRegionId +
				", HighJump=" + pRoute.mbHighJump, false);

			// Keep boss behaviour in Default chase mode, but temporarily let the
			// map own the pathfinder so the chase loop cannot overwrite this route.
			SetBeastBossFightBehaviour(0);
			SetBeastExternalTraversal(true);

			cVector3f vToLaunch = Entity_GetPosition(msBeastTraversalLaunchNode) - Entity_GetPosition("stalker");
			if (vToLaunch.SqrLength() <= 1.25f * 1.25f)
				BeastReachedTraversalLaunch("stalker", true);
			else
				Pathfinder_MoveToNode("stalker", msBeastTraversalLaunchNode, "BeastReachedTraversalLaunch");

			Map_RemoveTimer("BeastTraversalWatchdog");
			Map_AddTimer("BeastTraversalWatchdog", 0.1f, "UpdateBeastTraversal");
			return true;
		}

		//-------------------------------------------------------

		bool RecoverBeastTraversalAtLaunch(const tString &in asReason)
		{
			if (mbBeastTraversalActive == false || msBeastTraversalStage != "moving" ||
				mlBeastTraversalLaunchRecoveryCount >= glBeastTraversalMaxLaunchRecoveries)
			{
				return false;
			}

			iLuxEntity@ pEntity = Map_GetEntity("stalker", eLuxEntityType_Agent);
			cLuxAgent@ pAgent = cLux_ToAgent(pEntity);
			if (pAgent is null || pAgent.GetCharBody() is null)
				return false;

			iCharacterBody@ pCharBody = pAgent.GetCharBody();
			cVector3f vRecoveryFeetPos = Entity_GetPosition(msBeastTraversalLaunchNode) +
				cVector3f_Up * 0.05f;
			cVector3f vPushBack;
			int lRecoveryBodySize = pCharBody.GetActiveSize();
			if (lRecoveryBodySize == 1)
				lRecoveryBodySize = 0;
			if (pCharBody.CheckCharacterFits(vRecoveryFeetPos, true, lRecoveryBodySize, vPushBack) == false)
			{
				Debug_Log("Stalker traversal could not recover at launch node '" +
					msBeastTraversalLaunchNode + "' because its route body does not fit.", false);
				return false;
			}

			Pathfinder_Stop("stalker");
			pCharBody.StopMovement();
			pCharBody.SetForceVelocity(cVector3f(0.0f));
			pCharBody.SetFeetPosition(vRecoveryFeetPos, false);

			++mlBeastTraversalLaunchRecoveryCount;
			msBeastTraversalStage = "recovering";
			mfBeastTraversalTime = 0.0f;
			mfBeastTraversalHighestApproachY = vRecoveryFeetPos.y;
			Debug_Log("Stalker traversal recovered at launch node '" +
				msBeastTraversalLaunchNode + "' after " + asReason + ".", false);
			return true;
		}

		//-------------------------------------------------------

		void BeastReachedTraversalLaunch(const tString &in asEntityName, bool abReachedEnd)
		{
			if (mbBeastTraversalActive == false || msBeastTraversalStage != "moving") return;
			if (abReachedEnd == false)
			{
				if (RecoverBeastTraversalAtLaunch("pathfinder failure"))
				{
					Map_RemoveTimer("BeastTraversalWatchdog");
					Map_AddTimer("BeastTraversalWatchdog", 0.1f, "UpdateBeastTraversal");
					return;
				}

				AbortBeastTraversal("could not reach launch PathNode '" + msBeastTraversalLaunchNode + "'");
				return;
			}

			msBeastTraversalStage = "jumping";
			mfBeastTraversalTime = 0.0f;
			Stalker_Jump(asEntityName, msBeastTraversalJumpTarget, mbBeastTraversalHighJump);
		}

		//-------------------------------------------------------

		void EvaluateBeastTraversal()
		{
			if (mbBeastActivated == false || mbBeastTraversalActive || mbBeastTraversalRetryBlocked) return;

			EnsureStalkerJumpNetworkSetup();
			RefreshStalkerRegions();
			if (msBeastSameRegionRouteLatch != "" &&
				mStalkerJumpNetwork.IsPlayerInsideRouteLanding(msBeastSameRegionRouteLatch) == false)
			{
				msBeastSameRegionRouteLatch = "";
			}

			if (msPlayerStalkerRegion == "" || msBeastStalkerRegion == "")
			{
				EnableBeastNodePathChase();
				LogBeastRouteWarning("actor outside registered regions (Stalker='" +
					msBeastStalkerRegion + "', player='" + msPlayerStalkerRegion +
					"'); using strict Stalker PathNode chase.");
				return;
			}

			if (msPlayerStalkerRegion == msBeastStalkerRegion)
			{
				cStalkerJumpRoute@ pSameRegionRoute = mStalkerJumpNetwork.GetTriggeredSameRegionRoute(
					msPlayerStalkerRegion, "stalker", msBeastSameRegionRouteLatch);
				if (pSameRegionRoute !is null)
				{
					ClearBeastRouteWarning();
					BeginBeastTraversal(pSameRegionRoute.msId);
					return;
				}

				ClearBeastRouteWarning();
				EnableBeastNodePathChase();
				return;
			}

			cStalkerJumpRoute@ pRoute = mStalkerJumpNetwork.GetFirstRoute(msBeastStalkerRegion,
				msPlayerStalkerRegion);
			if (pRoute is null)
			{
				EnableBeastNodePathChase();
				LogBeastRouteWarning("no directed route from '" + msBeastStalkerRegion +
					"' to '" + msPlayerStalkerRegion + "'; using strict Stalker PathNode chase.");
				return;
			}

			ClearBeastRouteWarning();
			BeginBeastTraversal(pRoute.msId);
		}

		//-------------------------------------------------------

		void AbortBeastTraversal(const tString &in asReason)
		{
			Debug_Log("Stalker traversal aborted: " + asReason, false);

			bool bWasMoving = msBeastTraversalStage == "moving";
			Map_RemoveTimer("BeastTraversalWatchdog");
			if (bWasMoving)
				Pathfinder_Stop("stalker");

			mbBeastTraversalActive = false;
			msBeastTraversalStage = "";
			msBeastTraversalRouteId = "";
			msBeastTraversalLaunchNode = "";
			msBeastTraversalJumpTarget = "";
			msBeastTraversalTargetRegion = "";
			mbBeastTraversalHighJump = false;
			mfBeastTraversalTime = 0.0f;
			mfBeastTraversalHighestApproachY = 0.0f;
			mlBeastTraversalLaunchRecoveryCount = 0;
			mbBeastTraversalRetryBlocked = true;

			SetBeastExternalTraversal(false);
			SetBeastBossFightBehaviour(0);
			Map_RemoveTimer("ReevaluateBeastTraversal");
			Map_AddTimer("ReevaluateBeastTraversal", 0.5f, "ReevaluateBeastTraversal");
		}

		//-------------------------------------------------------

		void FinishBeastTraversal(const tString &in asTimer)
		{
			if (mbBeastTraversalActive == false) return;

			cStalkerJumpRoute@ pCompletedRoute = mStalkerJumpNetwork.GetRoute(msBeastTraversalRouteId);
			if (pCompletedRoute !is null &&
				pCompletedRoute.msSourceRegionId == pCompletedRoute.msDestinationRegionId)
			{
				msBeastSameRegionRouteLatch = pCompletedRoute.msId;
			}

			tString sDestinationRegion = msBeastTraversalTargetRegion;
			Map_RemoveTimer("BeastTraversalWatchdog");

			msBeastStalkerRegion = sDestinationRegion;
			mbBeastTraversalActive = false;
			msBeastTraversalStage = "";
			msBeastTraversalRouteId = "";
			msBeastTraversalLaunchNode = "";
			msBeastTraversalJumpTarget = "";
			msBeastTraversalTargetRegion = "";
			mbBeastTraversalHighJump = false;
			mfBeastTraversalTime = 0.0f;
			mfBeastTraversalHighestApproachY = 0.0f;
			mlBeastTraversalLaunchRecoveryCount = 0;
			mbBeastTraversalRetryBlocked = false;

			// Hand the pathfinder back to Default boss chase after the jump.
			SetBeastExternalTraversal(false);
			SetBeastBossFightBehaviour(0);
			Map_RemoveTimer("ReevaluateBeastTraversal");
			Map_AddTimer("ReevaluateBeastTraversal", 0.1f, "ReevaluateBeastTraversal");
		}

		//-------------------------------------------------------

		void ReevaluateBeastTraversal(const tString &in asTimer)
		{
			mbBeastTraversalRetryBlocked = false;
			EvaluateBeastTraversal();
		}

		//-------------------------------------------------------

		void StartBeastRouteEvaluator()
		{
			Map_RemoveTimer("BeastRouteEvaluator");
			Map_AddTimer("BeastRouteEvaluator", 0.25f, "UpdateBeastRouteEvaluator");
		}

		//-------------------------------------------------------

		void UpdateBeastRouteEvaluator(const tString &in asTimer)
		{
			if (mbBeastActivated == false) return;

			EnsureStalkerJumpNetworkSetup();
			UpdateBeastNarrowSectionBody();
			RefreshStalkerRegions();
			if (mbBeastTraversalActive == false && mbBeastTraversalRetryBlocked == false)
				EvaluateBeastTraversal();

			Map_AddTimer("BeastRouteEvaluator", 0.25f, "UpdateBeastRouteEvaluator");
		}

		//-------------------------------------------------------

		void BeginBeastLandingHandoff()
		{
			if (mbBeastTraversalActive == false || msBeastTraversalStage != "jumping") return;

			msBeastStalkerRegion = msBeastTraversalTargetRegion;
			msBeastTraversalStage = "landing";
			mfBeastTraversalTime = 0.0f;
		}

		//-------------------------------------------------------

		bool BeastTraversalReachedLanding()
		{
			cStalkerJumpRoute@ pRoute = mStalkerJumpNetwork.GetRoute(msBeastTraversalRouteId);
			if (pRoute is null) return false;

			if (pRoute.msSourceRegionId == pRoute.msDestinationRegionId)
				return mStalkerJumpNetwork.IsAgentInsideArea("stalker", pRoute.msLandingAreaName);

			return mStalkerJumpNetwork.IsAgentInsideRegion("stalker", msBeastTraversalTargetRegion);
		}

		//-------------------------------------------------------

		void UpdateBeastTraversal(const tString &in asTimer)
		{
			if (mbBeastTraversalActive == false) return;

			mfBeastTraversalTime += 0.1f;

			if (msBeastTraversalStage == "moving")
			{
				cVector3f vStalkerPos = Entity_GetPosition("stalker");
				mfBeastTraversalHighestApproachY = cMath_Max(
					mfBeastTraversalHighestApproachY, vStalkerPos.y);
				float fApproachDrop = mfBeastTraversalHighestApproachY - vStalkerPos.y;
				float fBelowLaunch = Entity_GetPosition(msBeastTraversalLaunchNode).y - vStalkerPos.y;

				if (fApproachDrop >= gfBeastTraversalApproachFallDistance &&
					fBelowLaunch >= gfBeastTraversalApproachFallDistance)
				{
					if (RecoverBeastTraversalAtLaunch("falling " + fApproachDrop +
						" metres below the approach platform") == false)
					{
						AbortBeastTraversal("fell below launch PathNode '" +
							msBeastTraversalLaunchNode + "' and recovery failed");
						return;
					}
				}
				else
				{
					cVector3f vToLaunch = Entity_GetPosition(msBeastTraversalLaunchNode) - vStalkerPos;
					if (vToLaunch.SqrLength() <= 1.25f * 1.25f)
					{
						BeastReachedTraversalLaunch("stalker", true);
					}
					else if (mfBeastTraversalTime >= 10.0f)
					{
						if (RecoverBeastTraversalAtLaunch("approach timeout") == false)
						{
							AbortBeastTraversal("timed out while moving to " + msBeastTraversalLaunchNode);
							return;
						}
					}
				}
			}
			else if (msBeastTraversalStage == "recovering" && mfBeastTraversalTime >= 0.1f)
			{
				msBeastTraversalStage = "moving";
				BeastReachedTraversalLaunch("stalker", true);
			}
			else if (msBeastTraversalStage == "jumping")
			{
				if (BeastTraversalReachedLanding())
				{
					BeginBeastLandingHandoff();
				}
				else if (mfBeastTraversalTime >= 6.5f)
				{
					// The agent's six-second AlwaysChase jump failsafe has now had time
					// to run. Rescan once, then either hand off or retry the edge.
					if (BeastTraversalReachedLanding())
						BeginBeastLandingHandoff();
					else
					{
						AbortBeastTraversal("jump route '" + msBeastTraversalRouteId +
							"' did not reach region '" + msBeastTraversalTargetRegion + "'");
						return;
					}
				}
			}
			else if (msBeastTraversalStage == "landing" && mfBeastTraversalTime >= 0.5f)
			{
				FinishBeastTraversal("");
				return;
			}

			Map_AddTimer("BeastTraversalWatchdog", 0.1f, "UpdateBeastTraversal");
		}

		//-------------------------------------------------------

		void OnStalkerMoveTo(int alBehaviour, const cVector3f &in avGoalPos)
		{
			// The stock boss state calls this before every chase request. Keep it as
			// an immediate routing hook in addition to the independent 0.25s scan.
			RefreshStalkerRegions();
			EvaluateBeastTraversal();
		}

		//-------------------------------------------------------
	 
		bool ActivateBeast(const tString &in asParent, const tString &in asChild, int alState)
		{
			if (alState == 1 && mbBeastActivated == false)
			{
				EnsureStalkerJumpNetworkSetup();
				Entity_SetActive("stalker", true);
				cScript_RunGlobalFunc("stalker", "cScrAgentStalker", "_Global_BossFight_Enter");

				mbBeastActivated = true;
				SetBeastAlwaysChase(true);
				Stalker_SetMode("stalker", eStalkerMode_Active);
				UpdateBeastNarrowSectionBody();

				RefreshStalkerRegions();
				StartBeastRouteEvaluator();

				// Preserve the staged opening, but select it from the editor-authored
				// StartOnActivation flag instead of a hardcoded route ID.
				tString sActivationRoute = mStalkerJumpNetwork.GetActivationRouteId();
				if (sActivationRoute != "")
					BeginBeastTraversal(sActivationRoute, true);
				else
				{
					LogBeastRouteWarning("no StartOnActivation route was discovered; starting normal pursuit.");
					EvaluateBeastTraversal();
				}

				Music_PlayExt("chase_1.ogg", true, 0.4f, 1.0f, 0.0f, 0.0f, eMusicPrio_AgentHunt, true);

			}

			return false;
		}
	 
		//-------------------------------------------------------

		bool Trigger_UpdateChaseMusic(const tString &in asParent, const tString &in asChild, int alState)
		{
			
			tString sMusicPart = Entity_GetVarString(asParent, "");
			
			Music_PlayExt("chase_" + sMusicPart + ".ogg", true, 0.4f, 1.0f, 1.0f, 0.5f, eMusicPrio_AgentHunt, true);

			return true;
		}
	 
	//} END SCENE X 
}
