			"Trigger_17");
			RegisterStalkerJumpRoute("exterior_roof_vent_4",
			"exterior_roof_3",
			"exterior_roof_2",
			"PathNode_145",
			"Trigger_19");
			RegisterStalkerJumpRoute("exterior_roof_vent_5",
			"exterior_roof_4",
			"exterior_roof_4",
			"PathNode_230",
			"Trigger_26");
			RegisterStalkerJumpRoute("exterior_roof_vent_6",
			"exterior_roof_5",
			"exterior_roof_5",
			"PathNode_240",
			"Trigger_25");
			RegisterStalkerJumpRoute("exterior_roof_vent_7",
			"exterior_roof_6",
			"exterior_roof_6",
