                    <rotate sid="Rotation__8_X">1 0 0 0</rotate>
                    <rotate sid="Rotation__8_Z">0 0 1 0</rotate>
                    <scale sid="Scale__7_">1 1 1</scale>
                </node>
                <node id="03_02_divingsuit_locker_utilities__Image___Texture_Node" name="03_02_divingsuit_locker_utilities__Image___Texture_" type="NODE">
                    <translate sid="Position__9_">0 0 0</translate>
