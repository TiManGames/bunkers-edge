                </technique>
            </extra>
            <extra>
                <technique profile="MAYA">
                    <start_time>0</start_time>
                    <end_time>5</end_time>
                </technique>
            </extra>
            <extra>
                <technique profile="OKINO" />
            </extra>
            <extra>
                <technique profile="XSI">
                    <SI_Scene>
                        <frame_rate>30</frame_rate>
                    </SI_Scene>
                </technique>
            </extra>
        </visual_scene>
    </library_visual_scenes>
    <scene>
        <instance_visual_scene url="#DefaultScene" />
    </scene>
</COLLADA>
