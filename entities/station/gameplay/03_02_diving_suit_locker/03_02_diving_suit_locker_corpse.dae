                    <scale sid="Scale__3_">1 1 1</scale>
                </node>
                <node id="03_02_divingsuit_locker__Image___2___Texture_Node" name="03_02_divingsuit_locker__Image___2___Texture_" type="NODE">
                    <translate sid="Position__8_">0 0 0</translate>
