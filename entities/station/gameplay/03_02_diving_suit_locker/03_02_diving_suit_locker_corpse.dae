                            <rotate sid="Rotation__4_X">1 0 0 0</rotate>
                            <rotate sid="Rotation__4_Z">0 0 1 0</rotate>
                            <scale sid="Scale__4_">1 1 1</scale>
                            <instance_geometry url="#Geometry-body">
                                <bind_material>
                                    <technique_common>
                                        <instance_material symbol="Material-corpse" target="#Material-corpse">
                                            <bind_vertex_input semantic="Texture" input_semantic="TEXCOORD" />
                                        </instance_material>
                                    </technique_common>
                                </bind_material>
                            </instance_geometry>
                        </node>
                        <node id="Geometry-flesher_helmetNode" name="flesher_helmet" type="NODE">
                            <instance_geometry url="#Geometry-flesher_helmet">
                                <bind_material>
                                    <technique_common>
                                        <instance_material symbol="Material-helmet" target="#Material-helmet">
                                            <bind_vertex_input semantic="Texture" input_semantic="TEXCOORD" />
                                        </instance_material>
                                    </technique_common>
                                </bind_material>
                            </instance_geometry>
                        </node>
                    </node>
                </node>
                <node id="Geometry-utility_piecesNode" name="utility_pieces" type="NODE">
                    <translate sid="Position__5_">0 0 0</translate>
                    <rotate sid="Rotation__5_Y">0 1 0 0</rotate>
                    <rotate sid="Rotation__5_X">1 0 0 0</rotate>
                    <rotate sid="Rotation__5_Z">0 0 1 0</rotate>
                    <scale sid="Scale__6_">1 1 1</scale>
                    <instance_geometry url="#Geometry-utility_pieces">
                        <bind_material>
                            <technique_common>
                                <instance_material symbol="Material-utility" target="#Material-utility">
                                    <bind_vertex_input semantic="Texture" input_semantic="TEXCOORD" input_set="0" />
                                </instance_material>
                            </technique_common>
                        </bind_material>
                    </instance_geometry>
                </node>
            </node>
            <node id="Camera-CameraNode" name="Camera" type="NODE">
                <translate sid="Position__7_">3.40678 1.79142 2.23275</translate>
                <rotate sid="Rotation__7_Y">0 1 0 57.2958</rotate>
                <rotate sid="Rotation__7_X">1 0 0 -12.4485</rotate>
                <rotate sid="Rotation__7_Z">0 0 1 0</rotate>
                <instance_camera url="#Camera-Camera" />
            </node>
            <node id="Texture_GroupNode" name="Texture_Group" type="NODE">
                <node id="deepsea_diver_body__Image___Texture_Node" name="deepsea_diver_body__Image___Texture_" type="NODE">
                    <translate sid="Position">0 0 0</translate>
