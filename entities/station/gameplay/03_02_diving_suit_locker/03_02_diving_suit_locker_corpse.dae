                    <translate sid="Position__10_">0 0 0</translate>
                    <rotate sid="Rotation__10_Y">0 1 0 0</rotate>
                    <rotate sid="Rotation__10_X">1 0 0 0</rotate>
                    <rotate sid="Rotation__10_Z">0 0 1 0</rotate>
                    <scale sid="Scale__9_">1 1 1</scale>
