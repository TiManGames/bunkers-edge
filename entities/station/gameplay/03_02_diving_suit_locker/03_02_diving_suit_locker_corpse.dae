                    <scale sid="Scale__2_">1 1 1</scale>
                </node>
                <node id="deepsea_diver_helmet__Image___Texture_Node" name="deepsea_diver_helmet__Image___Texture_" type="NODE">
                    <translate sid="Position__3_">0 0 0</translate>
