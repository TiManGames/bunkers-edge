                </polylist>
                <extra>
                    <technique profile="modo401">
                        <param sid="render" name="Render" type="Name">default</param>
                        <param sid="dissolve" name="Dissolve" type="float">0</param>
                        <param sid="curves" name="Render_Curves" type="bool">false</param>
