                        0.61716 1.38597 2.01731
                        1.06828 2.04434 1.99298
                        0.61707 2.04429 1.99725
                        1.06819 1.38602 1.98977
                    </float_array>
                    <technique_common>
                        <accessor count="4" source="#Geometry-screen-positions-array" stride="3">
                            <param name="X" type="float" />
                            <param name="Y" type="float" />
                            <param name="Z" type="float" />
                        </accessor>
                    </technique_common>
