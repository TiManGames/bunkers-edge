                        0.0352065 0.0127724 0.999298
                        0.00946361 -0.00487681 0.999943
                    </float_array>
                    <technique_common>
                        <accessor count="3" source="#Geometry-screen-normals-array" stride="3">
                            <param name="X" type="float" />
                            <param name="Y" type="float" />
                            <param name="Z" type="float" />
                        </accessor>
