                    <param sid="day" name="Day" type="int">2012173</param>
                    <param sid="elevation" name="Elevation" type="float">0</param>
                    <param sid="haze" name="Haze" type="float">2</param>
                    <param sid="height" name="Height" type="float">10</param>
