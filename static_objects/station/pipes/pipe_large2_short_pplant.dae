            <extra>
                <technique profile="XSI">
                    <SI_Scene>
                        <frame_rate>24</frame_rate>
                    </SI_Scene>
                </technique>
            </extra>
        </visual_scene>
    </library_visual_scenes>
    <scene>
        <instance_visual_scene url="#DefaultScene" />
    </scene>
</COLLADA>
