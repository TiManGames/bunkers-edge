                    <param sid="irrVals" name="Interpolation_Values" type="int">1</param>
                    <param sid="irrGrads" name="Irradiance_Gradients" type="Name">both</param>
                    <param sid="irrWalk" name="Walkthrough_Mode" type="bool">false</param>
