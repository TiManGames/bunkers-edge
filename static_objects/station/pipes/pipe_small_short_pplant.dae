                    <param sid="irrRays" name="Irradiance_Rays" type="int">256</param>
                    <param sid="globSuper" name="Indirect_Supersampling" type="bool">true</param>
                    <param sid="irrRate" name="Irradiance_Rate" type="float">2.5</param>
