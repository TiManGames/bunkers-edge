                </technique>
            </extra>
        </node>
    </library_nodes>
    <library_visual_scenes>
        <visual_scene id="DefaultScene">
            <node id="polyRender007" name="Render" type="NODE">
                <instance_light url="#Light-polyRender007" />
            </node>
            <node id="Geometry-polySurface101Node" name="polySurface101" type="NODE">
                <translate sid="translation001">0 0 0</translate>
                <rotate sid="rotation002Y">0 1 0 0</rotate>
                <rotate sid="rotation002X">1 0 0 0</rotate>
                <rotate sid="rotation002Z">0 0 1 0</rotate>
                <scale sid="scale003">1 1 1</scale>
                <instance_geometry url="#Geometry-polySurface101">
                    <bind_material>
                        <technique_common>
                            <instance_material symbol="Material-catwalk" target="#Material-catwalk">
                                <bind_vertex_input semantic="polySurfaceShape121-map1" input_semantic="TEXCOORD" input_set="0" />
                            </instance_material>
                        </technique_common>
                    </bind_material>
                </instance_geometry>
            </node>
            <node id="Camera-camera010Node" name="Camera" type="NODE">
