<Material>
    <Main BlendMode="Add" DepthTest="true" ForceFullScaleTextures="false" PhysicsMaterial="Rock Tiled" Type="projectedUV" UVSubDivs="1 1" UseAlpha="false" />
    <TextureUnits>
        <DiffuseSide AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="static_objects/environment/rocks/rock_huge.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <DiffuseTop AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="textures/terrain/sand/sand_wavy.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <DiffuseBottom AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="static_objects/environment/rocks/rock_huge.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <NMapSide AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="static_objects/environment/rocks/rock_huge_nrm.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <NMapTop AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="textures/terrain/sand/sand_wavy_nrm.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <NMapBottom AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="static_objects/environment/rocks/rock_huge_nrm.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <SpecularSide AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="static_objects/environment/rocks/rock_huge_spec.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <SpecularBottom AnimFrameTime="0" AnimMode="None" AnimStartTime="0" Compress="true" File="static_objects/environment/rocks/rock_huge_spec.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
    </TextureUnits>
    <SpecificVariables>
        <Var Name="TextureUVScaleSide" Value="6" />
        <Var Name="TextureUVScaleTop" Value="2" />
        <Var Name="TextureUVScaleBottom" Value="6" />
        <Var Name="TextureUVOffset" Value="0.000000   0.000000   0.000000" />
        <Var Name="PlanarUVRotation" Value="0.000000   0.000000   0.000000" />
        <Var Name="BlendSmoothness" Value="0.4" />
        <Var Name="NormalMapBlendImpact" Value="0.5" />
        <Var Name="DynamicObjectSupport" Value="true" />
        <Var Name="DetailTextureActive" Value="false" />
        <Var Name="DetailTextureUVScale" Value="0.2" />
        <Var Name="DetailBlendWeight" Value="0.2" />
        <Var Name="DetailBlendMode" Value="Alpha" />
    </SpecificVariables>
</Material>
