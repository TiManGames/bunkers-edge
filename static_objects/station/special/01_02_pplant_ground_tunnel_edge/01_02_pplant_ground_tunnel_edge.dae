                                    <bind_vertex_input semantic="uvSet1" input_semantic="TEXCOORD" input_set="0" />
                                </instance_material>
                            </technique_common>
                        </bind_material>
                    </instance_geometry>
                </node>
            </node>
            <extra>
                <technique profile="MAYA">
                    <start_time>0</start_time>
                    <end_time>5</end_time>
                </technique>
            </extra>
        </visual_scene>
    </library_visual_scenes>
    <scene>
        <instance_visual_scene url="#DefaultScene" />
    </scene>
</COLLADA>
