<Material>
    <Main BlendMode="Add" DepthTest="true" PhysicsMaterial="Book" Type="projectedUV" UVSubDivs="1 1" UseAlpha="false" />
    <TextureUnits>
        <DiffuseSide AnimFrameTime="1" AnimMode="None" AnimStartTime="0" Compress="false" File="static_objects/station/cables/electrical_dark.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <DiffuseTop AnimFrameTime="1" AnimMode="None" AnimStartTime="0" Compress="false" File="static_objects/station/cables/electrical_dark.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <DiffuseBottom AnimFrameTime="1" AnimMode="None" AnimStartTime="0" Compress="false" File="static_objects/station/cables/electrical_dark.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <SpecularSide AnimFrameTime="1" AnimMode="None" AnimStartTime="0" Compress="false" File="static_objects/station/cables/electrical_spec.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <SpecularTop AnimFrameTime="1" AnimMode="None" AnimStartTime="0" Compress="false" File="static_objects/station/cables/electrical_spec.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
        <SpecularBottom AnimFrameTime="1" AnimMode="None" AnimStartTime="0" Compress="false" File="static_objects/station/cables/electrical_spec.dds" MipMaps="true" Type="2D" Wrap="Repeat" />
    </TextureUnits>
    <SpecificVariables>
        <Var Name="TextureUVScaleSide" Value="0.5" />
        <Var Name="TextureUVScaleTop" Value="0.5" />
        <Var Name="TextureUVScaleBottom" Value="0.5" />
        <Var Name="TextureUVOffset" Value="0 0 0" />
        <Var Name="PlanarUVRotation" Value="0 0 0" />
        <Var Name="BlendSmoothness" Value="0.5" />
        <Var Name="NormalMapBlendImpact" Value="0" />
        <Var Name="DynamicObjectSupport" Value="false" />
        <Var Name="DetailTextureActive" Value="false" />
        <Var Name="DetailTextureUVScale" Value="0.3" />
        <Var Name="DetailBlendWeight" Value="0.5" />
        <Var Name="DetailBlendMode" Value="Alpha" />
    </SpecificVariables>
</Material>
